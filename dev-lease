#!/usr/bin/env python3
"""Owned dev-server leases on pm2 processes. dev-up creates/renews; release TOKEN at task completion.

stop TOKEN stops one owned server; sweep expires leases. install schedules an hourly
sweep on the Mini only. Servers dev-up did not start are never adopted or stopped.
"""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import plistlib
import re
import socket
import subprocess
import sys
import time
import uuid

TTL = 12 * 60 * 60
HERE = Path(__file__).resolve()
LABEL = "com.rioredwards.dev-lease"


def directory():
    path = Path(os.environ.get("DEV_LEASE_DIR", Path.home() / ".local/state/dev-leases"))
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


@contextlib.contextmanager
def locked():
    with (directory() / "lock").open("a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def path_for(token):
    if not re.fullmatch(r"[a-f0-9]{32}", token):
        raise ValueError("invalid lease token")
    return directory() / (token + ".json")


def read(token):
    return json.loads(path_for(token).read_text())


def save(record):
    path = path_for(record["id"])
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps(record))
    temporary.replace(path)


def records():
    return [json.loads(p.read_text()) for p in directory().glob("*.json")]


def pm2(*args):
    result = subprocess.run(["pm2", *args], capture_output=True, text=True, timeout=60)
    if result.returncode:
        raise RuntimeError("pm2 %s failed: %s" % (" ".join(args), (result.stderr or result.stdout).strip()))
    return result.stdout


def daemon_alive():
    # Asking pm2 itself would spawn a daemon just to report an empty list.
    home = Path(os.environ.get("PM2_HOME", Path.home() / ".pm2"))
    try:
        os.kill(int((home / "pm2.pid").read_text()), 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError):
        return False


def processes():
    return json.loads(pm2("jlist")) if daemon_alive() else []


def process(record):
    """The leased pm2 process, None if gone. A reused pm_id fails closed."""
    for proc in processes():
        if proc["pm_id"] == record["pm_id"]:
            if proc["name"] != record["name"] or proc["pm2_env"]["created_at"] != record["created"]:
                raise RuntimeError("pm2 process %s is not the leased one; refusing cleanup" % record["pm_id"])
            return proc
    return None


def create(name):
    with locked():
        matches = [p for p in processes() if p["name"] == name]
        if len(matches) != 1:
            raise RuntimeError("expected one pm2 process named %s, found %d" % (name, len(matches)))
        proc = matches[0]
        record = {"id": uuid.uuid4().hex, "name": name, "pm_id": proc["pm_id"],
                  "created": proc["pm2_env"]["created_at"], "cwd": os.getcwd(),
                  "expires": time.time() + TTL, "shared": False}
        save(record)
        return record["id"]


def find(match):
    for record in records():
        proc = process(record)
        if proc and match(record, proc):
            return record
    return None


def renew_pid(pid):
    with locked():
        record = find(lambda r, p: p["pid"] == pid)
        if not record:
            return "untracked"
        record.update(expires=time.time() + TTL, shared=True)
        save(record)
        return record["id"]


def stop(token, expired_only=False, release=False):
    with locked():
        record = read(token)
        if expired_only and record["expires"] > time.time():
            return
        if release and record.get("shared"):
            print("dev-lease: reused by another task; kept until lease expiry")
            return
        # pm2 sends SIGINT to the process tree, so portless removes its route and
        # Tailscale mapping, then SIGKILLs whatever outlives dev-up's kill timeout.
        if process(record):
            pm2("delete", str(record["pm_id"]))
            if process(record):
                raise RuntimeError("pm2 process %s survived delete; left for inspection" % record["pm_id"])
        path_for(token).unlink()
        print("dev-lease: stopped " + token)


def stop_where(match, what):
    with locked():
        matches = [r for r in records() if match(r)]
    if len(matches) != 1:
        raise RuntimeError("no unique owned lease for %s; untracked servers need manual inspection" % what)
    stop(matches[0]["id"])


def sweep():
    failed = False
    for record in records():
        try:
            if record["expires"] <= time.time():
                stop(record["id"], expired_only=True)
            elif not process(record):
                # Crashed or lost with a reboot: nothing left to stop.
                stop(record["id"])
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            print("dev-lease: %s: %s" % (record["id"], error), file=sys.stderr)
            failed = True
    if failed:
        raise RuntimeError("one or more leases need inspection")


def require_mini():
    if "mini" not in socket.gethostname().lower():
        raise RuntimeError("scheduled cleanup runs only on the Mac Mini")


def macbook_online():
    # ssh to an offline MacBook sends it a wake signal; skip it instead.
    status = json.loads(subprocess.run(["tailscale", "status", "--json"], capture_output=True,
                                       text=True, check=True).stdout)
    return any(p["DNSName"].startswith("rios-macbook-air.") and p["Online"]
               for p in (status.get("Peer") or {}).values())


def install():
    require_mini()
    log = Path.home() / "Library/Logs/dev-lease.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    path = Path.home() / "Library/LaunchAgents" / (LABEL + ".plist")
    path.parent.mkdir(parents=True, exist_ok=True)
    config = {"Label": LABEL, "ProgramArguments": ["/usr/bin/python3", str(HERE), "sweep-all"],
              "StartInterval": 3600, "RunAtLoad": True,
              "EnvironmentVariables": {"PATH": str(Path.home() / "scripts") + ":/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"},
              "StandardOutPath": str(log), "StandardErrorPath": str(log)}
    path.write_bytes(plistlib.dumps(config))
    domain = "gui/%s" % os.getuid()
    existing = subprocess.run(["launchctl", "print", domain + "/" + LABEL], capture_output=True)
    if existing.returncode == 0:
        subprocess.run(["launchctl", "bootout", domain + "/" + LABEL], check=True)
    subprocess.run(["launchctl", "bootstrap", domain, str(path)], check=True)


def main(args):
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    action = args[0]
    if action == "create":
        print(create(args[1]))
    elif action == "renew-pid":
        print(renew_pid(int(args[1])))
    elif action in ("stop", "release"):
        stop(args[1], release=action == "release")
    elif action == "stop-pid":
        pid = int(args[1])
        with locked():
            record = find(lambda r, p: p["pid"] == pid)
        stop_where(lambda r: record and r["id"] == record["id"], "pid %d" % pid)
    elif action == "stop-name":
        stop_where(lambda r: r["name"] == args[1], args[1])
    elif action == "sweep":
        sweep()
    elif action == "sweep-all":
        require_mini()
        local = subprocess.run(["/usr/bin/python3", str(HERE), "sweep"])
        if not macbook_online():
            print("dev-lease: MacBook offline; its leases wait for the next sweep")
            return int(local.returncode != 0)
        remote = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", "macbook",
                                 "PATH=$HOME/scripts:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin /usr/bin/python3 $HOME/scripts/dev-lease sweep"], timeout=120)
        return int(local.returncode != 0 or remote.returncode != 0)
    elif action == "install":
        install()
    else:
        raise ValueError("unknown command: " + action)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:
        sys.exit("dev-lease: " + str(error))
