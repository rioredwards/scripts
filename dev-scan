#!/usr/bin/env python3
"""dev-scan: answer "what is on this Mac to run?" as JSON.

The reading half of dev-up and dev-ls. Those two say what is running and
start things; this says what exists. Same contract: run it locally, or over
ssh, and the answers describe the machine it ran on.

  dev-scan apps              # every runnable repo under ~/dev
  dev-scan worktrees <dir>   # every live checkout of that repo
  dev-scan scripts <dir>     # everything runnable in that checkout

Every subcommand prints a JSON array on stdout and nothing else. Nothing to
report is an empty array, not an error. A real failure (no ~/dev, not a repo)
exits non-zero with a message on stderr, because a wrong empty list is worse
than a loud stop.

DEV_ROOT overrides ~/dev, for tests.
"""

import json
import os
import re
import subprocess
import sys

# dev-up's own detection order, mirrored so this offers exactly what dev-up
# will actually run. Drifting from it would name a start command that starts
# something else.
START_SCRIPTS = [
    "skeleton/scripts/start_dev.sh",
    "scripts/start_dev.sh",
    "scripts/dev",
    "bin/dev",
    "start_dev.sh",
]

SCRIPT_DIRS = ["skeleton/scripts", "scripts"]


def die(message):
    print(f"dev-scan: {message}", file=sys.stderr)
    sys.exit(2)


def dev_root():
    return os.environ.get("DEV_ROOT") or os.path.join(os.path.expanduser("~"), "dev")


def git(cwd, *args):
    """git output, or None when git says no. Never raises."""
    try:
        out = subprocess.run(
            ["git", "-C", cwd, *args],
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, OSError):
        return None
    return out.stdout


def subdirs(path):
    try:
        entries = sorted(os.scandir(path), key=lambda e: e.name)
    except OSError as error:
        die(f"cannot read {path}: {error}")
    return [e.path for e in entries if e.is_dir() and not e.name.startswith(".")]


def is_main_checkout(path):
    """A main checkout has a .git directory; a linked worktree has a .git file."""
    return os.path.isdir(os.path.join(path, ".git"))


def package_scripts(path):
    manifest = os.path.join(path, "package.json")
    if not os.path.exists(manifest):
        return {}
    try:
        with open(manifest, encoding="utf-8") as handle:
            scripts = json.load(handle).get("scripts") or {}
    except (OSError, ValueError):
        # A package.json mid-edit is not worth failing a whole scan over.
        return {}
    return scripts if isinstance(scripts, dict) else {}


def npm_command(path, script):
    if os.path.exists(os.path.join(path, "pnpm-lock.yaml")):
        return f"pnpm {script}"
    return f"npm run {script}"


def start_script(path):
    """The relative path of the start script dev-up would pick, if any.

    Executable, not merely present: dev-up tests each candidate with -x, and a
    non-executable file would make this offer a command dev-up skips.
    """
    for candidate in START_SCRIPTS:
        full = os.path.join(path, candidate)
        if os.path.isfile(full) and os.access(full, os.X_OK):
            return candidate
    return None


def start_command(path):
    script = start_script(path)
    if script:
        return f"./{script}"
    return npm_command(path, "dev") if package_scripts(path).get("dev") else None


def last_commit(path):
    out = git(path, "log", "-1", "--format=%ct")
    if not out:
        return 0
    try:
        return int(out.strip())
    except ValueError:
        return 0


def cmd_apps():
    """Every runnable repo, most recently committed first.

    One level under ~/dev, then one level inside anything that is not itself a
    repo, because related repos get grouped in a container dir. Repos with
    nothing startable are left out: this list exists to run things.
    """
    candidates = []
    for path in subdirs(dev_root()):
        if is_main_checkout(path):
            candidates.append(path)
        else:
            candidates.extend(child for child in subdirs(path) if is_main_checkout(child))

    apps = [
        {"name": os.path.basename(path), "dir": path, "lastCommit": last_commit(path)}
        for path in candidates
        if start_command(path)
    ]
    apps.sort(key=lambda app: -app["lastCommit"])
    return apps


def git_counts(path, *args):
    out = git(path, *args)
    if out is None:
        die(f"git {' '.join(args)} failed in {path}")
    return [int(n) for n in out.split()]


def git_facts(path, base):
    """What deleting this checkout would lose.

    Unpushed means on no remote at all, not ahead of its upstream: upstreams
    are unreliable (missing, or set to the default branch itself). Ahead and
    behind are against origin/HEAD, so 0 ahead means merged. With no
    origin/HEAD there is nothing to judge by, so those are null, not guessed.
    """
    # No optional locks: a plain status rewrites the index, and an agent
    # committing in this checkout at that moment would hit index.lock.
    status = git(path, "--no-optional-locks", "status", "--porcelain")
    if status is None:
        die(f"git status failed in {path}")
    lines = [line for line in status.split("\n") if line]
    untracked = sum(1 for line in lines if line.startswith("??"))
    facts = {"lastCommit": last_commit(path), "changed": len(lines) - untracked, "untracked": untracked}
    if base is None:
        return {**facts, "unpushed": None, "ahead": None, "behind": None, "base": None}
    [unpushed] = git_counts(path, "rev-list", "--count", "HEAD", "--not", "--remotes")
    behind, ahead = git_counts(path, "rev-list", "--left-right", "--count", f"{base}...HEAD")
    return {**facts, "unpushed": unpushed, "ahead": ahead, "behind": behind, "base": base.removeprefix("origin/")}


def cmd_worktrees(repo_dir):
    """Every live checkout, main first, then most recently committed.

    `git worktree list` is the only honest source. Three directory naming
    conventions coexist on disk and none reliably encodes the branch, so names
    are never parsed. Entries git marks prunable, or whose directory is gone,
    are dropped. Each row carries what deleting it would lose (see git_facts).
    """
    out = git(repo_dir, "worktree", "list", "--porcelain")
    if out is None:
        die(f"not a git repo: {repo_dir}")

    worktrees = []
    current = {}

    def flush():
        path = current.get("dir")
        if path and not current.get("skip") and os.path.isdir(path):
            worktrees.append(
                {
                    "dir": path,
                    "branch": current.get("branch") or "detached",
                    "isMain": not worktrees,
                }
            )
        current.clear()

    for line in out.split("\n"):
        if line.startswith("worktree "):
            flush()
            current["dir"] = line[len("worktree ") :]
        elif line.startswith("branch refs/heads/"):
            current["branch"] = line[len("branch refs/heads/") :]
        elif line.startswith("prunable") or line == "bare":
            current["skip"] = True
    flush()

    head = git(repo_dir, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    base = head.strip() if head else None
    for worktree in worktrees:
        worktree.update(git_facts(worktree["dir"], base))
    worktrees.sort(key=lambda w: (not w["isMain"], -w["lastCommit"]))
    return worktrees


def titleize(name):
    """migrate_dev -> Migrate Dev, check-types -> Check Types"""
    words = [word for word in re.split(r"[-_\s]+", name) if word]
    return " ".join(word[0].upper() + word[1:] for word in words)


def shell_scripts(path):
    found = []
    for subdir in SCRIPT_DIRS:
        try:
            names = sorted(os.listdir(os.path.join(path, subdir)))
        except OSError:
            continue
        found.extend(f"{subdir}/{name}" for name in names if name.endswith(".sh"))
    return sorted(found)


def cmd_scripts(path):
    """Everything runnable in one checkout.

    The dev server comes first and is the only `service`; it routes through
    dev-up, which owns ports, panes and health. Everything else is a one-off
    task.

    The start script and the `dev` npm script are left out of the task list:
    they are the dev server, already offered above, and running them outside
    dev-up is exactly the port-guessing this replaces.
    """
    if not os.path.isdir(path):
        die(f"no such directory: {path}")

    scripts = []
    start = start_command(path)
    if start:
        scripts.append({"id": "dev-up", "name": "Start Dev Server", "command": start, "kind": "service"})

    for name in sorted(package_scripts(path)):
        if name == "dev":
            continue
        scripts.append(
            {
                "id": f"npm:{name}",
                "name": titleize(name),
                "command": npm_command(path, name),
                "kind": "task",
            }
        )

    skip = start_script(path)
    for rel in shell_scripts(path):
        if rel == skip:
            continue
        name = os.path.basename(rel)[: -len(".sh")]
        scripts.append({"id": f"sh:{rel}", "name": titleize(name), "command": f"./{rel}", "kind": "task"})

    return scripts


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    command, args = argv[0], argv[1:]

    if command == "apps":
        result = cmd_apps()
    elif command == "worktrees":
        if not args:
            die("worktrees needs a repo directory")
        result = cmd_worktrees(os.path.abspath(os.path.expanduser(args[0])))
    elif command == "scripts":
        if not args:
            die("scripts needs a checkout directory")
        result = cmd_scripts(os.path.abspath(os.path.expanduser(args[0])))
    else:
        die(f"unknown command {command}. Try: apps, worktrees <dir>, scripts <dir>")

    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
