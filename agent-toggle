#!/bin/sh
# agent-toggle: flip agent-hook knobs from anywhere (incl. a phone Shortcut over
# SSH). Writes to ~/.config/agent-hooks/local.sh, which wins over the
# dotfiles-synced agent-hooks profile, so a remote flip can't be reverted by an
# auto-sync. With --session ID it writes that one agent session's layer
# (~/.config/agent-hooks/sessions/ID.sh) instead, which wins over local.sh for
# that session only. Hooks re-read this every turn: a change takes effect next
# turn, no restart.
#
# Usage:
#   agent-toggle                     # list every knob + current state
#   agent-toggle <knob>              # show one knob
#   agent-toggle <knob> on|off|toggle
#   agent-toggle <knob> VALUE        # set a value knob
#   agent-toggle set <knob|KEY> VAL  # set any knob to a literal value
#   agent-toggle unset <knob|KEY>    # drop the override (back to the layer below)
#   agent-toggle --json              # every knob as JSON (value, source, options)
#   agent-toggle --session ID ...    # any of the above for one agent session
#                                    # (knobs marked per-session only)
#
# Knobs, env keys, options and what each value means live in agent-knobs.json
# next to this script. `agent-toggle help` lists them.
set -eu

local_dir="$HOME/.config/agent-hooks"
machine_file="$local_dir/local.sh"
local_file="$machine_file"
profile_file="${AGENT_HOOKS_PROFILE:-$HOME/.dotfiles/zsh/profiles/agent-hooks.sh}"
registry="${AGENT_KNOBS_FILE:-$(CDPATH='' cd -- "$(dirname "$0")" && pwd)/agent-knobs.json}"
[ -r "$registry" ] || { echo "agent-toggle: knob registry missing: $registry" >&2; exit 2; }

# --session ID: read and write that session's layer instead of the machine's.
session=""
if [ "${1:-}" = --session ]; then
  [ "$#" -ge 2 ] || { echo "agent-toggle: usage: agent-toggle --session ID ..." >&2; exit 2; }
  case "$2" in
    ''|*[!A-Za-z0-9_-]*) echo "agent-toggle: bad session id '$2'" >&2; exit 2 ;;
  esac
  session="$2"; shift 2
  AGENT_SESSION_ID="$session"; export AGENT_SESSION_ID
  local_dir="$local_dir/sessions"
  local_file="$local_dir/$session.sh"
else
  unset AGENT_SESSION_ID 2>/dev/null || true
fi

KNOBS="$(jq -r '.knobs[] | select(.kind=="toggle") | .name' "$registry" | tr '\n' ' ')"
VALUE_KNOBS="$(jq -r '.knobs[] | select(.kind=="value") | .name' "$registry" | tr '\n' ' ')"
ALL_KEYS="$(jq -r '.knobs[].key' "$registry")"
# "name key" per name and alias, so lookups don't re-run jq
KEYMAP="$(jq -r '.knobs[] | .key as $k | ([.name] + (.aliases // []))[] | "\(.) \($k)"' "$registry")"

# friendly name or alias -> env key. Accepts the env key itself so callers can pass either.
knob_key() {
  case "$1" in AGENT_*|AGY_*) echo "$1"; return 0 ;; esac
  _kk="$(printf '%s\n' "$KEYMAP" | awk -v n="$1" '$1==n {print $2; exit}')"
  [ -n "$_kk" ] || return 1
  echo "$_kk"
}

# a registry field of a knob (by name, alias, or env key); empty when absent.
# Objects (options) come back as their space-separated keys.
knob_field() {
  jq -r --arg n "$1" --arg f "$2" '
    first(.knobs[] | select(.name==$n or .key==$n or ((.aliases // []) | index($n))))
    | .[$f] // empty
    | if type=="object" then keys_unsorted | join(" ") else tostring end' "$registry"
}

# raw value of an env key as the hooks would see it right now (ambient env wins,
# exactly like a real hook run). Empty when unset everywhere.
raw_current() {
  _rk="$1"
  (
    . "$HOME/scripts/agent-hooks-env.sh" >/dev/null 2>&1 || true
    eval "printf '%s' \"\${$_rk:-}\""
  )
}

# raw value from the config files alone, with any ambient value stripped first.
# Differs from raw_current only when something exported an override into this
# shell: which is what makes the `env` source detectable.
raw_file() {
  _fk="$1"
  (
    for _uk in $ALL_KEYS; do unset "$_uk" 2>/dev/null || true; done
    . "$HOME/scripts/agent-hooks-env.sh" >/dev/null 2>&1 || true
    eval "printf '%s' \"\${$_fk:-}\""
  )
}

# where a value comes from: env (exported into this shell) | session (this
# session's override) | local (machine override) | profile (synced default) |
# default (nothing sets it; the registry default or the hook's own fallback).
source_of() {
  _sk="$1"
  if [ "$(raw_current "$_sk")" != "$(raw_file "$_sk")" ]; then
    echo env
  elif [ -n "$session" ] && [ -f "$local_file" ] && grep -qE "^(export )?${_sk}=" "$local_file"; then
    echo session
  elif [ -f "$machine_file" ] && grep -qE "^(export )?${_sk}=" "$machine_file"; then
    echo local
  elif [ -f "$profile_file" ] && grep -qE "^(export )?${_sk}=" "$profile_file"; then
    echo profile
  else
    echo default
  fi
}

# a value knob's effective value: what the hooks see, else the registry default
value_of() {
  _vv="$(raw_current "$2")"
  [ -n "$_vv" ] || _vv="$(knob_field "$1" default)"
  printf '%s' "$_vv"
}

# effective on/off state of a toggle, resolved through the real loader.
current() {
  case "$(raw_current "$1")" in on|1|true|yes) echo on ;; *) echo off ;; esac
}

# rewrite one key in the override file, preserving the other lines
set_state() {
  key="$1"; state="$2"
  mkdir -p "$local_dir"
  tmp="$local_file.tmp.$$"
  # Drop the knob's own line AND its _SINCE stamp; both get rewritten below.
  if [ -f "$local_file" ]; then
    grep -vE "^export ${key}(_SINCE)?=" "$local_file" > "$tmp" 2>/dev/null || : > "$tmp"
  else
    : > "$tmp"
  fi
  printf 'export %s=%s\n' "$key" "$state" >> "$tmp"
  # Stamp the switch-on time so a time-based auto-off can measure the knob's age
  # (see AGENT_AUDIO_FILE_TTL_MIN). Generic across knobs; only audio uses it now.
  if [ "$state" = on ]; then
    printf 'export %s_SINCE=%s\n' "$key" "$(date +%s)" >> "$tmp"
  fi
  mv -f "$tmp" "$local_file"
  # Session layers are throwaway state: drop any a month stale.
  if [ -n "$session" ]; then find "$local_dir" -name '*.sh' -mtime +30 -delete 2>/dev/null || true; fi
}

# drop a key's override entirely, so the layer below takes over again
unset_state() {
  key="$1"
  [ -f "$local_file" ] || return 0
  tmp="$local_file.tmp.$$"
  grep -vE "^export ${key}(_SINCE)?=" "$local_file" > "$tmp" 2>/dev/null || : > "$tmp"
  mv -f "$tmp" "$local_file"
}

# local.sh is eval'd by the loader, so a value carrying quotes, `$`, or a
# newline would be executed. Allow only what a knob legitimately needs.
validate_value() {
  case "$1" in
    "") return 0 ;;
    *[!A-Za-z0-9._-]*)
      echo "agent-toggle: refusing value '$1', only letters, digits, dot, underscore, dash" >&2
      return 1 ;;
  esac
}

# a value the registry's options allow (anything, for knobs without options)
check_option() {
  _opts="$(knob_field "$1" options)"
  if [ -z "$_opts" ] || [ -z "$2" ]; then return 0; fi
  case " $_opts " in *" $2 "*) return 0 ;; esac
  echo "agent-toggle: '$2' is not an option for $1 ($_opts)" >&2
  return 1
}

# only knobs marked `session` in the registry can be set per session
check_scope() {
  [ -z "$session" ] && return 0
  [ "$(knob_field "$1" session)" = true ] && return 0
  echo "agent-toggle: $1 is machine-wide, not settable per session" >&2
  return 1
}

# every registry entry plus its live value and source, for the band and
# statusline. `options` is the allowed-value list (empty when free-form).
list_json() {
  for k in $KNOBS $VALUE_KNOBS; do
    _ek="$(knob_key "$k")"
    printf '%s\t%s\t%s\n' "$k" "$(raw_current "$_ek")" "$(source_of "$_ek")"
  done | jq -ncR --slurpfile reg "$registry" '
    [inputs | split("\t")] as $live
    | [$reg[0].knobs[] | . as $k | first($live[] | select(.[0]==$k.name)) as $l
       | {name, key, kind,
          value: (if $l[1]=="" then (.default // "") else $l[1] end),
          source: $l[2], session: (.session // false), label: (.label // .name),
          options: ((.options // {}) | keys_unsorted)}]'
}

list_all() {
  for k in $KNOBS; do
    env_key="$(knob_key "$k")"
    printf '%-14s %-16s %s\n' "$k" "$(current "$env_key")" "($(source_of "$env_key"))"
  done
  for k in $VALUE_KNOBS; do
    env_key="$(knob_key "$k")"
    val="$(value_of "$k" "$env_key")"
    printf '%-14s %-16s %s\n' "$k" "${val:--}" "($(source_of "$env_key"))"
  done
}

# no args -> list everything
if [ "$#" -eq 0 ] || [ "${1:-}" = status ] || [ "${1:-}" = ls ]; then
  list_all
  exit 0
fi

case "${1:-}" in
  --json) list_json; exit 0 ;;
  -h|--help|help)
    sed -n '2,/^set -eu/p' "$0" | sed '$d; s/^# \{0,1\}//'
    echo; echo "Knobs (name, env key, options or kind, what it does):"
    jq -r '.knobs[] | "  \(.name)  \(.key)  \(if .options then "[" + (.options | keys_unsorted | join(" | ")) + "]" else .kind end)\(if .session then "  per-session" else "" end)  \(.doc)"' "$registry"
    exit 0 ;;
  set)
    [ "$#" -ge 3 ] || { echo "agent-toggle: usage: agent-toggle set <knob|KEY> VALUE" >&2; exit 2; }
    key="$(knob_key "$2")" || { echo "agent-toggle: unknown knob '$2'" >&2; exit 2; }
    validate_value "$3" || exit 2
    check_option "$2" "$3" || exit 2
    check_scope "$2" || exit 2
    set_state "$key" "$3"
    echo "$2: ${3:--}"
    exit 0 ;;
  unset)
    [ "$#" -ge 2 ] || { echo "agent-toggle: usage: agent-toggle unset <knob|KEY>" >&2; exit 2; }
    key="$(knob_key "$2")" || { echo "agent-toggle: unknown knob '$2'" >&2; exit 2; }
    check_scope "$2" || exit 2
    unset_state "$key"
    echo "$2: $(value_of "$2" "$key") ($(source_of "$key"))"
    exit 0 ;;
esac

knob="$1"
env_key="$(knob_key "$knob")" || { echo "agent-toggle: unknown knob '$knob' (one of: $KNOBS$VALUE_KNOBS)" >&2; exit 2; }
action="${2:-show}"

# Value knobs have no on/off state: show the value, and treat a bare
# `agent-toggle <knob> <value>` as a set.
if [ "$(knob_field "$knob" kind)" = value ]; then
  if [ "$action" = show ]; then
    echo "$knob: $(value_of "$knob" "$env_key") ($(source_of "$env_key"))"
  else
    validate_value "$action" || exit 2
    check_option "$knob" "$action" || exit 2
    check_scope "$knob" || exit 2
    set_state "$env_key" "$action"
    echo "$knob: ${action:--}"
  fi
  exit 0
fi

[ "$action" = show ] || check_scope "$knob" || exit 2
case "$action" in
  show)   echo "$knob: $(current "$env_key")" ;;
  on|off) set_state "$env_key" "$action"; echo "$knob: $action" ;;
  toggle)
    if [ "$(current "$env_key")" = on ]; then set_state "$env_key" off; else set_state "$env_key" on; fi
    echo "$knob: $(current "$env_key")"
    ;;
  *) echo "agent-toggle: unknown action '$action' (on|off|toggle)" >&2; exit 2 ;;
esac
