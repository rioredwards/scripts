#!/bin/sh
# pr-loc — one-table breakdown of a branch's diff for PR bodies: lines changed per
# subsystem, with the dominant kind (🧠 logic · 🧪 tests · 📝 docs · ⚙️ config ·
# 📦 generated · 🖼️ assets) and a total row. Markdown out, paste at the top of the PR body.
#
#   pr-loc            # diff vs merge-base with the PR base (gh) or origin/<default>
#   pr-loc <base>     # explicit base ref, e.g. pr-loc HEAD~5 / pr-loc origin/main
set -u
case "${1:-}" in -h|--help) sed -n '2,7p' "$0" | cut -c3-; exit 0 ;; esac
git rev-parse --git-dir >/dev/null 2>&1 || { echo "pr-loc: not a git repo" >&2; exit 2; }

base="${1:-}"
if [ -z "$base" ]; then
  base=$(gh pr view --json baseRefName -q '.baseRefName' 2>/dev/null || true)
  [ -n "$base" ] && base="origin/$base"
fi
[ -n "$base" ] || base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
[ -n "$base" ] || { echo "pr-loc: no base found — pass one: pr-loc origin/main" >&2; exit 2; }
git rev-parse -q --verify "$base^{commit}" >/dev/null || { echo "pr-loc: unknown ref: $base" >&2; exit 2; }
mb=$(git merge-base "$base" HEAD 2>/dev/null) || { echo "pr-loc: no merge-base with $base" >&2; exit 2; }

git -c core.quotePath=false diff --numstat "$mb" HEAD | awk -F'\t' '
function kind(p,  f) {
  f = p; sub(/.*\//, "", f)
  if (p ~ /(^|\/)(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|Cargo\.lock|poetry\.lock|uv\.lock|Gemfile\.lock|go\.sum|composer\.lock)$/ ||
      p ~ /(^|\/)(vendor|node_modules|dist|build|coverage|__snapshots__|migrations)\// ||
      p ~ /-snapshots\// || f ~ /\.(min\.[a-z]+|snap|generated\.[a-z]+)$/) return "📦 generated"
  if (f ~ /\.(png|jpe?g|gif|svg|webp|ico|woff2?|ttf|otf|mp[34]|wav|pdf)$/) return "🖼️ assets"
  if (p ~ /(^|\/)(test|tests|__tests__|spec|specs|e2e|fixtures|__mocks__)\// ||
      f ~ /\.(test|spec)\.[a-z]+$/ || f ~ /^test_.*\.py$/ || f ~ /_test\.(go|py|rb)$/) return "🧪 tests"
  if (f ~ /\.(md|mdx|rst|txt|adoc)$/ || p ~ /(^|\/)docs?\// || f ~ /^(LICENSE|CHANGELOG|README)/) return "📝 docs"
  if (f ~ /^\./ || p ~ /(^|\/)\.github\// || f ~ /\.(json|ya?ml|toml|ini|cfg|conf|env|plist|xml|lock)$/ ||
      f ~ /\.config\.[a-z]+$/ || f ~ /^(Makefile|justfile|Dockerfile|Procfile|Brewfile)$/) return "⚙️ config"
  return "🧠 logic"
}
function subsystem(p,  n, a) {
  n = split(p, a, "/")
  if (n == 1) return "(root)"
  if (a[1] ~ /^(src|apps|packages|plugins)$/ && n > 2) return a[1] "/" a[2]
  return a[1]
}
{
  path = $3; a = ($1 == "-") ? 0 : $1; d = ($2 == "-") ? 0 : $2
  # renames: keep the new path — both "old => new" and "pre/{old => new}/suf" forms.
  if (path ~ /=>/) { if (sub(/\{[^{}]* => /, "", path)) sub(/\}/, "", path); else sub(/.* => /, "", path) }
  k = kind(path); s = subsystem(path)
  ka[k] += a; kd[k] += d; kf[k]++
  sa[s] += a; sd[s] += d; sf[s]++; sk[s, k] += a + d
  A += a; D += d; F++
}
END {
  if (F == 0) { print "📊 no changes vs base"; exit }
  n = split("🧠 logic|🧪 tests|📝 docs|⚙️ config|📦 generated|🖼️ assets", order, "|")
  # Subsystems, biggest churn first (insertion sort — POSIX awk has no asort).
  ns = 0; for (s in sa) { ns++; j = ns
    while (j > 1 && sa[name[j-1]] + sd[name[j-1]] < sa[s] + sd[s]) { name[j] = name[j-1]; j-- }
    name[j] = s }
  print "| Subsystem | Files | + | − | Mostly |"; print "|---|---:|---:|---:|---|"
  for (i = 1; i <= ns && i <= 10; i++) { s = name[i]; best = ""; bv = -1
    for (j = 1; j <= n; j++) if ((s, order[j]) in sk && sk[s, order[j]] > bv) { bv = sk[s, order[j]]; best = order[j] }
    printf "| `%s` | %d | %d | %d | %s |\n", s, sf[s], sa[s], sd[s], best }
  if (ns > 10) printf "| … %d more | | | | |\n", ns - 10
  best = ""; bv = -1
  for (j = 1; j <= n; j++) if (kf[order[j]] && ka[order[j]] + kd[order[j]] > bv) { bv = ka[order[j]] + kd[order[j]]; best = order[j] }
  printf "| **Total** | **%d** | **%d** | **%d** | %s |\n", F, A, D, best
}'
