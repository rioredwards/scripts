#!/usr/bin/env bash
set -euo pipefail

CLAUDE_APP="${CLAUDE_APP:-Claude}"
POLL_INTERVAL="${POLL_INTERVAL:-2}"
POLL_TIMEOUT="${POLL_TIMEOUT:-120}"
STABLE_POLLS="${STABLE_POLLS:-2}"
VERBOSE="${VERBOSE:-0}"
AUTOMATION_CUE="${AUTOMATION_CUE:-1}"
AUTOMATION_CUE_SCRIPT="${AUTOMATION_CUE_SCRIPT:-$HOME/scripts/automation-cue.sh}"

export PEEKABOO_AX_MAX_DEPTH=30
export PEEKABOO_AX_MAX_ELEMENTS=1000

cue_shown=0

cue_start() {
  [[ "$AUTOMATION_CUE" == "1" ]] || return 0
  [[ -x "$AUTOMATION_CUE_SCRIPT" ]] || return 0
  log "showing automation cue"
  "$AUTOMATION_CUE_SCRIPT" start || true
  cue_shown=1
}

cue_stop() {
  [[ "$cue_shown" == "1" ]] || return 0
  log "hiding automation cue"
  "$AUTOMATION_CUE_SCRIPT" stop || true
  cue_shown=0
}

die() {
  echo "send-to-claude: $*" >&2
  exit 1
}

log() {
  if [[ "$VERBOSE" == "1" ]]; then
    echo "send-to-claude: $*" >&2
  fi
}

require_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
  done
}

check_permissions() {
  local json missing
  json="$(peekaboo permissions --json 2>/dev/null)" || die "failed to check peekaboo permissions"
  missing="$(echo "$json" | jq -r '.data.permissions[] | select(.isRequired and (.isGranted | not)) | .name')"
  if [[ -n "$missing" ]]; then
    die "missing peekaboo permissions:${missing//$'\n'/', '} (run: peekaboo permissions)"
  fi
}

peekaboo_quiet() {
  if [[ "$VERBOSE" == "1" ]]; then
    peekaboo "$@"
  else
    peekaboo "$@" >/dev/null 2>&1
  fi
}

see_claude() {
  if [[ "$VERBOSE" == "1" ]]; then
    peekaboo see --app "$CLAUDE_APP" --json
  else
    peekaboo see --app "$CLAUDE_APP" --json 2>/dev/null
  fi
}

extract_chat_texts() {
  jq -r '.data.ui_elements[]? | select(.role_description == "text") | .label // empty'
}

extract_input_id() {
  jq -r '
    [
      .data.ui_elements[]?
      | select(.label == "text entry area" or .role_description == "text entry area")
      | .id
    ] | first // empty
  '
}

is_skippable_text() {
  local text="$1"
  [[ "$text" == "$MESSAGE" ]] && return 0
  [[ "$text" =~ ^[0-9]+:[0-9]+(\ [AP]M)?$ ]] && return 0
  [[ "$text" == "Write a message…" ]] && return 0
  [[ "$text" =~ ^(Sonnet|Opus|Haiku|Claude|High|Medium|Low) ]] && return 0
  [[ "$text" == "Claude is AI and can make mistakes. Please double-check responses." ]] && return 0
  [[ "$text" =~ ^(Learn more|\(opens in new tab\)) ]] && return 0
  return 1
}

is_generating() {
  local see_json="$1"
  echo "$see_json" | jq -e '
    .data.ui_elements[]?
    | select(.label == "Stop" or .label == "Stop generating")
  ' >/dev/null 2>&1
}

collect_response_text() {
  local see_json="$1"
  local baseline_file="$2"
  local text
  local -a parts=()

  while IFS= read -r text; do
    [[ -z "$text" ]] && continue
    is_skippable_text "$text" && continue
    if ! grep -Fxq -- "$text" "$baseline_file" 2>/dev/null; then
      parts+=("$text")
    fi
  done < <(echo "$see_json" | extract_chat_texts)

  if ((${#parts[@]} == 0)); then
    return 0
  fi

  local part
  local first=1
  for part in "${parts[@]}"; do
    if ((first)); then
      printf '%s' "$part"
      first=0
    else
      printf '\n%s' "$part"
    fi
  done
}

usage() {
  die 'Usage: send-to-claude "your message"  (or pipe message on stdin)
       send-to-claude --paste           # send clipboard as-is (supports images)'
}

PASTE_MODE=""
MESSAGE=""

if [[ "${1:-}" == "--paste" ]]; then
  PASTE_MODE="paste"
  shift
fi

if [[ -z "$PASTE_MODE" ]]; then
  if [[ $# -gt 0 ]]; then
    MESSAGE="$*"
  elif [[ ! -t 0 ]]; then
    MESSAGE="$(cat)"
  else
    usage
  fi
  MESSAGE="${MESSAGE#"${MESSAGE%%[![:space:]]*}"}"
  MESSAGE="${MESSAGE%"${MESSAGE##*[![:space:]]}"}"
  [[ -n "$MESSAGE" ]] || die "message is empty"
fi

require_cmd peekaboo jq
check_permissions

baseline_file="$(mktemp)"
trap 'rm -f "$baseline_file"; cue_stop' EXIT

cue_start

log "capturing baseline UI state"
initial_see="$(see_claude)"
echo "$initial_see" | extract_chat_texts >"$baseline_file"

INPUT_ID="$(echo "$initial_see" | extract_input_id)"

log "launching $CLAUDE_APP"
peekaboo_quiet app launch "$CLAUDE_APP"

if [[ -n "$INPUT_ID" ]]; then
  log "focusing input field ($INPUT_ID)"
  peekaboo_quiet click --on "$INPUT_ID" --app "$CLAUDE_APP" --foreground --wait-for 8000
else
  log "input field not found; clicking HTML content area"
  HTML_ID="$(echo "$initial_see" | jq -r '[.data.ui_elements[]? | select(.role_description == "HTML content") | .id] | first // empty')"
  if [[ -n "$HTML_ID" ]]; then
    peekaboo_quiet click --on "$HTML_ID" --app "$CLAUDE_APP" --foreground --wait-for 8000 || true
  fi
fi

if [[ "$PASTE_MODE" == "paste" ]]; then
  log "pasting clipboard (cmd+v)"
  peekaboo_quiet hotkey "cmd,v" --app "$CLAUDE_APP" --foreground
else
  log "pasting message"
  peekaboo_quiet paste "$MESSAGE" --app "$CLAUDE_APP" --foreground
fi

peekaboo_quiet press return --app "$CLAUDE_APP" --foreground

log "waiting for response (timeout ${POLL_TIMEOUT}s, interval ${POLL_INTERVAL}s, stable polls ${STABLE_POLLS})"
elapsed=0
last_response=""
stable_count=0

while ((elapsed < POLL_TIMEOUT)); do
  sleep "$POLL_INTERVAL"
  elapsed=$((elapsed + POLL_INTERVAL))

  current_see="$(see_claude)"
  response="$(collect_response_text "$current_see" "$baseline_file")"
  response_len=${#response}

  if is_generating "$current_see"; then
    log "poll: len=${response_len} stable=${stable_count} (still generating)"
    stable_count=0
    last_response="$response"
    continue
  fi

  if [[ -n "$response" && "$response" == "$last_response" ]]; then
    stable_count=$((stable_count + 1))
    log "poll: len=${response_len} stable=${stable_count}"
    if ((stable_count >= STABLE_POLLS)); then
      log "response stable; clicking Copy button"
      copy_see="$(see_claude)"
      COPY_ID="$(echo "$copy_see" | jq -r '[.data.ui_elements[]? | select(.label == "Copy") | .id] | last // empty')"
      if [[ -n "$COPY_ID" ]]; then
        saved_clipboard="$(pbpaste 2>/dev/null || true)"
        peekaboo_quiet click --on "$COPY_ID" --app "$CLAUDE_APP" --foreground
        sleep 0.3
        full_response="$(pbpaste 2>/dev/null || true)"
        if [[ -n "$full_response" ]]; then
          log "got full response from clipboard (${#full_response} chars)"
          printf '%s\n' "$full_response"
          exit 0
        fi
        log "clipboard empty after copy; falling back to AX text"
      else
        log "Copy button not found; falling back to AX text"
      fi
      printf '%s\n' "$response"
      exit 0
    fi
  else
    stable_count=0
    last_response="$response"
    log "poll: len=${response_len} stable=${stable_count} (changed)"
  fi
done

if [[ -n "$last_response" ]]; then
  log "timed out with partial response (${#last_response} chars); returning best effort"
  printf '%s\n' "$last_response"
  exit 0
fi

die "timed out after ${POLL_TIMEOUT}s waiting for Claude response"
