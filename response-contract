#!/usr/bin/env bash
# response-contract — validate an agent report against the six-field contract.
#
# Reads a report on stdin. Exits 0 if it satisfies the contract, 1 if it
# violates it (violations printed to stderr), 3 if there is no contract in the
# input at all, 2 on a config error.
#
# WHY THIS EXISTS
# The rules this enforces used to be prose: "be brief", "stay high-level", "no
# file paths", "don't ask me obvious questions". Prose of that shape is an
# OMISSION constraint, and omission compliance measurably rots over a long
# session (73% at turn 5 -> 33% at turn 16, arXiv:2604.20911) while COMMISSION
# constraints hold at 100%. So this does not ask for less. It asks for exactly
# six named slots, none of which can hold an implementation detail, and then
# programmatically rejects anything that doesn't fit. An agent can rationalize
# past advice. It cannot rationalize past a non-zero exit code.
#
# THE CONTRACT
#   SUBSYSTEM:    type/scope. The type is global; the scope is this repo's.
#                 e.g. feat/qc-runs, docs/accelPay-reconciliation
#   USER-VISIBLE: what a person using the thing would now experience
#                 differently. "nothing" is a valid answer.
#   FORK:         the one genuinely load-bearing choice, as A vs B, <=2
#                 sentences. Omit it and no question is being asked.
#   LEAN:         which one, and the single reason. Required if FORK.
#   IF SILENT:    what happens if Rio never answers. Required if FORK. This is
#                 the field that turns a blocking question into a non-blocking
#                 one, which for a solo dev is the whole point.
#   COST TO UNDO: minutes | hours | days | can't. Required if FORK.
#
# WHY type/scope AND NOT ONE GLOBAL LIST
# Rio always knows which repo he is in, so repo identity is free context and
# spending a vocabulary slot on it is waste. What isn't free is *which part of
# this product* and *what kind of change* — so the field carries exactly those.
# It also matches the grammar already in his commit history, which means the
# vocabulary is testable against real usage instead of being invented (see
# `scope-scan`).
#
# Usage:
#   response-contract < report.txt
#   some-agent | response-contract --scopes ./.agents/scopes.md
#   response-contract --list
set -uo pipefail

DEFAULT_TYPES="$HOME/.dotfiles/.agents/commit-types.md"
TYPES_FILE="${RESPONSE_CONTRACT_TYPES:-$DEFAULT_TYPES}"
SCOPES_FILE="${RESPONSE_CONTRACT_SCOPES:-}"
MAX_WORDS="${RESPONSE_CONTRACT_MAX_WORDS:-120}"
LIST_ONLY=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --types)  TYPES_FILE="${2:-}"; shift 2 ;;
    --scopes) SCOPES_FILE="${2:-}"; shift 2 ;;
    --max-words) MAX_WORDS="${2:-}"; shift 2 ;;
    --list) LIST_ONLY=1; shift ;;
    -h|--help) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "response-contract: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

# Scopes belong to the repo being worked in, so find them from the repo root
# rather than the current directory — an agent working three levels deep is
# still working on the same product.
if [ -z "$SCOPES_FILE" ]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  SCOPES_FILE="$ROOT/.agents/scopes.md"
fi

# Bullets of the form: - `name` — description, in the preamble only.
#
# The cut at the first `## ` heading is load-bearing. Everything after one is
# prose, and prose about a vocabulary is full of backticked names — "`dev`,
# `dev-seed`, `seed` → `seed`" would otherwise re-admit the two names that
# sentence exists to retire. The vocabulary is the list at the top; discussion
# of the vocabulary is not part of it.
names_in() { awk '/^## /{exit} 1' "$1" | sed -n 's/^- `\([a-z0-9][a-z0-9._/-]*\)`.*/\1/p'; }

# A missing vocabulary makes SUBSYSTEM unvalidatable, which makes this whole
# script theater. Refuse loudly rather than pass everything.
for f in "$TYPES_FILE" "$SCOPES_FILE"; do
  [ -f "$f" ] && continue
  printf 'response-contract: no vocabulary at %s\n' "$f" >&2
  printf 'SUBSYSTEM is type/scope and cannot be checked without both halves.\n' >&2
  [ "$f" = "$SCOPES_FILE" ] && printf 'Seed this repo'"'"'s list from its own history: scope-scan --seed\n' >&2
  exit 2
done

TYPES="$(names_in "$TYPES_FILE")"
SCOPES="$(names_in "$SCOPES_FILE")"
for pair in "types:$TYPES:$TYPES_FILE" "scopes:$SCOPES:$SCOPES_FILE"; do
  what="${pair%%:*}"; rest="${pair#*:}"; vals="${rest%:*}"; src="${rest##*:}"
  [ -n "$vals" ] || { printf 'response-contract: %s has no `- `name`` bullets — no %s to validate against\n' "$src" "$what" >&2; exit 2; }
done

if [ "$LIST_ONLY" -eq 1 ]; then
  printf 'types  (%s)\n' "$TYPES_FILE";  printf '%s\n' "$TYPES"  | sed 's/^/  /'
  printf 'scopes (%s)\n' "$SCOPES_FILE"; printf '%s\n' "$SCOPES" | sed 's/^/  /'
  exit 0
fi

REPORT="$(cat)"

field() { # field NAME -> value, trimmed
  printf '%s\n' "$REPORT" \
    | sed -n "s/^[[:space:]]*$1:[[:space:]]*//p" \
    | head -1 \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}
has_field() { printf '%s\n' "$REPORT" | grep -qE "^[[:space:]]*$1:"; }

# Nothing that looks like a contract -> not our business. The caller decides
# whether a contract was required here; that is a routing question, not a
# validation one.
if ! has_field 'SUBSYSTEM' && ! has_field 'USER-VISIBLE' && ! has_field 'FORK'; then
  exit 3
fi

SUBSYSTEM="$(field SUBSYSTEM)"
USER_VISIBLE="$(field USER-VISIBLE)"
FORK="$(field FORK)"
LEAN="$(field LEAN)"
IF_SILENT="$(field 'IF SILENT')"
COST="$(field 'COST TO UNDO')"

VIOLATIONS=()
add() { VIOLATIONS+=("$1"); }
oneline() { printf '%s' "$1" | tr '\n' ' '; }

# --- SUBSYSTEM: type/scope, both halves from a closed list -----------------
if [ -z "$SUBSYSTEM" ]; then
  add "SUBSYSTEM is missing. Shape is type/scope, e.g. feat/qc-runs."
elif ! printf '%s' "$SUBSYSTEM" | grep -qE '^[a-z]+/[A-Za-z0-9][A-Za-z0-9._-]*$'; then
  add "SUBSYSTEM '$SUBSYSTEM' is not type/scope (one slash, no spaces). e.g. feat/qc-runs."
else
  S_TYPE="${SUBSYSTEM%%/*}"
  S_SCOPE="${SUBSYSTEM#*/}"
  printf '%s\n' "$TYPES"  | grep -qxF "$S_TYPE" \
    || add "Type '$S_TYPE' is not a known type. One of: $(oneline "$TYPES")"
  printf '%s\n' "$SCOPES" | grep -qxF "$S_SCOPE" \
    || add "Scope '$S_SCOPE' is not in this repo's list ($SCOPES_FILE). One of: $(oneline "$SCOPES")"
fi

[ -n "$USER_VISIBLE" ] || add "USER-VISIBLE is missing or empty. 'nothing' is a valid answer — say it explicitly."

# --- the escalation half: all-or-nothing ----------------------------------
# A FORK without a resume protocol is a blocking question wearing a schema.
if [ -n "$FORK" ]; then
  [ -n "$LEAN" ]      || add "FORK is present but LEAN is missing — never raise a fork without a recommendation."
  [ -n "$IF_SILENT" ] || add "FORK is present but IF SILENT is missing — this is the field that makes the question non-blocking."
  if [ -z "$COST" ]; then
    add "FORK is present but COST TO UNDO is missing (minutes | hours | days | can't)."
  else
    case "$(printf '%s' "$COST" | tr 'A-Z' 'a-z')" in
      minutes*|hours*|days*|can\'t*|cant*) ;;
      *) add "COST TO UNDO must start with minutes / hours / days / can't — got '$COST'." ;;
    esac
  fi
  # I9: a question Rio can answer in one glance. Two sentences, no essay.
  SENTENCES="$(printf '%s' "$FORK" | tr -cd '.!?' | wc -c | tr -d ' ')"
  [ "$SENTENCES" -le 2 ] || add "FORK runs $SENTENCES sentences; the cap is 2."
else
  for pair in "LEAN:$LEAN" "IF SILENT:$IF_SILENT" "COST TO UNDO:$COST"; do
    name="${pair%%:*}"; val="${pair#*:}"
    [ -z "$val" ] || add "$name is present without a FORK — it has nothing to qualify. Drop it, or state the fork."
  done
fi

# --- altitude: no field may carry implementation detail --------------------
# This is the check the prose version could never make. A path or a symbol in a
# report means the agent chose the implementation layer before it started
# writing, and no length cap fixes a layer choice.
#
# SUBSYSTEM is deliberately excluded here: it contains a slash by design, and it
# is already validated far more strictly than any regex below — against two
# closed lists.
BODY="$(printf '%s\n%s\n%s\n%s\n%s\n' \
  "$USER_VISIBLE" "$FORK" "$LEAN" "$IF_SILENT" "$COST")"

LEAK="$(printf '%s' "$BODY" | grep -oE '[^[:space:]]*\.(ts|tsx|js|jsx|mjs|sh|zsh|py|rb|go|rs|swift|json|ya?ml|md)\b' | head -3 | tr '\n' ' ')"
[ -z "$LEAK" ] || add "Filenames in the report: ${LEAK}— name the capability, not the file."

LEAK="$(printf '%s' "$BODY" | grep -oE '(^|[[:space:]])(~|\.{1,2})?/[A-Za-z0-9._~-]+/[^[:space:]]*' | head -3 | tr '\n' ' ')"
[ -z "$LEAK" ] || add "Paths in the report:${LEAK}— name the scope, not the directory."

LEAK="$(printf '%s' "$BODY" | grep -oE '[A-Za-z_][A-Za-z0-9_]*\(\)' | head -3 | tr '\n' ' ')"
[ -z "$LEAK" ] || add "Function names in the report: ${LEAK}— Rio does not open the code."

# --- total budget ----------------------------------------------------------
WORDS="$(printf '%s %s' "$SUBSYSTEM" "$BODY" | wc -w | tr -d ' ')"
[ "$WORDS" -le "$MAX_WORDS" ] || add "Contract is $WORDS words; the cap is $MAX_WORDS. Cut detail, not fields."

if [ "${#VIOLATIONS[@]}" -eq 0 ]; then
  exit 0
fi

printf '❌ RESPONSE CONTRACT VIOLATED (%s):\n' "${#VIOLATIONS[@]}" >&2
for v in "${VIOLATIONS[@]}"; do printf '  • %s\n' "$v" >&2; done
printf '\nRequired shape:\n' >&2
printf '  SUBSYSTEM:    <type/scope, e.g. feat/qc-runs>\n  USER-VISIBLE: <what changes for someone using it; "nothing" is valid>\n  FORK:         <the one load-bearing choice, A vs B, <=2 sentences>   (omit if none)\n  LEAN:         <which, and the single reason>                        (required if FORK)\n  IF SILENT:    <what you do if Rio never answers>                    (required if FORK)\n  COST TO UNDO: <minutes | hours | days | can'"'"'t>                       (required if FORK)\n' >&2
exit 1
