#!/usr/bin/env bash
# agent-skills-publish: ship what an agent turn changed in ~/dev/agent-skills.
#
#   agent-skills-publish AGENT SESSION_ID TRANSCRIPT_PATH   (from turn-end/dispatch, detached)
#   agent-skills-publish --touched AGENT TRANSCRIPT_PATH    (print attributed files; tests)
#
# Rio, 2026-11-16: skill edits must reach both Macs without anyone remembering to
# publish, and only from a finished turn. This replaces the 60s auto-sync removed
# 2026-09-09, which committed half-written edits and raced agents' pushes. Here only
# files this session wrote ship, when its turn ends.
#
# 1. Attribute: dirty repo files this session's transcript wrote (Claude
#    Edit/Write/MultiEdit/NotebookEdit; Codex apply_patch file headers). Shell
#    writes (sed -i, >) are not attributed and stay for their session to ship.
# 2. Bump each touched plugin's patch version (unless already bumped), validate,
#    commit only those files, push.
# 3. Update installs for every plugin whose version moved since this Mac last
#    published (also catches manual commits), here and on the other Mac.
# A session in a linked worktree of the repo (HOOK_CWD) does steps 1-2 there and
# lands its commit with `land --autostash` instead of pushing (one retry if the push
# is rejected), then steps 1-2 as before for any main-checkout files it wrote; step 3
# runs from the main checkout. Its subagents' edits attribute the same way.
# Failures are loud: log + one PM inbox status line. A failed remote update is
# retried on the next run.
set -euo pipefail

REPO="${AGENT_SKILLS_REPO:-$HOME/dev/agent-skills}"
STATE="${AGENT_SKILLS_PUBLISH_STATE:-$HOME/.cache/agent-skills-publish}"
LOG="$STATE/publish.log"

codex_rollouts() { # rollout -> it plus every descendant subagent rollout from the last 2 days
  printf '%s\n' "$1"
  python3 - "$1" 2>/dev/null <<'PY' || true
import json
import sys
from collections import defaultdict, deque
from pathlib import Path
from time import time


def metadata(path):
    try:
        with path.open("rb") as rollout:
            record = json.loads(rollout.readline())
        if record["type"] == "session_meta":
            payload = record["payload"]
            if isinstance(payload, dict):
                return payload
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return {}


root = Path(sys.argv[1])
root_id = metadata(root).get("id")
if not isinstance(root_id, str) or not root_id:
    sys.exit(0)

children = defaultdict(list)
cutoff = time() - 2 * 24 * 60 * 60
for path in root.parent.parent.parent.rglob("rollout-*.jsonl"):
    try:
        if path == root or path.stat().st_mtime <= cutoff or not path.is_file():
            continue
    except OSError:
        continue
    payload = metadata(path)
    try:
        parent_id = payload["source"]["subagent"]["thread_spawn"]["parent_thread_id"]
    except (KeyError, TypeError):
        continue
    if isinstance(parent_id, str) and parent_id:
        children[parent_id].append((path, payload.get("id")))

seen = {root}
queue = deque([root_id])
while queue:
    for path, thread_id in children.pop(queue.popleft(), ()):
        if path in seen:
            continue
        seen.add(path)
        print(path)
        if isinstance(thread_id, str) and thread_id:
            queue.append(thread_id)
PY
}

touched() { # agent transcript [checkout] -> checkout-relative paths its own tool calls wrote
  local agent="$1" transcript="$2" root="${3:-$REPO}"
  [ -f "$transcript" ] || return 0
  case "$agent" in
    claude)
      jq -r 'select(.type=="assistant") | .message.content[]?
        | select(.type=="tool_use" and (.name|IN("Edit","Write","MultiEdit","NotebookEdit")))
        | .input.file_path // .input.notebook_path // empty' "$transcript" 2>/dev/null || true ;;
    codex) # apply_patch, called directly or from an exec script, here or in a subagent
      # (Codex subagents fire no Stop; their rollouts name the parent thread).
      codex_rollouts "$transcript" | while IFS= read -r r; do
        jq -r 'select(.type=="response_item") | .payload
          | select(.name=="apply_patch" or .name=="exec") | (.input // .arguments // empty)' "$r" 2>/dev/null
      done |
        grep -o '\*\*\* \(Update\|Add\|Delete\) File: [^\\"]*\|\*\*\* Move to: [^\\"]*' |
        sed 's/^\*\*\* [A-Za-z ]*: //' || true ;;
  esac | sed "s|^~/|$HOME/|" | while IFS= read -r p; do
    case "$p" in "$root"/*) printf '%s\n' "${p#"$root"/}" ;; esac
    # check-ledger.sh --coverage regenerates GOALS.md's coverage block from the ledger.
    if [ "$p" = "$root/LEDGER.md" ]; then printf '%s\n' GOALS.md; fi
  done | sort -u
}

if [ "${1:-}" = --touched ]; then touched "${2:-}" "${3:-}"; exit 0; fi

agent="${1:-}" session="${2:-}" transcript="${3:-}"
[ -d "$REPO/.git" ] || exit 0
mkdir -p "$STATE"

# The linked worktree of REPO this session works in, if any (WT). Its agents often
# also edit main-checkout paths (skills load from there), so both checkouts are read.
WT=""
if [ -n "${HOOK_CWD:-}" ] && [ -d "$HOOK_CWD" ]; then
  top="$(git -C "$HOOK_CWD" rev-parse --show-toplevel 2>/dev/null || true)"
  common="$(git -C "$HOOK_CWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  real_repo="$(cd "$REPO" && pwd -P)"
  if [ -n "$top" ] && [ "$(cd "$top" && pwd -P)" != "$real_repo" ] &&
    [ "$(cd "$common" 2>/dev/null && pwd -P)" = "$real_repo/.git" ]; then
    WT="$top"
  fi
fi

case "$(scutil --get LocalHostName 2>/dev/null || hostname)" in
  *[Mm]ini*) other=macbook ;;
  *MacBook*) other=mini ;;
  *) other="" ;;
esac
other="${AGENT_SKILLS_PUBLISH_OTHER-$other}" # tests set it empty

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }
fail() {
  log "FAIL $*"
  "$HOME/dev/project-manager/scripts/pm_inbox.py" add agent-skills-publish status \
    "agent-skills publish failed on $(hostname -s): $*. Log: $LOG" >>"$LOG" 2>&1 || true
  exit 1
}

dirty_in() { git -C "$1" status --porcelain --untracked-files=all | cut -c4- | sed 's/.* -> //'; }
mine_in() { # checkout -> its dirty files this session's transcript wrote
  local dirty
  dirty="$(dirty_in "$1")"
  [ -z "$dirty" ] || comm -12 <(touched "$agent" "$transcript" "$1") <(printf '%s\n' "$dirty" | sort -u)
}

# Fast path: nothing of this session's to commit and no pending install work.
marker="$STATE/published-head"
pending="$STATE/remote-pending"
mine_wt=""
[ -z "$WT" ] || mine_wt="$(mine_in "$WT")"
mine="$(mine_in "$REPO")"
if [ -z "$mine_wt$mine" ] && [ ! -s "$pending" ] && [ "$(cat "$marker" 2>/dev/null)" = "$(git -C "$REPO" rev-parse HEAD)" ]; then
  exit 0
fi

# One publisher at a time per Mac; plugin updates take a minute.
lock="$STATE/lock"
for _ in $(seq 1 300); do
  mkdir "$lock" 2>/dev/null && break
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +15 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null || true; fi
  sleep 1
done
[ -d "$lock" ] || fail "lock busy for 5 minutes"
trap 'rmdir "$lock" 2>/dev/null || true' EXIT
tail -n 1000 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" || true

publish() { # checkout files -> 1. re-attribute under the lock, 2. bump, validate, commit, push or land
  local root="$1" mine files=() f plugin manifest now head_version next code=0
  cd "$root"
  # Another publisher may have shipped some while this one waited for the lock.
  mine="$(comm -12 <(printf '%s\n' "$2") <(dirty_in "$root" | sort -u) | sed '/^$/d')"
  [ -n "$mine" ] || return 0
  log "$agent $session${WT:+ in $root}: $(printf '%s' "$mine" | tr '\n' ' ')"
  if [ "$root" != "$REPO" ] && ! git symbolic-ref -q HEAD >/dev/null; then
    fail "worktree $root is on a detached HEAD, land needs a branch; its edits stay uncommitted"
  fi
  files=()
  while IFS= read -r f; do files+=("$f"); done <<<"$mine"
  for plugin in $(printf '%s\n' "$mine" | sed -n 's|^plugins/\([^/]*\)/.*|\1|p' | sort -u); do
    manifest="plugins/$plugin/.claude-plugin/plugin.json"
    [ -f "$manifest" ] || continue
    now="$(jq -r .version "$manifest")"
    head_version="$(git show "HEAD:$manifest" 2>/dev/null | jq -r .version 2>/dev/null || echo none)"
    if [ "$now" = "$head_version" ]; then
      next="$(printf '%s' "$now" | awk -F. -v OFS=. '{$NF=$NF+1; print}')"
      sed -i '' "s/\"version\": \"$now\"/\"version\": \"$next\"/" "$manifest"
      log "bump $plugin $now -> $next"
    fi
    files+=("$manifest")
    claude plugin validate "plugins/$plugin" --strict >>"$LOG" 2>&1 || fail "plugin $plugin failed validation"
  done
  # Warn-only skill length check; lowers the baseline when a skill shrank (never blocks).
  if [ -x plugins/utils/skills/grumbo/scripts/skill-size.sh ] && [ -f skill-size-baseline.tsv ]; then
    plugins/utils/skills/grumbo/scripts/skill-size.sh >>"$LOG" 2>&1 || log "skill-size check errored (warn only)"
    git diff --quiet -- skill-size-baseline.tsv || files+=(skill-size-baseline.tsv)
  fi
  git add -- "${files[@]}" >>"$LOG" 2>&1 || fail "git add"
  git commit -q -m "publish: ${agent:-agent} turn ${session:0:8}" \
    -m "Auto-published at turn end by agent-skills-publish." -- "${files[@]}" >>"$LOG" 2>&1 ||
    fail "git commit"
  if [ "$root" != "$REPO" ]; then
    # Exit 5 is a rejected push (origin moved after land's fetch): land again once,
    # as the main-checkout path pulls and pushes again. Anything else needs a person.
    "${SCRIPTS:-$HOME/scripts}/land" --autostash >>"$LOG" 2>&1 || code=$?
    if [ "$code" = 5 ]; then code=0; "${SCRIPTS:-$HOME/scripts}/land" --autostash >>"$LOG" 2>&1 || code=$?; fi
    [ "$code" = 0 ] || fail "land from $root (exit $code, see land in $LOG); the commit waits on its branch"
  elif ! git push -q >>"$LOG" 2>&1; then
    git pull -q --rebase --autostash >>"$LOG" 2>&1 || fail "pull --rebase before push"
    git push -q >>"$LOG" 2>&1 || fail "git push"
  fi
}

# Worktree first: it lands, and the main checkout fast-forwards before its own commit.
[ -z "$WT" ] || publish "$WT" "$mine_wt"
publish "$REPO" "$mine"

# 3. Update installs for plugins whose version moved since the last publish here.
cd "$REPO"
head="$(git rev-parse HEAD)"
last="$(cat "$marker" 2>/dev/null || true)"
if [ -z "$last" ] || ! git cat-file -e "$last" 2>/dev/null; then
  printf '%s\n' "$head" >"$marker"
  last="$head"
fi
moved="$(git diff --name-only "$last" "$head" -- 'plugins/*/.claude-plugin/plugin.json' |
  sed -n 's|^plugins/\([^/]*\)/.*|\1|p' | sort -u)"
if [ -n "$moved" ]; then
  # shellcheck disable=SC2086
  python3 scripts/update-plugin-installs.py $moved >>"$LOG" 2>&1 || fail "local plugin update ($moved)"
  log "updated here: $(printf '%s' "$moved" | tr '\n' ' ')"
fi
printf '%s\n' "$head" >"$marker"

if [ -n "$other" ]; then
  remote="$( { cat "$pending" 2>/dev/null; printf '%s\n' "$moved"; } | sed '/^$/d' | sort -u | tr '\n' ' ')"
  if [ -n "$mine_wt$mine" ] || [ -n "$remote" ]; then
    printf '%s\n' $remote >"$pending"
    if ssh -o BatchMode=yes -o ConnectTimeout=20 "$other" \
      "zsh -lc 'cd ~/dev/agent-skills && git pull -q --ff-only && { [ -z \"$remote\" ] || python3 scripts/update-plugin-installs.py $remote; }'" >>"$LOG" 2>&1; then
      : >"$pending"
      log "synced $other: ${remote:-pull only}"
    else
      fail "$other pull/update failed (${remote:-pull only}); retries next turn"
    fi
  fi
fi
