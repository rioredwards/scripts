#!/bin/sh
set -eu

scripts_root="${SCRIPTS:-$HOME/scripts}"
payload="$(cat)"

# A reply about to be bounced and rewritten — over the length cap, or tripping
# an `on: response` rule in rules.json — fires Stop again on the rewrite.
# Narrating both passes would put two phone texts and two audio clips in front
# of Rio for one turn. Skip this pass; the rewrite is the turn he actually reads.
if [ -f "$scripts_root/hooks/lib/reply-cap-lib.sh" ]; then
  . "$scripts_root/hooks/lib/reply-cap-lib.sh"
  # `if`, not `&&` — this script runs under `set -e`, where a falsy `&&` list
  # would abort the hook on every reply that is *under* the cap.
  if reply_will_be_rewritten "$payload"; then exit 0; fi
fi

# Export origin metadata so downstream hooks (audio-note-to-file sidecar) can
# record where this turn came from. Empty when a field is absent.
HOOK_AGENT=claude
HOOK_SESSION_ID="$(printf '%s' "$payload" | jq -r '.session_id // empty')"
HOOK_CWD="$(printf '%s' "$payload" | jq -r '.cwd // empty')"
HOOK_TRANSCRIPT_PATH="$(printf '%s' "$payload" | jq -r '.transcript_path // empty')"
export HOOK_AGENT HOOK_SESSION_ID HOOK_CWD HOOK_TRANSCRIPT_PATH

printf '%s' "$payload" | jq -r '.last_assistant_message // empty' | "$scripts_root/hooks/note-on-turn/note-from-reply"
