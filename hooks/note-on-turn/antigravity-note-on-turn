#!/bin/sh
set -eu

stdin_json="$(cat)"
transcript_path="$(echo "$stdin_json" | jq -r '.transcriptPath // .transcript_path // empty')"

if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
  jq -s -r '[.[] | select(.source == "MODEL" and .type == "PLANNER_RESPONSE" and has("content") and .content != "")] | last | .content // empty' "$transcript_path"
else
  echo "$stdin_json" | jq -r '.last_assistant_message // .prompt_response // empty'
fi | "$HOME/scripts/hooks/note-on-turn/note-from-reply"
