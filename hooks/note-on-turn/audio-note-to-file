#!/bin/sh
# stdin: reply summary. Synthesizes a local audio file into the agent-audio
# iCloud dir and writes a metadata sidecar next to it. This replaces the old
# phone Shortcut that produced these files from the text message.
#
# Engine: `grok` (xAI TTS via grok-tts, default) | `say` (macOS, offline).
# Chosen by AGENT_AUDIO_FILE_ENGINE (agent-hooks profile) or the -e flag.
# A Siri-shortcut engine will be added here later.
#
# Origin metadata (session/cwd/repo/transcript) is read from HOOK_* env vars
# that the per-agent wrapper exports. Missing fields are written as "".
#
#   -m FILE   JSON object merged into the sidecar at the top level (the
#             narration path: narration, title, context).
#   -t STR    what to slug the filename from, instead of the spoken text.
#
# Runs the synth detached so it never blocks the calling hook. Pass -w to wait
# instead: synth runs in the foreground and the audio path is printed on
# success (for callers like content-pipeline that need the file now). Failures
# are logged (never fall back to a different engine silently) and the text
# message is unaffected either way.
set -eu

# Load profile so this works standalone too (env already set wins).
# shellcheck source=/dev/null
[ -f "$HOME/scripts/agent-hooks-env.sh" ] && . "$HOME/scripts/agent-hooks-env.sh"
engine="${AGENT_AUDIO_FILE_ENGINE:-grok}"

wait_mode=0
merge_file=""
title=""
while getopts ":e:wm:t:" opt; do
  case "$opt" in
    e) engine="$OPTARG" ;;
    w) wait_mode=1 ;;
    m) merge_file="$OPTARG" ;;
    t) title="$OPTARG" ;;
    *) : ;;
  esac
done
shift $((OPTIND - 1))

summary="$(cat)"
[ -n "$summary" ] || exit 0

log_dir="$HOME/.cache/note-on-turn"
mkdir -p "$log_dir"
log="$log_dir/audio-note.log"

# Only generate on the designated host so a stowed profile doesn't make every
# machine write to the same shared iCloud dir. Empty = any host.
#
# A mismatch is expected on the non-designated machine (background hook: log and
# exit 0), but it's a hard failure for a caller that asked for the file with -w
# — exit 3 so it surfaces instead of looking like an empty result.
#
# macOS renumbers LocalHostName after a Bonjour name collision (Rios-Mac-mini-2
# becomes Rios-Mac-mini-3), which silently broke this gate and dropped two turns
# on 2026-07-25. The suffix also flaps back on its own, so a gate that matches
# the literal name works until it doesn't. Compare with any trailing collision
# suffix stripped, case-insensitively. macOS can also report the same Mac as
# `macbookair` or `Rios-MacBook-Air`, so ignore Rio's prefix and punctuation.
want_host="${AGENT_AUDIO_FILE_HOST:-}"
this_host="$(hostname -s 2>/dev/null)"
host_base() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/-[0-9]+$//; s/^rios-//; s/[^a-z0-9]//g'
}
if [ -n "$want_host" ] && [ "$(host_base "$want_host")" != "$(host_base "$this_host")" ]; then
  printf '%s host gate: %s != AGENT_AUDIO_FILE_HOST=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$this_host" "$want_host" >>"$log"
  if [ "$wait_mode" -eq 1 ]; then
    printf 'audio-note-to-file: host gate blocked — this host is %s, AGENT_AUDIO_FILE_HOST=%s\n' \
      "$this_host" "$want_host" >&2
    exit 3
  fi
  exit 0
fi

# Strip markdown noise so speech sounds natural.
speech="$(printf '%s' "$summary" | sed 's/[*_`#>~|]//g')"
[ -n "$speech" ] || exit 0

# The agent-audio dir is split into recent/ and stable/. Everything written here
# is a regenerable per-turn clip, so it goes to recent/, which is the only half
# the size cap ever touches. Anything worth keeping gets moved to stable/ by hand.
#
# Not named tmp/: iCloud Drive silently refuses to sync a dir called tmp, so
# clips written there never reached any other machine.
audio_base="${AGENT_AUDIO_BASE_DIR:-$HOME/Library/Mobile Documents/iCloud~is~workflow~my~workflows/Documents/agent-audio}"
dir="${AGENT_AUDIO_FILE_DIR:-$audio_base/recent}"
mkdir -p "$dir"

# Rotation lives entirely in agent-audio-prune, on an hourly LaunchAgent. It is
# deliberately NOT called from here: writing a clip used to trigger a prune, which
# made any synth potentially destructive — a single throwaway test clip on
# 2026-07-25 deleted 170MB of dictation captures as a side effect. Writing is now
# never a deletion, and the schedule alone enforces the cap.

# File extension follows the engine.
case "$engine" in
  grok) ext="mp3" ;;
  say)  ext="aiff" ;;
  *) printf '%s unknown engine "%s"\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$engine" >>"$log"; exit 2 ;;
esac

# Slug the summary into a filename that matches the existing convention:
# leading dash, dash-joined words, capped. The Raycast extension prettifies
# this back into a readable title.
#
# -t overrides what gets slugged. A narration opens with an orientation lead-in
# ("It's 11:03 on Tuesday night, this is turn three in the scripts project…"),
# so slugging its first words would name every clip in the player the same
# thing. `narration-title` picks a sentence that actually describes the turn.
slug_source="${title:-$summary}"
slug="$(printf '%s' "$slug_source" \
  | sed 's/[*_`#>~|]//g' \
  | tr '\n\t' '  ' \
  | sed -E 's/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' \
  | cut -c1-48 \
  | sed -E 's/-+$//')"
[ -n "$slug" ] || slug="note"
base="-$slug"

# Avoid clobbering an identical earlier summary.
out="$dir/$base.$ext"
n=2
while [ -e "$out" ]; do
  out="$dir/$base-$n.$ext"
  n=$((n + 1))
done
sidecar="${out%.$ext}.json"

cwd="${HOOK_CWD:-}"

# A synth failure produces no audio and no sidecar, so the turn disappears with
# nothing but a log line to show for it — XAI_API_KEY went missing on 2026-07-21
# and ate a run of turns unnoticed. Text Rio instead, debounced so a sustained
# outage sends one message rather than one per turn.

# Optional merge object (-m FILE): narration, title and context, merged into the
# sidecar at the top level. Read HERE, before any fork, and kept in a variable —
# the sidecar is written seconds later inside a backgrounded synth, by which time
# a caller that passed a mktemp file has already exited and cleaned it up.
# Reading it late meant the clip lost its prose silently and the web view quietly
# degraded to speech text with no annotations.
merge='{}'
if [ -n "$merge_file" ]; then
  if [ -f "$merge_file" ]; then
    merge="$(cat "$merge_file")"
  else
    printf '%s -m file missing: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$merge_file" >>"$log"
  fi
fi

notify_failure() {
  stamp="$log_dir/audio-note-failed.stamp"
  now="$(date +%s)"
  last="$(cat "$stamp" 2>/dev/null || echo 0)"
  case "$last" in ''|*[!0-9]*) last=0 ;; esac
  [ "$(( now - last ))" -ge "${AGENT_AUDIO_FILE_ALERT_EVERY:-1800}" ] || return 0
  printf '%s' "$now" > "$stamp"
  printf '🔴 Agent audio failed (%s on %s): %s' "$engine" "$(hostname -s)" "$1" \
    | "$HOME/scripts/sc" text-phone >/dev/null 2>&1 || true
}

synth_and_sidecar() {
  # Synthesize the audio. On failure: log, alert, and stop — no silent engine swap.
  case "$engine" in
    grok)
      if ! printf '%s' "$speech" | "$HOME/scripts/grok-tts" -o "$out" >/dev/null 2>>"$log"; then
        printf '%s grok-tts failed: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$out" >>"$log"
        notify_failure 'grok-tts failed — see ~/.cache/note-on-turn/audio-note.log'
        exit 1
      fi
      ;;
    say)
      if ! say -o "$out" -- "$speech" >/dev/null 2>>"$log"; then
        printf '%s say failed: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$out" >>"$log"
        notify_failure 'say failed — see ~/.cache/note-on-turn/audio-note.log'
        exit 1
      fi
      ;;
  esac

  # Origin metadata sidecar (written only after the audio exists so there are
  # no orphan sidecars). Migrates into the sessions store later.
  repo=""
  repo_name=""
  if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    repo="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$repo" ] && repo_name="$(basename "$repo")"
  fi

  # Stable id for the clip+sidecar pair. Filename is a slug of the summary with
  # -2/-3 collision suffixes, so it is neither unique over time nor stable across
  # a rename — anything keying on it loses the metadata when iCloud or a
  # collision moves the file. Sortable prefix so ids order like the clips do,
  # random suffix so two turns in the same second can't collide.
  id="$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"

  jq -n \
    --arg id "$id" \
    --arg audio "$(basename "$out")" \
    --arg summary "$summary" \
    --arg agent "${HOOK_AGENT:-}" \
    --arg session_id "${HOOK_SESSION_ID:-}" \
    --arg cwd "$cwd" \
    --arg repo "$repo" \
    --arg repo_name "$repo_name" \
    --arg transcript_path "${HOOK_TRANSCRIPT_PATH:-}" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg engine "$engine" \
    --argjson merge "$merge" \
    '{id:$id, audio:$audio, summary:$summary, agent:$agent, session_id:$session_id, cwd:$cwd, repo:$repo, repo_name:$repo_name, transcript_path:$transcript_path, created_at:$created_at, engine:$engine}
     + $merge' \
    > "$sidecar" 2>>"$log" || printf '%s sidecar write failed: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sidecar" >>"$log"

}

if [ "$wait_mode" -eq 1 ]; then
  synth_and_sidecar
  printf '%s\n' "$out"
else
  synth_and_sidecar &
fi
