#!/bin/sh
# Shared core for all agent note-on-turn hooks.
# stdin: reply text. Adapters export optional HOOK_* origin metadata.
set -eu

scripts_root="${SCRIPTS:-$HOME/scripts}"

# Load agent-hooks profile (AGENT_SPEAK, etc.). Env vars already set win over profile.
# shellcheck source=/dev/null
. "$scripts_root/agent-hooks-env.sh"
AGENT_SPEAK="${AGENT_SPEAK:-off}"

text="$(cat)"
[ -n "$text" ] || exit 0

# A delegate's reply is not a turn Rio is waiting on. Spin-check probes,
# agent-router delegates and MCP sub-agents all end their turn the same way a
# real one does, and the parent agent's own hook already covers the real turn.
# Unguarded, spin-check alone put a phone text, a TTS clip and a web view page
# in front of Rio every ~20 tool calls per session, every one of them saying
# "on track".
#
# Two markers, because the parent can be either agent:
#   AGENT_DELEGATE  set by the caller (spin-check) — provider-agnostic.
#   CLAUDECODE      Claude Code's own marker, inherited by everything it
#                   spawns. Only meaningful for a non-claude agent: the claude
#                   hook always runs inside Claude Code, so it is always set.
if [ -n "${AGENT_DELEGATE:-}" ] ||
   { [ "${HOOK_AGENT:-}" != claude ] && [ -n "${CLAUDECODE:-}" ]; }; then
  exit 0
fi

log_dir="$HOME/.cache/note-on-turn"
mkdir -p "$log_dir"

# Perf markers. One line per stage into perf.log, seconds since the turn ended,
# so the wait between Rio reading the reply and the audio/page landing can be
# attributed instead of guessed at. Exported so the detached audio and webview
# children stamp the same timeline. Deliberately crude: second resolution and no
# rotation — every stage worth optimizing here is measured in seconds.
PERF_LOG="$log_dir/perf.log"
PERF_T0="$(date +%s)"
PERF_RUN="$$"
export PERF_LOG PERF_T0 PERF_RUN
mark() { printf '%s +%ss %s\n' "$PERF_RUN" "$(( $(date +%s) - PERF_T0 ))" "$1" >>"$PERF_LOG" 2>/dev/null || true; }
mark turn-start

# Narrate once, as prose. The phone text, the spoken audio and the web view all
# render from that one piece of text, so they cannot drift apart the way a
# separate narration field did.
#
# This replaced a structured JSON summary ({headline, sections[]}) that every
# surface was flattened out of. The schema kept the surfaces in sync but was
# built for a page: spoken aloud it became a list of section titles, it forced
# content into categories that often didn't fit, and it opened with no
# orientation at all. Prose with inline annotations keeps the sync — the text
# *is* the artifact — without any of that.
#
# A failed transform must NOT degrade into shipping the raw reply — that is the
# exact silent failure this pipeline existed to prevent: Rio gets a novel on his
# phone and no signal that the summarizer broke. Any failure in the chain
# delivers a short explicit notice instead.
#
#   narration  prose with inline annotations -> web view
#   summary    same text, annotations kept   -> phone
#   spoken     annotations as spoken cues    -> TTS
degraded=""
ctx_tmp=""
merge_json='{}'
narration=""
summary=""
spoken=""
title=""
err_tmp=""
fail_stage=""
fail_code=0
# `return 0` is load-bearing: in sh the EXIT trap's last command sets the
# script's exit status, so a falsy [ -n "" ] here made every degraded turn
# exit 1.
cleanup() {
  [ -n "$ctx_tmp" ] && rm -f "$ctx_tmp"
  [ -n "$err_tmp" ] && rm -f "$err_tmp"
  return 0
}
trap cleanup EXIT

# The facts that orient the narration — time, machine, project, branch,
# worktree, turn number, session goal, issue. Computed, never inferred: see
# narration-context. Handed to the model as verified data so it phrases them into a
# lead-in instead of guessing at them. Never fails; an empty block just means
# the narration opens without orientation.
#
# Depth rides in as one more fact — the same brief|balanced|deep level the
# Raycast summarizer and content-pipeline already pass. The `narrate-turn`
# prompt has always honored a `Depth` fact; this hook was the only producer
# never sending one. Length is not just a reading cost: synthesis time tracks
# it, measured at 41s for a long turn against 6s for a short one.
#
# `balanced` and unset are the same instruction to the prompt (use the length
# the content deserves), so only brief and deep are worth a fact. An unknown
# value is dropped and logged rather than passed through as a fact the model
# would quietly ignore.
depth="${AGENT_NARRATE_DEPTH:-}"
case "$depth" in
  brief|deep) : ;;
  ''|balanced) depth="" ;;
  *) printf '%s\tignoring AGENT_NARRATE_DEPTH=%s (want brief|balanced|deep)\n' \
       "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$depth" >>"$log_dir/summarize.err"
     depth="" ;;
esac

ctx_tmp="$(mktemp)"
# Adapters that know something narration-context can't (e.g. the ExitPlanMode
# hook framing a plan as "awaiting approval") pass it through this var. Same
# -f mechanism as Depth; unset on ordinary turns, so behavior there is
# unchanged.
extra_fact="${AGENT_NARRATE_EXTRA_FACT:-}"
if [ -n "$depth" ] && [ -n "$extra_fact" ]; then
  "$scripts_root/narration-context" -f "Depth: $depth" -f "$extra_fact" > "$ctx_tmp" 2>>"$log_dir/summarize.err" || true
elif [ -n "$depth" ]; then
  "$scripts_root/narration-context" -f "Depth: $depth" > "$ctx_tmp" 2>>"$log_dir/summarize.err" || true
elif [ -n "$extra_fact" ]; then
  "$scripts_root/narration-context" -f "$extra_fact" > "$ctx_tmp" 2>>"$log_dir/summarize.err" || true
else
  "$scripts_root/narration-context" > "$ctx_tmp" 2>>"$log_dir/summarize.err" || true
fi
mark context

# Each stage runs on its own so a failure names itself. The old form chained
# all three into one `if`, which recorded neither which stage broke nor why —
# 13 skipped turns in a single day left 13 identical anonymous lines and
# nothing to act on. Stderr goes to a scratch file and is flushed to the log
# only on failure: on a good turn it is noise, and interleaving it with other
# concurrent hooks made it unattributable anyway.
#
# `fail_code=$?` must come before `fail_stage=`, or the assignment overwrites
# the status we are trying to capture.
err_tmp="$(mktemp)"

# Facts first, then the reply, with a header between them so the model can tell
# which is which.
if [ -s "$ctx_tmp" ]; then
  transform_input="$(cat "$ctx_tmp")
TEXT TO REWRITE

$text"
else
  transform_input="$text"
fi

# Writing quality is the entire point of this pipeline, so it runs on a stronger
# model than the aitt default. Overridable from the agent-hooks profile.
if [ -z "$fail_stage" ]; then
  narration="$(printf '%s' "$transform_input" \
    | LLM_MODEL="${AGENT_NARRATE_MODEL:-sonnet}" "$scripts_root/aitt" narrate-turn 2>"$err_tmp")" \
    || { fail_code=$?; fail_stage="aitt narrate-turn"; }
  mark narrate
fi
# Empty output with exit 0 is the common failure, and the one the old chain
# hid completely: `[ -n "$raw" ]` failed silently and looked like every other
# error. Name it distinctly.
if [ -z "$fail_stage" ] && [ -z "$narration" ]; then
  fail_stage="aitt narrate-turn (empty output, exit 0)"
fi
# The transform's first line is the model's title for the turn. Keep the raw
# output for narration-title to read it from, and strip it out of the narration
# every surface renders — the phone, the audio, the web view, the sidecar.
narration_raw="$narration"
if [ -z "$fail_stage" ]; then
  narration="$(printf '%s' "$narration_raw" | "$scripts_root/narration-body" 2>>"$err_tmp")" \
    || { fail_code=$?; fail_stage="narration-body"; }
fi
if [ -z "$fail_stage" ]; then
  summary="$(printf '%s' "$narration" | "$scripts_root/narration-render" 2>>"$err_tmp")" \
    || { fail_code=$?; fail_stage="narration-render"; }
fi
if [ -z "$fail_stage" ]; then
  spoken="$(printf '%s' "$narration" | "$scripts_root/narration-render" --speech 2>>"$err_tmp")" \
    || { fail_code=$?; fail_stage="narration-render --speech"; }
fi

if [ -z "$fail_stage" ]; then
  # The model's own title for the turn, read off the raw output's first line.
  # Fed the raw text, not the stripped body, because that line is the answer —
  # narration-title falls back to picking a sentence only when it is missing.
  # Best-effort either way: a missing title costs a good filename, not the turn.
  title="$(printf '%s' "$narration_raw" | "$scripts_root/narration-title" -c "$ctx_tmp" 2>>"$err_tmp" || true)"

  # Carried into the sidecar and the page payload so both surfaces show the
  # prose (with its annotations intact) and the orientation facts, rather than
  # the emoji-stripped speech text.
  #
  # Held as a string, not a temp file. Both consumers now run inside a detached
  # chain that can outlive this script, and a mktemp path handed across that
  # boundary is deleted by the EXIT trap before the child reads it — the race
  # that silently stripped structure off sidecars once already.
  merge_json="$(jq -n --arg narration "$narration" --arg title "$title" --arg context "$(cat "$ctx_tmp")" \
    '{narration:$narration, title:$title, context:$context}' 2>>"$log_dir/summarize.err")" \
    || merge_json='{}'
  [ -n "$merge_json" ] || merge_json='{}'
  mark render+title
else
  degraded=1
  summary="⚠️ Summarizer failed this turn on $(hostname -s) — no summary sent (raw reply withheld). Stage: $fail_stage. See $log_dir/summarize.err"
  spoken="$summary"
  # One record per failure carrying everything needed to diagnose it without
  # reproducing: which stage, its exit code, how much the model actually
  # returned, who was running, and the stage's own stderr. `origin` was logged
  # here before but nothing ever set HOOK_ORIGIN, so every line read
  # "origin=unknown" — the adapters export HOOK_AGENT/HOOK_SESSION_ID.
  {
    printf '%s\tFAILED stage=%s exit=%s raw_bytes=%s agent=%s session=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$fail_stage" "$fail_code" \
      "${#narration}" "${HOOK_AGENT:-unknown}" "${HOOK_SESSION_ID:-unknown}"
    if [ -s "$err_tmp" ]; then
      sed -n '1,20s/^/          stderr: /p' "$err_tmp"
    else
      printf '          stderr: (none — stage produced no diagnostics)\n'
    fi
  } >>"$log_dir/summarize.err"
fi

# Speak the summary aloud when the voice toggle is on. Uses the emoji-stripped
# text: a speech engine either skips an emoji or reads its name out loud.
# Skipped when degraded: the phone text already carried the failure; there is no
# reason to spend TTS on an error string.
case "${degraded:+skip}${AGENT_SPEAK}" in
  on|1|true|yes) printf '%s' "$spoken" | "$scripts_root/hooks/note-on-turn/speak-note" ;;
esac

# Write a local audio file of the summary into the agent-audio dir when the
# audio-file toggle is on (replaces the old phone Shortcut). Self-detaches.
#
# Self-expiring: if the toggle has been on longer than AGENT_AUDIO_FILE_TTL_MIN
# (default 60), auto-disable it and text Rio — a forgotten toggle otherwise
# burns TTS credits all day. The switch-on time is stamped by `agent-toggle` as
# AGENT_AUDIO_FILE_SINCE; if it's missing (enabled before this guard, or via the
# profile default), we stamp it now so the cap always applies. TTL_MIN=0 disables.
#
# This block only DECIDES. The synth itself runs in the detached chain below,
# because the web view now waits on its result.
AGENT_AUDIO_FILE="${AGENT_AUDIO_FILE:-off}"
audio_wanted=""
# Same reasoning as speak-note: never synthesize audio of a failure string.
case "${degraded:+skip}${AGENT_AUDIO_FILE}" in
  on|1|true|yes)
    ttl_min="${AGENT_AUDIO_FILE_TTL_MIN:-60}"
    case "$ttl_min" in ''|*[!0-9]*) ttl_min=60 ;; esac
    since="${AGENT_AUDIO_FILE_SINCE:-}"
    case "$since" in *[!0-9]*) since="" ;; esac
    if [ "$ttl_min" -eq 0 ]; then
      audio_wanted=1
    elif [ -z "$since" ]; then
      "$scripts_root/agent-toggle" audio on >/dev/null 2>&1 || true
      audio_wanted=1
    elif [ "$(( $(date +%s) - since ))" -gt "$(( ttl_min * 60 ))" ]; then
      "$scripts_root/agent-toggle" audio off >/dev/null 2>&1 || true
      printf '🔇 Agent audio auto-off after %sm on %s (forgotten toggle — TTS credits saved)' "$ttl_min" "$(hostname -s)" \
        | "$scripts_root/sc" text-phone >/dev/null 2>&1 || true
    else
      audio_wanted=1
    fi
    ;;
esac

# Pop the turn's summary in a web view window when the webview toggle is on.
# The page renders the same narration the phone and the audio are made from, so
# the surfaces always agree — and now carries the turn's clip in a player, so
# reading it and listening to it are one window instead of two arrivals.
#
# Deliberately NOT gated on `degraded` — the other surfaces skip a failure
# because narrating an error string wastes TTS, but a page costs nothing and
# putting the ⚠️ on screen is the fastest way for Rio to notice the summarizer
# broke.
#
# Also not host-gated the way audio is: the window opens on whichever machine ran
# the turn, unless AGENT_WEBVIEW_HOST names another one to ship the page to (the
# ssh'd-into-the-mini case — webview-note handles it).
#
# Decision only, same as the audio block; the chain below does the work.
AGENT_WEBVIEW="${AGENT_WEBVIEW:-off}"
webview_wanted=""
# Self-expiring on the same pattern as the audio toggle: a window that keeps
# appearing on every turn a week after it was useful is noise. No phone text on
# expiry (unlike audio, which is protecting spend) — this is a GUI surface, and
# it stopping is self-evident to whoever is sitting in front of it.
case "$AGENT_WEBVIEW" in
  on|1|true|yes)
    wv_ttl_min="${AGENT_WEBVIEW_TTL_MIN:-60}"
    case "$wv_ttl_min" in ''|*[!0-9]*) wv_ttl_min=60 ;; esac
    wv_since="${AGENT_WEBVIEW_SINCE:-}"
    case "$wv_since" in *[!0-9]*) wv_since="" ;; esac
    if [ "$wv_ttl_min" -eq 0 ]; then
      webview_wanted=1
    elif [ -z "$wv_since" ]; then
      "$scripts_root/agent-toggle" webview on >/dev/null 2>&1 || true
      webview_wanted=1
    elif [ "$(( $(date +%s) - wv_since ))" -gt "$(( wv_ttl_min * 60 ))" ]; then
      "$scripts_root/agent-toggle" webview off >/dev/null 2>&1 || true
      printf '%s\twebview auto-off after %sm\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$wv_ttl_min" >>"$log_dir/webview-note.log"
    else
      webview_wanted=1
    fi
    ;;
esac

# The page payload, built here rather than in the chain: HOOK_CWD's repo lookup
# and the timestamp belong to the turn, not to whenever the synth happens to
# finish.
wv_payload=""
if [ -n "$webview_wanted" ]; then
  wv_repo_name=""
  if [ -n "${HOOK_CWD:-}" ] && [ -d "${HOOK_CWD:-}" ]; then
    wv_repo="$(git -C "$HOOK_CWD" rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$wv_repo" ] && wv_repo_name="$(basename "$wv_repo")"
  fi
  wv_payload="$(jq -n \
    --arg summary "$summary" \
    --arg agent "${HOOK_AGENT:-}" \
    --arg repo_name "$wv_repo_name" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson merge "$merge_json" \
    '{summary:$summary, agent:$agent, repo_name:$repo_name, created_at:$created_at} + $merge')"
fi

# Synthesize, then show the page — one detached chain, so the hook still returns
# immediately but the two surfaces of a turn arrive together.
#
# They used to fork side by side. The page won that race by ~25s and sat there
# silent and playerless while the clip was still being synthesized, so a single
# turn interrupted twice and neither surface knew about the other. Chained, the
# window opens once, with the clip already in it.
#
# When no audio is coming — toggle off, host-gated to the mini, a degraded turn,
# or a synth that failed — the page opens immediately, transcript-only. There is
# nothing to wait for, and a page is still the fastest way to see a ⚠️.
if [ -n "$audio_wanted" ] || [ -n "$webview_wanted" ]; then
  {
    audio_path=""
    if [ -n "$audio_wanted" ]; then
      # -w: run the synth in the foreground of THIS chain and print the path.
      # The merge object becomes a file only here, inside the chain that owns it.
      merge_file=""
      if [ "$merge_json" != '{}' ]; then
        merge_file="$(mktemp)"
        printf '%s' "$merge_json" > "$merge_file"
      fi
      if [ -n "$merge_file" ]; then
        audio_path="$(printf '%s' "$spoken" \
          | "$scripts_root/hooks/note-on-turn/audio-note-to-file" -w -m "$merge_file" -t "$title")" \
          || audio_path=""
        rm -f "$merge_file"
      else
        audio_path="$(printf '%s' "$spoken" \
          | "$scripts_root/hooks/note-on-turn/audio-note-to-file" -w)" || audio_path=""
      fi
    fi
    if [ -n "$webview_wanted" ]; then
      if [ -n "$audio_path" ] && [ -f "$audio_path" ]; then
        printf '%s' "$wv_payload" \
          | "$scripts_root/hooks/note-on-turn/webview-note" -a "$audio_path"
      else
        printf '%s' "$wv_payload" | "$scripts_root/hooks/note-on-turn/webview-note"
      fi
    fi
  } &
fi
mark fork

# Text the summary to Rio's phone when the text toggle is on.
#
# Last, and detached. It used to run first and in the foreground — a leftover
# from when the phone was the only surface, kept by nobody's decision. That cost
# every turn a second of `shortcuts run` before the audio synth and the page
# were even started, and worse: under `set -e` a flaky Shortcuts run aborted the
# script right there, so a failed text silently took the audio and the web view
# with it. A background job's failure cannot do that.
AGENT_TEXT="${AGENT_TEXT:-on}"
case "$AGENT_TEXT" in
  on|1|true|yes)
    { printf '%s' "$summary" \
        | "$scripts_root/sc" text-phone >/dev/null 2>>"$log_dir/summarize.err" \
        || printf '%s\ttext-phone failed\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$log_dir/summarize.err"
      mark text-phone; } &
    ;;
esac

"$HOME/dev/agent-sessions/bin/index-session" >>"$log_dir/index-session.log" 2>&1 &
