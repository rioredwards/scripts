#!/bin/sh
# stdin: sidecar-shaped JSON ({structured, summary, repo_name, agent,
# created_at}). Renders the turn's summary page and pops it in the Hammerspoon
# web view window.
#
# The page is rendered by render-summary-html.mjs, the same module the Raycast
# audio player uses — an auto-popped page and a page opened from Raycast are
# produced by identical code, so the two surfaces cannot drift.
#
#   -a FILE   the turn's audio clip. The page gets a player for it; without it
#             the page is transcript-only, with no dead transport.
#
# The player exists because the caller now waits for the synth before invoking
# this. It used to fire alongside the synth and reach the screen ~25s early, so
# binding the two would have meant either blocking the turn on TTS or popping
# the window twice; the chain in note-from-reply removed that constraint.
#
# Overwrites one stable path per machine rather than accumulating a file per
# turn — nothing here is worth keeping, and the web view reloads from disk.
#
# Set AGENT_WEBVIEW_HOST to an ssh alias to display the page on a different mac
# than the one that generated it (see the remote block below).
set -eu

audio_src=""
while getopts ":a:" opt; do
  case "$opt" in
    a) audio_src="$OPTARG" ;;
    *) : ;;
  esac
done
shift $((OPTIND - 1))

renderer="${AGENT_WEBVIEW_RENDERER:-$HOME/dev/rio-raycast-toolbox/scripts/render-summary-html.mjs}"
out_dir="${AGENT_WEBVIEW_DIR:-$HOME/.cache/agent-webview}"
out="$out_dir/turn.html"

log_dir="$HOME/.cache/note-on-turn"
mkdir -p "$log_dir"
log="$log_dir/webview-note.log"
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Perf marker on the caller's timeline (PERF_T0/PERF_RUN exported by
# note-from-reply); standalone runs just time themselves from now.
mark() { printf '%s +%ss %s\n' "${PERF_RUN:-$$}" "$(( $(date +%s) - ${PERF_T0:-$(date +%s)} ))" "$1" >>"${PERF_LOG:-$log_dir/perf.log}" 2>/dev/null || true; }

if [ ! -f "$renderer" ]; then
  printf '%s renderer missing: %s\n' "$(stamp)" "$renderer" >>"$log"
  exit 1
fi

# node lives under nvm on the MacBook, so a bare `node` resolves from a terminal
# and disappears the moment this runs with a bare PATH (launchd, cron, an agent
# started outside a login shell). Resolve it here so the failure names itself
# instead of surfacing as an opaque "command not found" in the log.
node_bin="${AGENT_WEBVIEW_NODE:-$(command -v node 2>/dev/null || true)}"
if [ -z "$node_bin" ]; then
  # Newest nvm install first, then the usual Homebrew prefixes.
  node_bin="$(ls -1d "$HOME/.nvm/versions/node"/*/bin/node 2>/dev/null | sort -V | tail -1)"
  if [ -z "$node_bin" ]; then
    for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
      [ -x "$candidate" ] && node_bin="$candidate" && break
    done
  fi
fi
if [ -z "$node_bin" ] || [ ! -x "$node_bin" ]; then
  printf '%s node not found (PATH=%s) — set AGENT_WEBVIEW_NODE\n' "$(stamp)" "${PATH:-}" >>"$log"
  exit 1
fi

payload="$(cat)"
[ -n "$payload" ] || exit 0

# The narration path derives a title from the prose; without one (legacy
# structured payloads, or a title step that failed) the page keeps its old
# generic heading.
title="$(printf '%s' "$payload" | jq -r '.title // "" | select(length > 0)' 2>/dev/null || true)"
[ -n "$title" ] || title="Agent reply"

# The clip has to sit NEXT TO the page: it is referenced relatively, and
# WKWebView will not read a sibling outside the page's own directory. A copy,
# not a symlink — the source lives in iCloud and can be evicted, at which point
# a link resolves to nothing and the player is silently dead.
#
# Last turn's clip is cleared either way, so a transcript-only page never leaves
# a stale mp3 behind for the next one to find.
mkdir -p "$out_dir"
rm -f "$out_dir/turn.mp3" "$out_dir/turn.aiff" 2>/dev/null || true
audio_name=""
if [ -n "$audio_src" ]; then
  if [ -f "$audio_src" ]; then
    audio_name="turn.${audio_src##*.}"
    cp -f "$audio_src" "$out_dir/$audio_name" 2>>"$log" || audio_name=""
  else
    printf '%s audio missing, page will be transcript-only: %s\n' "$(stamp)" "$audio_src" >>"$log"
  fi
fi

set -- --out "$out" --title "$title"
[ -n "$audio_name" ] && set -- "$@" --audio "$audio_name"
if ! printf '%s' "$payload" | "$node_bin" "$renderer" "$@" >/dev/null 2>>"$log"; then
  printf '%s render failed -> %s\n' "$(stamp)" "$out" >>"$log"
  exit 1
fi
mark html-rendered

# Ship the page to another mac instead of opening it here, when one is named.
#
# The case this exists for: sitting at the MacBook, ssh'd into the mini, agents
# running on the mini. The hook fires on the machine doing the work, which is
# not the machine with a screen in front of it — so the window pops where nobody
# can see it. AGENT_WEBVIEW_HOST is an ssh alias (`macbook`), set machine-locally
# on the box that generates, never in the synced profile.
#
# One connection does all three steps: make the dir, stream the files in over
# stdin, fire the deeplink. The page is self-contained (CSS and JS inline, no
# images), so page plus clip is the whole transfer — tar rather than plain `cat`
# because the player needs the mp3 to land beside the page, not instead of it.
remote_host="${AGENT_WEBVIEW_HOST:-}"
if [ -n "$remote_host" ]; then
  set -- "$(basename "$out")"
  [ -n "$audio_name" ] && set -- "$@" "$audio_name"
  # BatchMode so a missing key fails instead of blocking the turn on a password
  # prompt forever; ServerAlive so a connection that dies mid-transfer gives up
  # rather than hanging. A closed laptop is the expected case, not an error —
  # log it and exit 0 so a sleeping MacBook never marks the turn as failed.
  if tar -cf - -C "$out_dir" "$@" \
     | ssh -o BatchMode=yes -o ConnectTimeout=5 \
         -o ServerAliveInterval=3 -o ServerAliveCountMax=2 \
         "$remote_host" \
         'mkdir -p ~/.cache/agent-webview \
          && rm -f ~/.cache/agent-webview/turn.mp3 ~/.cache/agent-webview/turn.aiff \
          && tar -xf - -C ~/.cache/agent-webview \
          && open -g "hammerspoon://agent-audio-webview?file=$HOME/.cache/agent-webview/turn.html"' \
         >/dev/null 2>>"$log"
  then
    mark html-shown
    exit 0
  fi
  printf '%s remote display skipped: %s unreachable or Hammerspoon down\n' \
    "$(stamp)" "$remote_host" >>"$log"
  mark html-remote-failed
  exit 0
fi

# Hammerspoon's WKWebView, not the browser: it renders the page without stealing
# a browser tab, and unlike Quick Look's HTML sandbox it runs the page's JS.
if ! open -g "hammerspoon://agent-audio-webview?file=$out" >/dev/null 2>>"$log"; then
  printf '%s deeplink failed (Hammerspoon running?): %s\n' "$(stamp)" "$out" >>"$log"
  exit 1
fi
mark html-shown
