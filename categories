#!/usr/bin/env python3
"""categories: Rio's work categories, one registry (~/.agents/categories.json) synced to its copies.

  categories pull     Asana Category options -> registry (new, renamed, disabled, removed). Never writes Asana.
  categories render   rewrite the Work categories section of ~/.agents/VOCABULARY.md and the agent-sessions
                      tag catalog (~/dev/agent-sessions/data/session-tags.json) from the registry.
  categories labels [--apply]
                      plan (or make) missing `scope:<area slug>` GitHub labels for the Straightaway (Asana)
                      areas in the registry's top-level `label_repos`. Creates only: existing labels keep their description
                      and color; never edits, deletes, or renames.
  categories check    no writes; exit 1 with one line per drift.

Areas nest under their category (`categories[].areas`). Straightaway areas come from the Asana Category
field; edit them there, then pull. Pull puts a new Asana option in top-level `unplaced` until you move it
under a category; unplaced areas get no session tags or labels. Everything else: edit the registry, then
render. Token: `keyfor ASANA_PAT`, never printed. Plan: rioredwards/scripts#40.
"""
import copy, functools, json, os, re, subprocess, sys, urllib.error, urllib.request

API = "https://app.asana.com/api/1.0"
REGISTRY = os.path.expanduser("~/.agents/categories.json")
VOCAB = os.path.expanduser("~/.agents/VOCABULARY.md")
BEGIN = "<!-- categories:begin (generated: edit ~/.agents/categories.json, run `categories render`) -->"
END = "<!-- categories:end -->"
CATALOG = os.path.expanduser("~/dev/agent-sessions/data/session-tags.json")
LABEL_COLOR = "5319E7"  # straightaway-next's main scope color


def die(msg):
    raise SystemExit("categories: " + msg)


@functools.cache
def token():
    r = subprocess.run(["keyfor", "ASANA_PAT"], capture_output=True, text=True)
    if r.returncode or not r.stdout.strip():
        die("no ASANA_PAT: set one with `keyfor --set ASANA_PAT`")
    return r.stdout.strip()


def send(url):
    """One Asana GET -> parsed JSON. Tests replace this."""
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token()})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.load(resp)
    except urllib.error.URLError as e:
        why = "HTTP %s: %s" % (e.code, e.read().decode(errors="replace")[:400]) if hasattr(e, "code") else e.reason
        die("GET %s -> %s" % (url.split("?")[0], why))


def asana_options(reg):
    field = reg["asana"]["category_field"]
    data = send("%s/custom_fields/%s?opt_fields=enum_options.name,enum_options.enabled" % (API, field))["data"]
    return [{"gid": o["gid"], "name": o["name"], "enabled": o.get("enabled", True)} for o in data["enum_options"]]


def load():
    try:
        with open(REGISTRY) as f:
            reg = json.load(f)
    except FileNotFoundError:
        die("no registry at %s" % REGISTRY)
    except json.JSONDecodeError as e:
        die("bad JSON in %s: %s" % (REGISTRY, e))
    if "areas" in reg:
        die("%s has a top-level 'areas' list: areas nest under categories[].areas (or `unplaced`)" % REGISTRY)
    for key in ("asana", "categories", "unplaced"):
        if key not in reg:
            die("%s has no %r" % (REGISTRY, key))
    for c in reg["categories"]:
        if "areas" not in c:
            die("category %r in %s has no 'areas' list" % (c["slug"], REGISTRY))
    for kind, items in (("category", reg["categories"]), ("area", all_areas(reg))):
        slugs = [x["slug"] for x in items]
        dupes = sorted({s for s in slugs if slugs.count(s) > 1})
        if dupes:
            die("duplicate %s slug(s) in %s: %s" % (kind, REGISTRY, ", ".join(dupes)))
    ids = [t["id"] for t in catalog_tags(reg)]
    dupes = sorted({i for i in ids if ids.count(i) > 1})
    if dupes:
        die("duplicate session tag id(s) in %s: %s" % (REGISTRY, ", ".join(dupes)))
    return reg


def placed_areas(reg):
    return [a for c in reg["categories"] for a in c["areas"]]


def all_areas(reg):
    return placed_areas(reg) + reg["unplaced"]


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def sync(reg, options):
    """Apply Asana options to a copy of reg. Returns (new_reg, change lines)."""
    reg = copy.deepcopy(reg)
    by_gid = {a["asana_gid"]: a for a in all_areas(reg) if a.get("asana_gid")}
    taken = {a["slug"] for a in all_areas(reg)}
    changes = []
    for o in options:
        area = by_gid.get(o["gid"])
        if area is None:
            slug = slugify(o["name"])
            while slug in taken:
                slug += "-new"
            taken.add(slug)
            reg["unplaced"].append({"name": o["name"], "slug": slug, "asana_gid": o["gid"], "definition": ""})
            changes.append("new Asana option %r (gid %s): added to unplaced; move it under a category and "
                           "write its definition in %s" % (o["name"], o["gid"], REGISTRY))
            continue
        if area["name"] != o["name"]:
            changes.append("Asana option renamed %r -> %r (gid %s)" % (area["name"], o["name"], o["gid"]))
            area["name"] = o["name"]
        state = None if o["enabled"] else "disabled"
        if area.get("asana_state") != state:
            changes.append("area %r is %s in Asana" % (area["name"], state or "enabled again"))
            if state:
                area["asana_state"] = state
            else:
                del area["asana_state"]
    live = {o["gid"] for o in options}
    for gid, area in by_gid.items():
        if gid not in live and area.get("asana_state") != "removed":
            changes.append("area %r (gid %s) was removed from Asana" % (area["name"], gid))
            area["asana_state"] = "removed"
    return reg, changes


def tagged_areas(reg):
    """Active placed areas that get scope labels and session tags. `other` is the no-match bucket, never a tag."""
    return [a for a in placed_areas(reg) if not a.get("asana_state") and a["slug"] != "other"]


def catalog_tags(reg):
    """Session-tag catalog entries: an area's own `session_tags`, else one built from the area itself."""
    out = []
    for a in tagged_areas(reg):
        out += a.get("session_tags") or [{"id": a["slug"], "label": a["name"], "definition": a["definition"],
                                          "exclude": ""}]
    return out


def gh(*args):
    """One gh call -> stdout. Tests replace this."""
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode:
        die("gh %s failed: %s" % (" ".join(args[:3]), r.stderr.strip()[:400]))
    return r.stdout


def label_plan(reg):
    """[(repo, "create" | "keep", name, description)] for every repo in `label_repos`.

    Only a missing label is planned; its description is the area name. Existing labels are left alone
    (their description and color may carry more detail than the Asana name)."""
    want = {"scope:" + a["slug"]: a["name"] for a in tagged_areas(reg) if a.get("asana_gid")}
    plan = []
    for repo in reg["label_repos"]:
        have = {l["name"] for l in json.loads(gh("label", "list", "--repo", repo, "--limit", "1000",
                                                  "--json", "name"))}
        plan += [(repo, "create", name, desc) for name, desc in want.items() if name not in have]
        plan += [(repo, "keep", n, None) for n in sorted(have) if n.startswith("scope:") and n not in want]
    return plan


def problems(reg):
    return ["area %r is unplaced: place it under a category in %s" % (a["name"], REGISTRY) for a in reg["unplaced"]]


def section(reg):
    lines = [BEGIN]
    for c in reg["categories"]:
        areas = [a["name"] for a in c["areas"] if not a.get("asana_state")]
        line = "- **%s:** %s" % (c["name"], c["definition"])
        if areas:
            line += " Areas: %s." % ", ".join(areas)
        lines.append(line)
    lines.append(END)
    return "\n".join(lines)


def rendered(reg, text):
    start, end = text.find(BEGIN), text.find(END)
    if start < 0 or end < start:
        die("%s lacks the categories marker comments; add %s and %s around the Work categories list"
            % (VOCAB, BEGIN, END))
    return text[:start] + section(reg) + text[end + len(END):]


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        die("cannot read %s: %s" % (path, e))


def write_json(path, value):
    path = os.path.realpath(path)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def read_vocab():
    with open(VOCAB) as f:
        return f.read()


def cmd_pull():
    reg = load()
    new, changes = sync(reg, asana_options(reg))
    if new != reg:
        write_json(REGISTRY, new)
    for line in changes or ["registry already matches Asana"]:
        print(line)
    for line in problems(new):
        print(line)
    return 0


def cmd_render():
    reg = load()
    text = read_vocab()
    out = rendered(reg, text)
    if out != text:
        with open(VOCAB, "w") as f:
            f.write(out)
        print("rendered %s" % VOCAB)
    else:
        print("%s already current" % VOCAB)
    catalog = read_json(CATALOG)
    tags = catalog_tags(reg)
    if catalog["tags"] != tags:
        major, minor, _ = catalog["version"].split(".")
        catalog["version"] = "%s.%d.0" % (major, int(minor) + 1)  # catalog_hash changes anyway; version is for humans
        catalog["tags"] = tags
        write_json(CATALOG, catalog)
        print("rendered %s (version %s)" % (CATALOG, catalog["version"]))
    else:
        print("%s already current" % CATALOG)
    return 0


def cmd_labels(apply):
    for repo, action, name, desc in label_plan(load()):
        if action == "create":
            print("%s: create %s (%s, #%s)" % (repo, name, desc, LABEL_COLOR))
            if apply:
                gh("label", "create", name, "--repo", repo, "--color", LABEL_COLOR, "--description", desc)
        else:
            print("%s: %s kept, not in registry" % (repo, name))
    if not apply:
        print("dry run: `categories labels --apply` makes these changes")
    return 0


def cmd_check():
    reg = load()
    drift = ["asana: %s (run `categories pull`)" % c for c in sync(reg, asana_options(reg))[1]]
    drift += problems(reg)
    text = read_vocab()
    if rendered(reg, text) != text:
        drift.append("%s Work categories section differs from the registry (run `categories render`)" % VOCAB)
    if read_json(CATALOG)["tags"] != catalog_tags(reg):
        drift.append("%s tags differ from the registry (run `categories render`)" % CATALOG)
    for repo, action, name, _ in label_plan(reg):
        if action == "create":
            drift.append("%s: label %s missing (run `categories labels --apply`)" % (repo, name))
    for line in drift:
        print(line)
    if not drift:
        print("categories: in sync")
    return 1 if drift else 0


def main(argv):
    cmds = {"pull": cmd_pull, "render": cmd_render, "check": cmd_check, "labels": lambda: cmd_labels(False)}
    if argv == ["labels", "--apply"]:
        return cmd_labels(True)
    if len(argv) != 1 or argv[0] not in cmds:
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    return cmds[argv[0]]()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
