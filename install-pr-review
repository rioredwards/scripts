#!/usr/bin/env bash
# install-pr-review — drop Claude auto PR-review workflow into any repo.
#
# Usage: install-pr-review [--model MODEL_ID] [REPO_PATH]
#   --model    Pin a Claude model (e.g. claude-opus-4-8, claude-sonnet-5).
#              Omit to use claude-code-action's default (Sonnet tier).
#   REPO_PATH  Target repo (default: cwd).
#
# Requires: gh (authed), Anthropic key in Keychain (com.rio.api.anthropic).

set -euo pipefail

MODEL=""
REPO_PATH="."
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model) MODEL="${2:?--model needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *) REPO_PATH="$1"; shift ;;
  esac
done

cd "$REPO_PATH"
git rev-parse --is-inside-work-tree >/dev/null || { echo "ERROR: not a git repo: $PWD" >&2; exit 1; }
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner) \
  || { echo "ERROR: no GitHub remote (gh can't resolve repo)" >&2; exit 1; }

WORKFLOW=".github/workflows/claude-code-review.yml"
[[ -e "$WORKFLOW" ]] && { echo "ERROR: $WORKFLOW already exists in $REPO — remove it first" >&2; exit 1; }

MODEL_LINE=""
[[ -n "$MODEL" ]] && MODEL_LINE="            --model ${MODEL}"$'\n'

mkdir -p .github/workflows
cat > "$WORKFLOW" <<EOF
name: Claude Code Review

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]

concurrency:
  group: claude-review-\${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  claude-review:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write
      actions: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Claude Code Review
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: \${{ secrets.ANTHROPIC_API_KEY }}
          github_token: \${{ secrets.GITHUB_TOKEN }}
          prompt: |
            REPO: \${{ github.repository }}
            PR NUMBER: \${{ github.event.pull_request.number }}

            You are an expert code reviewer. Be terse and direct — no praise,
            no filler. Only comment on things that matter.

            Process:
            1. Run \`gh pr view\` to understand the PR's intent.
            2. Run \`gh pr diff\` to read the full diff.
            3. If CLAUDE.md or README.md exists in the repo root, read
               it and enforce its conventions.
            4. Before reporting any finding, open the surrounding source files
               and verify it against the actual code — never judge from the
               diff hunk alone. Context outside the hunk often resolves what
               looks like a bug.

            Review priorities (highest first):
            1. Bugs and logic errors — code that won't do what it's meant to
            2. Security — injection, secrets committed, unsafe input handling,
               overly broad permissions
            3. Silent failure — swallowed errors, catch-and-continue,
               fallbacks that hide problems (prefer fail fast and loud)
            4. Portability — hardcoded absolute paths or usernames; require
               \$HOME/~ or relative paths
            5. Dead code, unused files, needless complexity

            Rules:
            - Report only issues you are confident about after verification.
              A false positive costs more than a miss.
            - Max 10 inline comments — keep the most severe, fold the rest
              into the summary.
            - No style/formatting nits unless they change meaning. Never
              restate what the code does.

            Output:
            - Inline comments via mcp__github_inline_comment__create_inline_comment,
              severity-tagged: 🚨 blocker, ⚠️ should fix, 💡 optional.
            - Finish with ONE summary comment: first line is the verdict
              (✅ approve / ❌ needs changes), then one line per finding.
            - If nothing is wrong, the summary is exactly "✅ LGTM" — no
              inline comments, no invented nitpicks.
          claude_args: |
${MODEL_LINE}            --allowed-tools "mcp__github_inline_comment__create_inline_comment,Bash(gh pr comment:*),Bash(gh pr diff:*),Bash(gh pr view:*),Bash(gh issue view:*)"
EOF

security find-generic-password -s com.rio.api.anthropic -w \
  | gh secret set ANTHROPIC_API_KEY --repo "$REPO" \
  || { echo "ERROR: failed to set ANTHROPIC_API_KEY secret" >&2; exit 1; }

echo "Installed $WORKFLOW in $REPO (model: ${MODEL:-action default})"
echo "Next: commit + push, then open a PR to test:"
echo "  git add $WORKFLOW && git commit -m 'ci: add Claude PR review' && git push"
