#!/usr/bin/env bash
#
# dev-ls: list the dev servers running on THIS Mac, with a health light and a
# link Rio can click from any device. Wraps `portless list` (which owns the
# routes) and adds the parts that make it readable: repo name, which worktree
# or branch it is, how long it has been up, and whether it still answers.
#
#   dev-ls              # everything
#   dev-ls straightaway # only rows matching a repo / branch / route name
#   dev-ls --json       # same rows as JSON, for tools (Raycast) not humans
#
# Health: 💚 answering · 💛 answering oddly (4xx or slow) · ❤️ not answering
#         (a 502 means portless is up but the server behind it died).
#
# --json never treats "nothing running" as an error: it prints [] and exits 0,
# because an empty list is a normal state for a caller, not a failure.
set -uo pipefail

ROUTES="$HOME/.portless/routes.json"

JSON=0
FILTER=""
for arg in "$@"; do
  case "$arg" in
    --json) JSON=1 ;;
    -h|--help) sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "dev-ls: unknown option $arg" >&2; exit 2 ;;
    *) FILTER="$arg" ;;
  esac
done

die_empty() {
  if [ "$JSON" = 1 ]; then echo "[]"; exit 0; fi
  echo "dev-ls: $1" >&2
  exit 1
}

[ -r "$ROUTES" ] || die_empty "no portless routes at $ROUTES. Nothing running? Start one with: dev-up"

# --- helpers ---------------------------------------------------------------

# "3-04:05:06" | "04:05:06" | "05:06" -> seconds
etime_secs() {
  local e="$1" d=0 h=0 m=0 s=0
  case "$e" in *-*) d="${e%%-*}"; e="${e#*-}";; esac
  case "$e" in
    *:*:*) h="${e%%:*}"; e="${e#*:}"; m="${e%%:*}"; s="${e#*:}";;
    *:*)   m="${e%%:*}"; s="${e#*:}";;
  esac
  echo $(( 10#$d*86400 + 10#$h*3600 + 10#$m*60 + 10#$s ))
}

humanize() {
  local t="$1"
  [ "$t" -lt 0 ] && { echo "gone"; return; }
  if   [ "$t" -lt 3600 ];  then echo "$((t/60))m"
  elif [ "$t" -lt 86400 ]; then echo "$((t/3600))h $(((t%3600)/60))m"
  else echo "$((t/86400))d $(((t%86400)/3600))h"
  fi
}

slug() { printf '%s' "$1" | tr '[:upper:]_' '[:lower:]-' | tr -cs 'a-z0-9-' '-' | sed 's/^-*//;s/-*$//'; }

# --- gather ----------------------------------------------------------------

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

jq -r '.[] | [.pid, .hostname, .tailscaleUrl] | @tsv' "$ROUTES" > "$TMP/routes"
[ -s "$TMP/routes" ] || die_empty "no dev servers running. Start one with: dev-up"

# One lsof for every pid at once; cwd lookups are the slow part.
PIDS="$(cut -f1 "$TMP/routes" | paste -sd, -)"
lsof -a -d cwd -p "$PIDS" -Fpn 2>/dev/null | awk '
  /^p/ { pid = substr($0,2) }
  /^n/ { print pid "\t" substr($0,2) }
' > "$TMP/cwds"

# Health checks run in parallel; a dead server should not stall the list.
while IFS=$'\t' read -r pid host url; do
  ( curl -sk -o /dev/null -w '%{http_code} %{time_total}' --max-time 4 "$url" 2>/dev/null > "$TMP/h.$pid" \
      || printf '000 0' > "$TMP/h.$pid" ) &
done < "$TMP/routes"
wait

# --- build rows ------------------------------------------------------------
# One TSV row per server, raw values only. Both renderers below read this file,
# so the human list and the JSON can never drift apart.
# columns: rank health uptimeSecs repo branch name url httpCode pid cwd

: > "$TMP/rows"
while IFS=$'\t' read -r pid host url; do
  cwd="$(awk -F'\t' -v p="$pid" '$1==p {print $2; exit}' "$TMP/cwds")"

  if [ -n "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
    common="$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)"
    repo="$(basename "$(dirname "$common")")"
    branch="$(git -C "$cwd" branch --show-current)"
  else
    repo="$(basename "${cwd:-$host}")"
    branch=""
  fi

  # The route's first label. If portless derived it from the directory it tells
  # Rio nothing new, so prefer the branch. An explicit --name (e2e-ui) wins.
  label="${host%%.*}"
  if [ "$label" = "$(slug "$repo")" ] || [ "$label" = "$(slug "$(basename "${cwd:-$host}")")" ]; then
    variant="${branch#*/}"
    [ -n "$variant" ] || variant="$label"
  else
    variant="$label"
  fi

  etime="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
  if [ -n "$etime" ]; then secs_up="$(etime_secs "$etime")"; else secs_up=-1; fi

  read -r code latency < "$TMP/h.$pid"
  case "$code" in
    2??|3??) if awk "BEGIN{exit !($latency > 2)}"; then health="yellow"; rank=1; else health="green"; rank=0; fi ;;
    4??)     health="yellow"; rank=1 ;;
    *)       health="red";    rank=2 ;;
  esac

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rank" "$health" "$secs_up" "$repo" "$branch" "$repo:$variant" "$url" "$code" "$pid" "$cwd" \
    >> "$TMP/rows"
done < "$TMP/routes"

if [ -n "$FILTER" ]; then
  grep -i -- "$FILTER" "$TMP/rows" > "$TMP/f" || true
  mv "$TMP/f" "$TMP/rows"
fi

sort -t$'\t' -k1,1n -k6,6 -o "$TMP/rows" "$TMP/rows"

# --- render ----------------------------------------------------------------

if [ "$JSON" = 1 ]; then
  jq -R -s -c 'split("\n") | map(select(length > 0) | split("\t") | {
    health:     .[1],
    uptimeSecs: (.[2] | tonumber),
    repo:       .[3],
    branch:     .[4],
    name:       .[5],
    url:        .[6],
    httpCode:   .[7],
    pid:        (.[8] | tonumber),
    cwd:        .[9]
  })' "$TMP/rows"
  exit 0
fi

[ -s "$TMP/rows" ] || die_empty "nothing running${FILTER:+ matching \"$FILTER\"}. Start one with: dev-up"

rule="$(printf '%*s' 52 '' | tr ' ' '_')"
echo "$rule"
echo
while IFS=$'\t' read -r rank health secs_up repo branch name url code pid cwd; do
  case "$health" in green) light="💚" ;; yellow) light="💛" ;; *) light="❤️" ;; esac
  note=""
  [ "$rank" = 2 ] && note="  (not answering: $code)"
  printf '%s %s%s\n' "$light" "$(humanize "$secs_up")" "$note"
  printf '%s\n' "$name"
  printf '%s\n\n' "$url"
done < "$TMP/rows"
echo "$rule"
