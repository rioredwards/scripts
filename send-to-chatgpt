#!/usr/bin/env bash
set -euo pipefail

CHATGPT_APP="${CHATGPT_APP:-ChatGPT}"
POLL_INTERVAL="${POLL_INTERVAL:-2}"
POLL_TIMEOUT="${POLL_TIMEOUT:-120}"
STABLE_POLLS="${STABLE_POLLS:-2}"
VERBOSE="${VERBOSE:-0}"
AUTOMATION_CUE="${AUTOMATION_CUE:-1}"
AUTOMATION_CUE_SCRIPT="${AUTOMATION_CUE_SCRIPT:-$HOME/scripts/automation-cue.sh}"

cue_shown=0

cue_start() {
  [[ "$AUTOMATION_CUE" == "1" ]] || return 0
  [[ -x "$AUTOMATION_CUE_SCRIPT" ]] || return 0
  log "showing automation cue"
  "$AUTOMATION_CUE_SCRIPT" start || true
  cue_shown=1
}

cue_stop() {
  [[ "$cue_shown" == "1" ]] || return 0
  log "hiding automation cue"
  "$AUTOMATION_CUE_SCRIPT" stop || true
  cue_shown=0
}

die() {
  echo "send-to-chatgpt: $*" >&2
  exit 1
}

log() {
  if [[ "$VERBOSE" == "1" ]]; then
    echo "send-to-chatgpt: $*" >&2
  fi
}

require_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
  done
}

ensure_daemon() {
  # daemon status exits 0 regardless of actual state, so check its text output
  peekaboo daemon status 2>/dev/null | grep -q "Status: not running" || return 0
  log "peekaboo daemon not running, starting it"
  # daemon start re-execs itself; a bare PATH lookup fails with
  # 'Error: The file "peekaboo" doesn't exist', so use the absolute path
  local peekaboo_bin
  peekaboo_bin="$(command -v peekaboo)"
  "$peekaboo_bin" daemon start >/dev/null 2>&1 || die "failed to start peekaboo daemon"
}

check_permissions() {
  local json missing
  json="$(peekaboo permissions --json 2>/dev/null)" || die "failed to check peekaboo permissions"
  missing="$(echo "$json" | jq -r '.data.permissions[] | select(.isRequired and (.isGranted | not)) | .name')"
  if [[ -n "$missing" ]]; then
    die "missing peekaboo permissions:${missing//$'\n'/', '} (run: peekaboo permissions)"
  fi
}

peekaboo_quiet() {
  if [[ "$VERBOSE" == "1" ]]; then
    peekaboo "$@"
  else
    peekaboo "$@" >/dev/null 2>&1
  fi
}

see_chatgpt() {
  if [[ "$VERBOSE" == "1" ]]; then
    peekaboo see --app "$CHATGPT_APP" --json
  else
    peekaboo see --app "$CHATGPT_APP" --json 2>/dev/null
  fi
}

extract_chat_texts() {
  jq -r '.data.ui_elements[]? | select(.label == "text") | .description // empty'
}

extract_input_id() {
  jq -r '
    [
      .data.ui_elements[]?
      | select(.label == "text entry area" or .role_description == "text entry area")
      | .id
    ] | first // empty
  '
}

is_skippable_text() {
  local text="$1"
  [[ "$text" == "$MESSAGE" ]] && return 0
  [[ "$text" =~ ^Thought\ for ]] && return 0
  [[ "$text" =~ ^Thinking ]] && return 0
  return 1
}

is_generating() {
  local see_json="$1"
  echo "$see_json" | jq -e '
    .data.ui_elements[]?
    | select(.label == "Stop" or .label == "Stop generating")
  ' >/dev/null 2>&1
}

collect_response_text() {
  local see_json="$1"
  local baseline_file="$2"
  local text
  local -a parts=()

  while IFS= read -r text; do
    [[ -z "$text" ]] && continue
    is_skippable_text "$text" && continue
    if ! grep -Fxq -- "$text" "$baseline_file" 2>/dev/null; then
      parts+=("$text")
    fi
  done < <(echo "$see_json" | extract_chat_texts)

  if ((${#parts[@]} == 0)); then
    return 0
  fi

  local part
  local first=1
  for part in "${parts[@]}"; do
    if ((first)); then
      printf '%s' "$part"
      first=0
    else
      printf '\n%s' "$part"
    fi
  done
}

usage() {
  die 'Usage: send-to-chatgpt "your message"        (or pipe message on stdin)
       send-to-chatgpt --paste ["extra text"]  # send clipboard as-is (supports images), optionally followed by text
       send-to-chatgpt --double-paste          # send clipboard item 1, then Raycast item 2'
}

PASTE_MODE=""  # "" = text, "paste" = clipboard, "double-paste" = clipboard + raycast 2nd
MESSAGE=""

if [[ "${1:-}" == "--paste" ]]; then
  PASTE_MODE="paste"
  shift
  MESSAGE="$*"
elif [[ "${1:-}" == "--double-paste" ]]; then
  PASTE_MODE="double-paste"
  shift
fi

if [[ -z "$PASTE_MODE" ]]; then
  if [[ $# -gt 0 ]]; then
    MESSAGE="$*"
  elif [[ ! -t 0 ]]; then
    MESSAGE="$(cat)"
  else
    usage
  fi
  MESSAGE="${MESSAGE#"${MESSAGE%%[![:space:]]*}"}"
  MESSAGE="${MESSAGE%"${MESSAGE##*[![:space:]]}"}"
  [[ -n "$MESSAGE" ]] || die "message is empty"
fi

require_cmd peekaboo jq
ensure_daemon
check_permissions

baseline_file="$(mktemp)"
trap 'rm -f "$baseline_file"; cue_stop' EXIT

cue_start

log "capturing baseline UI state"
initial_see="$(see_chatgpt)"
echo "$initial_see" | extract_chat_texts >"$baseline_file"

INPUT_ID="$(echo "$initial_see" | extract_input_id)"

log "launching $CHATGPT_APP"
peekaboo_quiet app launch "$CHATGPT_APP"

if [[ -n "$INPUT_ID" ]]; then
  log "focusing input field ($INPUT_ID)"
  peekaboo_quiet click --on "$INPUT_ID" --app "$CHATGPT_APP" --foreground --wait-for 8000
else
  log "textField not found; falling back to query click"
  peekaboo_quiet click "text entry area" --app "$CHATGPT_APP" --foreground --wait-for 8000 || true
fi

if [[ "$PASTE_MODE" == "paste" ]]; then
  log "pasting clipboard (cmd+v)"
  peekaboo_quiet hotkey "cmd,v" --app "$CHATGPT_APP" --foreground
  if [[ -n "$MESSAGE" ]]; then
    log "typing extra text after image"
    sleep 0.3
    peekaboo_quiet paste "$MESSAGE" --app "$CHATGPT_APP" --foreground
  fi
elif [[ "$PASTE_MODE" == "double-paste" ]]; then
  log "pasting 1st clipboard item (cmd+v)"
  peekaboo_quiet hotkey "cmd,v" --app "$CHATGPT_APP" --foreground
  sleep 0.3
  log "opening Raycast clipboard (cmd+shift+v)"
  peekaboo_quiet hotkey "cmd,shift,v" --foreground
  sleep 1.0
  log "selecting 2nd item and pasting"
  peekaboo_quiet press down --foreground
  sleep 0.3
  peekaboo_quiet press return --foreground
else
  log "pasting message"
  peekaboo_quiet paste "$MESSAGE" --app "$CHATGPT_APP" --foreground
fi

peekaboo_quiet press return --app "$CHATGPT_APP" --foreground

log "waiting for response (timeout ${POLL_TIMEOUT}s, interval ${POLL_INTERVAL}s, stable polls ${STABLE_POLLS})"
elapsed=0
last_response=""
stable_count=0

while ((elapsed < POLL_TIMEOUT)); do
  sleep "$POLL_INTERVAL"
  elapsed=$((elapsed + POLL_INTERVAL))

  current_see="$(see_chatgpt)"
  response="$(collect_response_text "$current_see" "$baseline_file")"
  response_len=${#response}

  if is_generating "$current_see"; then
    log "poll: len=${response_len} stable=${stable_count} (still generating)"
    stable_count=0
    last_response="$response"
    continue
  fi

  if [[ -n "$response" && "$response" == "$last_response" ]]; then
    stable_count=$((stable_count + 1))
    log "poll: len=${response_len} stable=${stable_count}"
    if ((stable_count >= STABLE_POLLS)); then
      printf '%s\n' "$response"
      exit 0
    fi
  else
    stable_count=0
    last_response="$response"
    log "poll: len=${response_len} stable=${stable_count} (changed)"
  fi
done

if [[ -n "$last_response" ]]; then
  log "timed out with partial response (${#last_response} chars); returning best effort"
  printf '%s\n' "$last_response"
  exit 0
fi

die "timed out after ${POLL_TIMEOUT}s waiting for ChatGPT response"
