#!/bin/sh
# structured-to-text — flatten a structured summary into plain text.
#
# stdin:  the JSON object emitted by the aitt `summarize-structured*` presets:
#           {"headline": "...", "sections": [{kind, severity, title, body}, ...]}
#         Code fences are tolerated; some models add them despite the prompt.
# stdout: plain text.
#
#   --tts   strip emoji and terminate each title with a period, so a
#           text-to-speech engine reads the label as a sentence instead of
#           running it into the body.
#
# One rendering, two consumers: the phone text and the spoken audio say exactly
# what the web view shows, in the same order (severity "action" first, matching
# the page's sort). The `spoken` field this replaces was a separate narration
# that could — and did — drift away from the sections beside it.
#
# Fails loud. A malformed summary exits non-zero with a reason on stderr rather
# than emitting partial text, because the callers (note-from-reply,
# content-pipeline) would otherwise text and narrate a half-summary.
set -eu

tts=0
for arg in "$@"; do
  case "$arg" in
    --tts) tts=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "structured-to-text: unknown option '$arg'" >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "structured-to-text: jq not found" >&2; exit 2; }

raw="$(cat)"
[ -n "$raw" ] || { echo "structured-to-text: empty input" >&2; exit 3; }

# Strip a leading ```json / trailing ``` fence line if the model added one.
json="$(printf '%s\n' "$raw" | sed -e 's/^[[:space:]]*```[a-zA-Z]*[[:space:]]*$//')"

printf '%s' "$json" | jq -e 'type == "object" and (.headline | type) == "string" and (.headline | length) > 0' >/dev/null 2>&1 || {
  echo "structured-to-text: input is not a structured summary (need an object with a non-empty .headline)" >&2
  exit 3
}

# Severity order matches audio-html.ts so the spoken order matches the page.
text="$(printf '%s' "$json" | jq -r --argjson tts "$tts" '
  def rank: {"action":0, "warn":1, "info":2}[.severity // "info"] // 2;
  def clean: gsub("[[:space:]]+$"; "") | gsub("^[[:space:]]+"; "");
  [ (.headline | clean) ]
  + ( [ (.sections // [])[]
        | select(((.title // "") | clean) != "" or ((.body // "") | clean) != "") ]
      | to_entries
      | sort_by([(.value | rank), .key])
      | map(.value)
      | map(
          (.title // "" | clean) as $t
          | (.body // "" | clean) as $b
          | ( if $tts == 1 and ($t != "") and ($t | test("[.!?]$") | not)
              then $t + "."
              else $t end ) as $t2
          | [ $t2, $b ] | map(select(. != "")) | join("\n")
        )
    )
  | map(select(. != ""))
  | join("\n\n")
')"

[ -n "$text" ] || { echo "structured-to-text: summary flattened to nothing" >&2; exit 3; }

if [ "$tts" -eq 1 ]; then
  # Emoji, variation selectors, and ZWJ removed: a TTS engine either skips them
  # or reads the name aloud ("warning sign"), and the prompt's emoji set spans
  # several unrelated Unicode blocks, so a closed list would rot. Ranges chosen
  # to miss punctuation the prose legitimately uses (em dash, middot).
  text="$(printf '%s' "$text" | perl -CSD -pe '
    s/[\x{200D}\x{FE00}-\x{FE0F}\x{2190}-\x{21FF}\x{2300}-\x{23FF}\x{25A0}-\x{25FF}\x{2600}-\x{27BF}\x{2B00}-\x{2BFF}\x{1F000}-\x{1FAFF}]//g;
    s/[ \t]{2,}/ /g;
    s/^[ \t]+//;
  ')"
fi

printf '%s\n' "$text"
