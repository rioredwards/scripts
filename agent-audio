#!/bin/sh
# agent-audio — thin alias for `agent-toggle audio`. Kept so existing phone
# Shortcuts (agent-audio on|off|toggle|status) keep working after the toggle CLI
# was generalized. All logic lives in agent-toggle.
set -eu
case "${1:-status}" in
  status|"") exec "$HOME/scripts/agent-toggle" audio ;;
  *)         exec "$HOME/scripts/agent-toggle" audio "$1" ;;
esac
