#!/usr/bin/env python3
"""dev-sweep: remove the git worktrees of one repo that are finished, keep the rest.

  dev-sweep <primary-checkout>           # dry run: one verdict line per worktree
  dev-sweep <primary-checkout> --json    # same verdicts as JSON, for tools
  dev-sweep <primary-checkout> --apply   # actually remove (and push where needed)

Verdicts: remove | push-then-remove | keep: <reasons>. A final totals line says
how many worktrees there are and how many go or stay. The default changes
nothing in any worktree; it only runs `git fetch --all --prune` in the repo so
"is it on GitHub" is judged against current remote refs.

A worktree is removed only when ALL of these hold, and any check that errors or
is unknown keeps it:
  1. not the primary checkout, not locked, not prunable or missing
  2. no modified or untracked files, no rebase/merge/cherry-pick/revert/bisect
     in progress, no stash entry made from its branch
  3. HEAD is contained in a remote branch (after the fetch) or is the head of a
     pull request (one ls-remote of refs/pull/*/head; nothing written locally). If not and HEAD is
     on a named branch, that branch is pushed without force (a rejected push
     keeps it). That push SKIPS client hooks (git push --no-verify), because a
     slow or strict pre-push hook would block a plain backup. So it never pushes
     to a shared branch: the remote's default branch (refs/remotes/<remote>/HEAD;
     unset means unknown, keep), main, master, dev, develop, staging, production
     or release/*, with unpushed commits, is kept. Detached HEAD that is not on
     a remote branch is kept.
  4. idle at least 24 hours: newest of last commit time and the mtimes of its
     git-dir index and HEAD log
  5. no process with its cwd inside it, no pm2 process or live dev lease for it
  6. ignored content only from a short generated-output allowlist (node_modules,
     build and cache dirs, Python caches and .venv, coverage and .testmondata files, test output, .fallow, next-env.d.ts, an empty nested
     .claude/worktrees, symlinked .env files; a wholly ignored directory is
     walked file by file). Regular .env* files do not block:
     on --apply each is first copied to $HOME/Backups/<repo>/worktree-env/
     <hash12>.env (owner only, read back and compared, logged in index.tsv capped
     at 500 lines); a failed copy keeps the tree. Dry run only counts them.

Per-repo opt-in, in the primary checkout's local git config (repo-relative paths, no
globs, repeatable; an absolute path, `..` or empty value exits 2):
  devsweep.generated <dir>   counts as generated when git reports that exact dir as its own ignored entry
  devsweep.preserve <file>   ignored file handled like an env file: symlink ok, regular file backed up first

`git worktree lock` is the keep switch. Removal is unforced `git worktree
remove`: never --force, never unlock, never clean or reset, never delete a
branch. Before each removal --apply re-reads the tree's facts and re-checks
everything. Facts come from `dev-scan worktrees`; this adds the checks it lacks.

If git drops a tree's registration but cannot delete all its files (for example
Finder has the folder open), the tree has already passed every check, so --apply
deletes the leftover folder itself (retrying a few times) and reports `removed`.
Only that exact directory is deleted, never the primary checkout, a registered
path or a symlink. If it still cannot be deleted the verdict is `partial:
unregistered leftover at <dir>: <error>`, counted as "partial N" in the totals,
and the exit code is 3 so the nightly wrapper can raise it.

Exit 0 when the sweep ran (keeps are normal), 3 when any tree ended `partial`. A real failure (not a primary
checkout, fetch fails, dev-scan fails) exits 2 with a message on stderr.

DEV_LEASE_DIR and PM2_HOME are honored like dev-lease does, for tests.
"""

import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import time

MAX_ENV_BYTES = 1024 * 1024
PR_HEADS = set()  # shas of refs/pull/*/head on the remotes, read once per sweep
EXTRA_GENERATED = set()  # devsweep.generated: repo-relative dirs this repo declares as generated
PRESERVE = set()  # devsweep.preserve: repo-relative ignored files handled like env files
IDLE_SECONDS = 24 * 60 * 60
TIMEOUT = 300
EXIT_PARTIAL = 3

# Generated output: any path component with one of these names is rebuildable.
GENERATED_DIRS = {
    "node_modules", ".next", ".turbo", "dist", "build", "out", "coverage",
    ".cache", ".parcel-cache", "__pycache__", ".pytest_cache", ".mypy_cache",
    ".ruff_cache", "test-results", "playwright-report", ".DS_Store", ".fallow", "next-env.d.ts",
    ".venv", ".tox", "htmlcov", ".coverage", ".testmondata", ".testmondata-shm", ".testmondata-wal",
}
INDEX_LINES = 500
GENERATED_SUFFIXES = (".tsbuildinfo", ".pyc")
# Tools that write their own .gitignore (so git also lists their inner paths): everything inside is covered.
SELF_IGNORING = {".ruff_cache", ".pytest_cache", ".mypy_cache", ".venv"}

HERE = os.path.dirname(os.path.realpath(__file__))


def die(message):
    print(f"dev-sweep: {message}", file=sys.stderr)
    sys.exit(2)


class Unknown(Exception):
    """A fact could not be read. The caller keeps the worktree."""


def run(args, cwd=None):
    try:
        # A credential prompt must fail fast, never hang a nightly run.
        env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
        return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT, env=env)
    except (OSError, subprocess.SubprocessError) as error:
        raise Unknown(f"{args[0]} failed: {error}")


def git(path, *args):
    """git stdout. Any failure raises Unknown: no guessing."""
    out = run(["git", "--no-optional-locks", "-C", path, *args])
    if out.returncode:
        raise Unknown(f"git {' '.join(args)} failed in {path}: {out.stderr.strip()}")
    return out.stdout


def load_scan():
    """dev-scan as a module, for its single-tree git_facts used by the re-check."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("dev_scan", os.path.join(HERE, "dev-scan"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def inside(path, tree):
    return path == tree or path.startswith(tree.rstrip("/") + "/")


def tree_paths(tree):
    return {tree, os.path.realpath(tree)}


def registrations(repo):
    """path -> {locked, prunable} for every registration, straight from git."""
    found, current = {}, None
    for line in git(repo, "worktree", "list", "--porcelain").split("\n"):
        if line.startswith("worktree "):
            current = found[line[len("worktree "):]] = {"locked": False, "prunable": False}
        elif current is not None and (line == "locked" or line.startswith("locked ")):
            current["locked"] = True
        elif current is not None and (line.startswith("prunable") or line == "bare"):
            current["prunable"] = True
    return found


# --- live state: things only true right now -------------------------------

def process_cwds():
    out = run(["lsof", "-a", "-d", "cwd", "-Fpcn"])
    if not out.stdout:
        raise Unknown(f"lsof gave no output: {out.stderr.strip()}")
    procs, pid, command = [], None, ""
    for line in out.stdout.split("\n"):
        if line.startswith("p"):
            pid, command = int(line[1:]), ""
        elif line.startswith("c"):
            command = line[1:]
        elif line.startswith("n") and pid != os.getpid():
            procs.append((pid, command, line[1:]))
    return procs


def pm2_cwds():
    home = os.environ.get("PM2_HOME") or os.path.join(os.path.expanduser("~"), ".pm2")
    try:
        with open(os.path.join(home, "pm2.pid")) as handle:
            os.kill(int(handle.read()), 0)
    except (FileNotFoundError, ProcessLookupError):
        return []  # no daemon, nothing registered; asking would spawn one
    except (ValueError, OSError) as error:
        raise Unknown(f"pm2 daemon state unreadable: {error}")
    out = run(["pm2", "jlist"])
    if out.returncode:
        raise Unknown(f"pm2 jlist failed: {out.stderr.strip()}")
    try:
        return [(p["name"], p["pm2_env"]["pm_cwd"]) for p in json.loads(out.stdout)]
    except (ValueError, KeyError, TypeError) as error:
        raise Unknown(f"pm2 jlist unreadable: {error}")


def live_leases():
    base = os.environ.get("DEV_LEASE_DIR") or os.path.join(os.path.expanduser("~"), ".local/state/dev-leases")
    if not os.path.isdir(base):
        return []
    leases = []
    for name in sorted(os.listdir(base)):
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(base, name)) as handle:
                record = json.load(handle)
            if record["expires"] > time.time():
                leases.append((record["name"], record["cwd"]))
        except (OSError, ValueError, KeyError, TypeError) as error:
            raise Unknown(f"dev lease {name} unreadable: {error}")
    return leases


def live_state(repo):
    """Everything that changes while we work. Each part is a value or an Unknown."""
    state = {}
    for key, fetch in (("procs", process_cwds), ("pm2", pm2_cwds), ("leases", live_leases),
                       ("stash", lambda: git(repo, "stash", "list", "--format=%gs").split("\n")),
                       ("regs", lambda: registrations(repo))):
        try:
            state[key] = fetch()
        except Unknown as error:
            state[key] = error
    return state


# --- the checks -------------------------------------------------------------

def declared_paths(repo, key):
    """Values of devsweep.<key> in the primary checkout's local git config, validated."""
    out = run(["git", "-C", repo, "config", "--local", "--get-all", f"devsweep.{key}"])
    if out.returncode == 1:
        return set()
    if out.returncode:
        die(f"git config devsweep.{key} failed in {repo}: {out.stderr.strip()}")
    paths = set()
    for value in out.stdout.split("\n")[:-1]:
        parts = value.split("/")
        if (not value or value.startswith("/") or any(part in ("", ".", "..") for part in parts)
                or any(ch in value for ch in "*?[\\")):
            die(f"devsweep.{key} in {repo} has a malformed value {value!r}: "
                "use a repo-relative path with no '..', empty parts, trailing slash or glob")
        paths.add(value)
    return paths


def classify_ignored(wt):
    """(blockers, env_files, too_large) from the tree's ignored entries.

    A generated name (node_modules, dist, ...) is trusted only for an entry git
    itself reports, at any depth in the repo (packages/x/dist/). dev-scan
    reports a wholly ignored directory as one entry; when that is not generated
    output it is walked, and nothing inside is trusted by name: an env file is
    preserved, anything else blocks. Symlinks are never followed.
    """
    blockers, envs, large = [], [], []

    def generated(rel):
        name = rel.rsplit("/", 1)[-1]
        if name in GENERATED_DIRS or rel in EXTRA_GENERATED:
            return True
        full = os.path.join(wt["dir"], rel)
        if os.path.isdir(full) and not os.path.islink(full):
            return False  # the name patterns below are for files; a directory is judged by what is inside
        return name.startswith(".coverage.") or rel.endswith(GENERATED_SUFFIXES)

    def judge(rel, reported):
        full = os.path.join(wt["dir"], rel)
        name = rel.rsplit("/", 1)[-1]
        if reported and generated(rel):
            return
        if name.startswith(".env") or rel in PRESERVE:
            if os.path.islink(full):
                return
            if os.path.isfile(full):
                (large if os.path.getsize(full) > MAX_ENV_BYTES else envs).append(rel)
                return
        if os.path.isdir(full) and not os.path.islink(full):
            for child in sorted(os.listdir(full)):
                judge(f"{rel}/{child}", False)
                if blockers:
                    return
            return  # an empty directory loses nothing
        blockers.append(rel)

    entries = [entry.rstrip("/") for entry in wt["ignored"]]
    # A cache that ignores itself (ruff, pytest, mypy, venv write their own .gitignore) makes git
    # list its inner paths too; they are covered by the cache directory above them. No other
    # name gets this: a build/ that ignores itself still has its contents judged.
    roots = {entry for entry in entries if entry.rsplit("/", 1)[-1] in SELF_IGNORING and generated(entry)}
    for entry in entries:
        parts = entry.split("/")
        if any("/".join(parts[:i]) in roots for i in range(1, len(parts))):
            continue
        judge(entry, True)
    return list(dict.fromkeys(blockers)), list(dict.fromkeys(envs)), list(dict.fromkeys(large))


def env_files(wt):
    return classify_ignored(wt)[1]


def ignored_blockers(wt):
    return classify_ignored(wt)[0]


def in_progress(gitdir):
    names = ["rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG", "sequencer"]
    return [n for n in names if os.path.exists(os.path.join(gitdir, n))]


def changed_files(wt):
    lines = git(wt["dir"], "status", "--porcelain", "--untracked-files=all").split("\n")
    names = [line[3:] for line in lines if line]
    return ", ".join(names[:3]) + (f", +{len(names) - 3} more" if len(names) > 3 else "")


SHARED_BRANCHES = {"main", "master", "dev", "develop", "staging", "production"}


def push_target(wt):
    """(remote, error). The remote to push the branch to, or why there is none."""
    branch = wt["branch"]
    remote = ""
    for key in (f"branch.{branch}.pushRemote", f"branch.{branch}.remote"):
        out = run(["git", "-C", wt["dir"], "config", "--get", key])
        remote = out.stdout.strip()
        if remote:
            break
    remote = remote if remote and remote != "." else "origin"
    if remote not in git(wt["dir"], "remote").split():
        return None, f"no remote {remote} to push to"
    head = run(["git", "-C", wt["dir"], "symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD"])
    if head.returncode:
        return None, f"unpushed commits; remote default branch unknown (refs/remotes/{remote}/HEAD unset)"
    default = head.stdout.strip().removeprefix(f"{remote}/")
    if branch == default or branch in SHARED_BRANCHES or branch.startswith("release/"):
        return None, f"unpushed commits on shared branch {branch}"
    tracking = f"refs/remotes/{remote}/{branch}"
    if run(["git", "-C", wt["dir"], "rev-parse", "--verify", "-q", tracking]).returncode == 0:
        if run(["git", "-C", wt["dir"], "merge-base", "--is-ancestor", tracking, "HEAD"]).returncode:
            return None, f"push would be rejected ({remote}/{branch} has other commits)"
    return remote, None


def evaluate(wt, state):
    """(verdict, reasons) for one worktree. verdict: remove | push-then-remove | keep."""
    reasons = []
    reg = state["regs"]
    if isinstance(reg, Unknown):
        return "keep", [f"unknown: {reg}"]
    if wt["isMain"]:
        return "keep", ["primary checkout"]
    entry = reg.get(wt["dir"])
    if entry is None:
        return "keep", ["not registered with git"]
    if entry["locked"]:
        return "keep", ["locked"]
    if entry["prunable"]:
        return "keep", ["prunable or missing"]

    try:
        if wt["changed"] or wt["untracked"]:
            reasons.append(f"uncommitted: {wt['changed']} modified, {wt['untracked']} untracked ({changed_files(wt)})")
        gitdir = git(wt["dir"], "rev-parse", "--absolute-git-dir").strip()
        busy = in_progress(gitdir)
        if busy:
            reasons.append(f"in progress: {', '.join(busy)}")
        stash = state["stash"]
        if isinstance(stash, Unknown):
            reasons.append(f"unknown: {stash}")
        else:
            label = wt["branch"] if wt["branch"] != "detached" else "(no branch)"
            if any(s.startswith((f"WIP on {label}:", f"On {label}:")) for s in stash):
                reasons.append(f"stash entry from {label}")

        contained = [r for r in git(wt["dir"], "for-each-ref", "--contains", wt["head"],
                                    "--format=%(refname:short)", "refs/remotes").split()
                     if not r.endswith("/HEAD")]
        action = "remove"
        if not contained and wt["head"] not in PR_HEADS:
            if wt["branch"] == "detached":
                reasons.append("detached HEAD with commits on no remote branch")
            else:
                remote, error = push_target(wt)
                if error:
                    reasons.append(error)
                action = "push-then-remove"

        stamps = [wt["lastCommit"]]
        for name in ("index", "logs/HEAD"):
            try:
                stamps.append(os.path.getmtime(os.path.join(gitdir, name)))
            except FileNotFoundError:
                pass
        idle = time.time() - max(stamps)
        if idle < IDLE_SECONDS:
            reasons.append(f"idle only {idle / 3600:.1f}h (needs 24h)")

        for source, label in (("procs", "running process"), ("pm2", "pm2 process"), ("leases", "live dev lease")):
            facts = state[source]
            if isinstance(facts, Unknown):
                reasons.append(f"unknown: {facts}")
                continue
            for item in facts:
                cwd = item[-1]
                if any(inside(cwd, t) for t in tree_paths(wt["dir"])):
                    reasons.append(f"{label}: {' '.join(str(x) for x in item[:-1])}")

        for rel in classify_ignored(wt)[2]:
            reasons.append(f"env-named file too large to preserve: {rel}")
        if any(line.startswith("160000 ") for line in git(wt["dir"], "ls-files", "--stage").split("\n")):
            reasons.append("contains submodules (git refuses to remove the tree)")
        blockers = ignored_blockers(wt)
        if blockers:
            shown = ", ".join(blockers[:4]) + (f", +{len(blockers) - 4} more" if len(blockers) > 4 else "")
            reasons.append(f"ignored content not on the allowlist: {shown}")
    except (Unknown, OSError) as error:  # an unreadable path is an unknown fact, not a crash
        reasons.append(f"unknown: {error}")
    return ("keep", reasons) if reasons else (action, [])


# --- env preservation ---------------------------------------------------------

def backup_env(repo, wt):
    """Copy each regular .env* file to $HOME/Backups/<repo>/worktree-env/<hash12>.env, verified.

    Raises Unknown on any failure so the tree is kept. Env contents are never
    printed: errors name paths, not bytes.
    """
    files = env_files(wt)
    if not files:
        return
    folder = os.path.join(os.path.expanduser("~"), "Backups", os.path.basename(repo), "worktree-env")
    stamp = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    entries = []
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.chmod(folder, 0o700)
        for rel in files:
            with open(os.path.join(wt["dir"], rel), "rb") as handle:
                data = handle.read()
            digest = hashlib.sha256(data).hexdigest()
            stored = os.path.join(folder, digest[:12] + ".env")
            if not os.path.exists(stored):
                temp = stored + ".new"
                fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "wb") as out:
                    out.write(data)
                os.replace(temp, stored)
            with open(stored, "rb") as handle:
                if hashlib.sha256(handle.read()).hexdigest() != digest:
                    raise Unknown(f"env backup {stored} does not match its source {rel}")
            entries.append("\t".join([stamp, wt["dir"], wt["branch"], rel, digest]))
        index = os.path.join(folder, "index.tsv")
        lines = []
        if os.path.exists(index):
            with open(index) as handle:
                lines = handle.read().splitlines()
        lines = (lines + entries)[-INDEX_LINES:]
        temp = index + ".new"
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as out:
            out.write("\n".join(lines) + "\n")
        os.replace(temp, index)
    except OSError as error:
        raise Unknown(f"env backup failed: {error.strerror or type(error).__name__} ({error.filename})")


# --- apply ------------------------------------------------------------------

def refreshed(scan, repo, wt):
    """The tree's facts and the live state, re-read from scratch."""
    base = scan.git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    try:
        facts = scan.git_facts(wt["dir"], base.strip() if base else None)
    except SystemExit:
        raise Unknown("dev-scan could not re-read the tree")
    fresh = {**wt, **facts}
    if fresh["head"] != wt["head"]:
        raise Unknown("HEAD moved during the sweep")
    return fresh, live_state(repo)


LEFTOVER_TRIES, LEFTOVER_PAUSE = 4, 0.5


def finish_leftover(repo, path, why):
    """(removed|keep|partial, reasons) for a folder git unregistered but could not fully delete.
    Deletes only `path`, the exact directory this run passed to `git worktree remove`."""
    if os.path.realpath(path) == os.path.realpath(repo):
        return "keep", ["refusing to delete the primary checkout"]
    if any(os.path.realpath(p) == os.path.realpath(path) for p in registrations(repo)):
        return "keep", [f"git refused removal: {why}"]
    if os.path.islink(path):
        return "partial", [f"unregistered leftover at {path}: path is a symlink, not deleted"]
    if not os.path.isdir(path):
        return "removed", []
    error = why
    for attempt in range(LEFTOVER_TRIES):  # a Finder .DS_Store can reappear mid-delete
        failures = []
        shutil.rmtree(path, onerror=lambda fn, p, info: failures.append(str(info[1])))
        if not os.path.lexists(path):
            return "removed", [f"deleted leftover folder after git: {why}"]
        error = failures[0] if failures else "directory still exists"
        time.sleep(LEFTOVER_PAUSE)
    return "partial", [f"unregistered leftover at {path}: {error}"]


def remove_one(scan, repo, wt):
    """(result, reasons). Re-check, push if needed, unforced remove. Errors keep."""
    try:
        fresh, state = refreshed(scan, repo, wt)
        verdict, reasons = evaluate(fresh, state)
        if verdict == "keep":
            return "keep", [f"changed before removal: {'; '.join(reasons)}"]
        pushed = verdict == "push-then-remove"
        if pushed:
            remote, error = push_target(fresh)
            if error:
                return "keep", [error]
            out = run(["git", "-C", wt["dir"], "push", "--no-verify", remote, f"refs/heads/{wt['branch']}:refs/heads/{wt['branch']}"])
            if out.returncode:
                return "keep", [f"push failed: {out.stderr.strip().splitlines()[-1] if out.stderr.strip() else out.returncode}"]
            fresh, state = refreshed(scan, repo, wt)
            verdict, reasons = evaluate(fresh, state)
            if verdict != "remove":
                return "keep", [f"push not confirmed: {'; '.join(reasons) or verdict}"]
        backup_env(repo, fresh)
        out = run(["git", "-C", repo, "worktree", "remove", wt["dir"]])
        done = "pushed-and-removed" if pushed else "removed"
        if out.returncode or os.path.exists(wt["dir"]):
            why = out.stderr.strip() if out.returncode else "directory still exists after removal"
            if wt["dir"] in registrations(repo):
                return "keep", [f"git refused removal: {why}"] if out.returncode else [why]
            # git dropped the registration but left files behind: this tree already passed
            # every check, so finish the job (a keep here would orphan the folder forever).
            result, reasons = finish_leftover(repo, wt["dir"], why)
            return (done if result == "removed" else result), reasons
        return done, []
    except (Unknown, OSError) as error:
        return "keep", [f"unknown: {error}"]


# --- main -------------------------------------------------------------------

def sweep(repo, apply):
    if not os.path.isdir(os.path.join(repo, ".git")):
        die(f"{repo} is not a primary checkout (no .git directory). Pass the repo's main checkout.")
    EXTRA_GENERATED.clear()
    EXTRA_GENERATED.update(declared_paths(repo, "generated"))
    PRESERVE.clear()
    PRESERVE.update(declared_paths(repo, "preserve"))
    out = run(["git", "-C", repo, "fetch", "--all", "--prune", "--quiet"])
    if out.returncode:
        die(f"git fetch failed in {repo}: {out.stderr.strip()}")
    PR_HEADS.clear()
    for remote in git(repo, "remote").split():
        heads = run(["git", "-C", repo, "ls-remote", remote, "refs/pull/*/head"])
        if heads.returncode:
            die(f"git ls-remote failed for {remote}: {heads.stderr.strip()}")
        PR_HEADS.update(line.split("\t")[0] for line in heads.stdout.splitlines() if line)
    scanned = run([os.path.join(HERE, "dev-scan"), "worktrees", repo])
    if scanned.returncode:
        die(f"dev-scan failed: {scanned.stderr.strip()}")
    rows = json.loads(scanned.stdout)
    if not rows or os.path.realpath(rows[0]["dir"]) != os.path.realpath(repo):
        die(f"{repo} is not the first worktree git lists; pass the primary checkout")

    state = live_state(repo)
    results = []
    for wt in rows:
        verdict, reasons = evaluate(wt, state)
        results.append({"dir": wt["dir"], "branch": wt["branch"], "verdict": verdict, "reasons": reasons,
                        "envFiles": len(env_files(wt)) if verdict != "keep" else 0})
    if isinstance(state["regs"], Unknown):
        die(str(state["regs"]))
    scanned_dirs = {wt["dir"] for wt in rows}
    for path in state["regs"]:
        if path not in scanned_dirs:
            results.append({"dir": path, "branch": "", "verdict": "keep", "reasons": ["prunable or missing"], "envFiles": 0})

    if apply:
        scan = load_scan()
        by_dir = {wt["dir"]: wt for wt in rows}
        for result in results:
            if result["verdict"] in ("remove", "push-then-remove"):
                result["verdict"], result["reasons"] = remove_one(scan, repo, by_dir[result["dir"]])
    return results


def render(results, apply, as_json):
    gone = [r for r in results if r["verdict"] not in ("keep", "partial")]
    partial = sum(r["verdict"] == "partial" for r in results)
    kept = len(results) - len(gone) - partial
    if as_json:
        extra = {"partial": partial} if apply else {}
        return json.dumps({"worktrees": results, "total": len(results),
                           "removed" if apply else "wouldRemove": len(gone),
                           "kept" if apply else "wouldKeep": kept, **extra})
    lines = []
    for r in results:
        verdict = f"{r['verdict']}: {'; '.join(r['reasons'])}" if r["verdict"] in ("keep", "partial") else r["verdict"]
        note = f"\t{r['envFiles']} env files to preserve" if r["envFiles"] and not apply else ""
        lines.append(f"{verdict}\t{r['dir']}\t{r['branch']}{note}")
    lines.append(f"total {len(results)}, {'removed' if apply else 'would remove'} {len(gone)}, "
                 f"{'kept' if apply else 'would keep'} {kept}" + (f", partial {partial}" if partial else ""))
    return "\n".join(lines)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    os.environ["GIT_TERMINAL_PROMPT"] = "0"  # also covers dev-scan's own git calls
    apply = as_json = False
    paths = []
    for arg in argv:
        if arg == "--apply":
            apply = True
        elif arg == "--json":
            as_json = True
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif arg.startswith("-"):
            die(f"unknown option {arg}")
        else:
            paths.append(arg)
    if len(paths) != 1:
        die("needs exactly one primary checkout path")
    try:
        results = sweep(os.path.abspath(os.path.expanduser(paths[0])), apply)
    except Unknown as error:
        die(str(error))
    print(render(results, apply, as_json))
    return EXIT_PARTIAL if any(r["verdict"] == "partial" for r in results) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
