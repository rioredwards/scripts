#!/usr/bin/env bash

# aitt - AI Text Transform CLI
# A thin wrapper around Simon Willison's 'llm' CLI

set -e

# Uncomment and change if you want to override llm's default model
# export LLM_MODEL="claude-3-5-sonnet-latest"

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROMPTS_DIR="$DIR/prompts"

# Dependencies check
if ! command -v llm >/dev/null 2>&1; then
  echo "Error: 'llm' CLI not found." >&2
  echo "Please install it with: brew install llm" >&2
  echo "To use Anthropic: llm install llm-anthropic && llm keys set anthropic" >&2
  exit 1
fi

# Variables
TRANSFORM=""
INPUT_TEXT=""
FILE=""
CLIPBOARD=0
COPY=0
OUT_PATH=""
SPEAK=0
DRY_RUN=0
LIST=0

# Check for stdin first (before consuming positional args)
STDIN_DATA=""
if [[ ! -t 0 ]]; then
  STDIN_DATA=$(cat)
fi

POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case $1 in
    --file)
      FILE="$2"
      shift 2
      ;;
    --clipboard)
      CLIPBOARD=1
      shift
      ;;
    --copy)
      COPY=1
      shift
      ;;
    --out)
      OUT_PATH="$2"
      shift 2
      ;;
    --speak)
      SPEAK=1
      shift
      ;;
    --list)
      LIST=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      echo "Usage: aitt [transform] [options] [input text...]"
      echo ""
      echo "Transforms text using AI presets via the 'llm' CLI."
      echo ""
      echo "Options:"
      echo "  --file PATH       Read input from file"
      echo "  --clipboard       Read input from macOS clipboard (pbpaste)"
      echo "  --copy            Copy output to macOS clipboard (pbcopy)"
      echo "  --out PATH        Write output to file"
      echo "  --speak           Speak output using macOS 'say'"
      echo "  --list            List available transforms"
      echo "  --dry-run         Print assembled prompt without calling AI"
      echo "  -h, --help        Show this help"
      echo ""
      echo "Examples:"
      echo "  aitt condense < notes.txt"
      echo "  pbpaste | aitt summarize"
      echo "  aitt eli5 --file ./notes.md"
      echo "  aitt promptify --clipboard --copy"
      echo "  aitt custom \"Turn this into a concise GitHub issue: ...\""
      echo "  aitt summarize --file meeting-notes.md --out summary.md"
      exit 0
      ;;
    -*|--*)
      echo "Unknown option $1" >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "$LIST" -eq 1 ]]; then
  echo "Available transforms:"
  for p in "$PROMPTS_DIR"/*.md; do
    if [[ -f "$p" ]]; then
      basename "$p" .md | sed 's/^/  - /'
    fi
  done
  exit 0
fi

# Determine transform
if [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  POTENTIAL_TRANSFORM="${POSITIONAL[0]}"
  if [[ -f "$PROMPTS_DIR/${POTENTIAL_TRANSFORM}.md" ]]; then
    TRANSFORM="$POTENTIAL_TRANSFORM"
    POSITIONAL=("${POSITIONAL[@]:1}")
  else
    # First arg isn't a known transform. Does it default to custom?
    if [[ -f "$PROMPTS_DIR/custom.md" ]]; then
      TRANSFORM="custom"
    else
      echo "Error: Unknown transform '$POTENTIAL_TRANSFORM' and default 'custom.md' prompt not found." >&2
      exit 1
    fi
  fi
else
  # No positional args, default to custom if possible
  if [[ -f "$PROMPTS_DIR/custom.md" ]]; then
    TRANSFORM="custom"
  else
    echo "Error: No transform provided and 'custom.md' not found." >&2
    exit 1
  fi
fi

PROMPT_TEXT=$(cat "$PROMPTS_DIR/${TRANSFORM}.md")

# Gather input text
# Priority: 1. --file PATH, 2. --clipboard, 3. piped stdin, 4. remaining positional argument text

if [[ -n "$FILE" ]]; then
  if [[ ! -f "$FILE" ]]; then
    echo "Error: File '$FILE' not found." >&2
    exit 1
  fi
  INPUT_TEXT=$(cat "$FILE")
elif [[ "$CLIPBOARD" -eq 1 ]]; then
  INPUT_TEXT=$(pbpaste)
elif [[ -n "$STDIN_DATA" ]]; then
  INPUT_TEXT="$STDIN_DATA"
elif [[ ${#POSITIONAL[@]} -gt 0 ]]; then
  INPUT_TEXT="${POSITIONAL[*]}"
fi

if [[ -z "$INPUT_TEXT" ]]; then
  echo "Error: No input provided." >&2
  echo "Please provide input via --file, --clipboard, stdin, or as positional arguments." >&2
  echo "Run 'aitt --help' for usage." >&2
  exit 1
fi

# Sanitize input to remove invalid UTF-8 and lone surrogates that crash Python text encoders
INPUT_TEXT=$(printf "%s" "$INPUT_TEXT" | python3 -c "import sys; sys.stdout.buffer.write(sys.stdin.buffer.read().decode('utf-8', 'ignore').encode('utf-8', 'ignore'))")

# Assemble prompt
STRICT_RULE="CRITICAL RULE: You must return ONLY the requested content. DO NOT include any conversational filler, preludes (e.g. 'Here is the...', 'Certainly!'), conclusions, or meta-text. DO NOT output an overarching title or prefix for the entire response (like '**Result:**' or '**Prompt:**'). Output nothing but the exact requested content."

ASSEMBLED_PROMPT="${PROMPT_TEXT}

${STRICT_RULE}

Input:
${INPUT_TEXT}"

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "=== DRY RUN ==="
  echo "Transform: $TRANSFORM"
  if [[ -n "$LLM_MODEL" ]]; then
    echo "Model: $LLM_MODEL (from environment)"
  else
    echo "Model: (llm default)"
  fi
  echo "----------------"
  echo "$ASSEMBLED_PROMPT"
  exit 0
fi

# Run transformation
# llm reads from stdin naturally, outputting the response
SYSTEM_PROMPT="You are a pure text transformation engine. Return ONLY the transformed text. DO NOT output any conversational filler, preludes, greetings, explanations, or postscripts. Do not give the output a title like 'Here is the result:'. Your output must consist ENTIRELY of the requested output."
OUTPUT=$(echo "$ASSEMBLED_PROMPT" | llm --system "$SYSTEM_PROMPT")

# Handle output
if [[ -n "$OUT_PATH" ]]; then
  echo "$OUTPUT" > "$OUT_PATH"
else
  echo "$OUTPUT"
fi

if [[ "$COPY" -eq 1 ]]; then
  echo "$OUTPUT" | pbcopy
fi

if [[ "$SPEAK" -eq 1 ]]; then
  echo "$OUTPUT" | say
fi
