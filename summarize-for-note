#!/bin/sh
set -eu

text=""
if [ "$#" -gt 0 ]; then
  text="$*"
elif [ ! -t 0 ]; then
  text="$(cat)"
fi

if [ -z "$text" ]; then
  exit 0
fi

# Try to summarize with aitt. Fallback to original text if aitt fails.
if output="$(printf '%s' "$text" | "$HOME/scripts/ai-text-transform/aitt" summarize-for-note 2>/dev/null)" && [ -n "$output" ]; then
  printf '%s' "$output"
else
  printf '%s' "$text"
fi
