#!/usr/bin/env bash
#
# dev-up: start this repo's dev server the way Rio wants it, in ONE command.
#
# Finds the repo's own start script, runs it through portless (named, stable,
# tailnet-reachable port) as a named pm2 process, waits for the URL, remembers it
# for the statusline, and prints it. No port hunting, no process surveys, no
# guessing. If a server for this checkout is already up and answering, prints its
# URL and does nothing else (up but erroring: exit 1, never auto-restarted;
# DEV_UP_REUSE_TIMEOUT=10 seconds to wait for it). Also self-heals the two things that used to strand it:
# a dead Tailscale Serve mapping squatting on 443 (reclaimed, so the app keeps
# its usual URL) and a leftover pm2 process from a failed run (stopped).
#
#   dev-up                 # detect the start script, start, print URL
#   dev-up -- <command...> # start this exact command instead of detecting
#   DEV_UP_TIMEOUT=120 dev-up
#
# Prints on success (stdout, last line):   URL pm2=<name> lease=<token> created|reused
# Exit codes: 0 started or already running · 1 server failed or reused server
# erroring (log tail printed when we started it) · 2 could not even try (no script, no pm2, not a repo).
# Logs: pm2 logs <name> · list: dev-ls · stop: dev-lease stop <token>
#
# Agents: this IS the sanctioned dev-server start (RIO_RUN_OK is implied).
set -euo pipefail

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  sed -n '3,23p' "$0"; exit 0
fi
LEASE_TOOL="$(cd "$(dirname "$0")" && pwd)/dev-lease"
lease=""
cleanup() {
  status=$?
  if [[ $status != 0 && -n "$lease" ]]; then
    /usr/bin/python3 "$LEASE_TOOL" stop "$lease" >&2 || say "dev-up: cleanup failed; inspect lease $lease"
  fi
  return "$status"
}
trap cleanup EXIT

say()  { printf '%s\n' "$*" >&2; }
die()  { say "dev-up: $*"; exit 2; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repo. cd into the repo checkout, then rerun: dev-up"
cd "$ROOT"
# One pm2 name per checkout: worktrees share a basename, so add a path hash.
NAME="dev-$(basename "$ROOT")-$(printf '%s' "$ROOT" | shasum | cut -c1-6)"

# ── 1. What to run ────────────────────────────────────────────────────────────
CMD=()
if [[ "${1:-}" == "--" ]]; then
  shift; CMD=("$@")
  [[ ${#CMD[@]} -gt 0 ]] || die "nothing after --. Run: dev-up -- <command...>"
else
  for cand in skeleton/scripts/start_dev.sh scripts/start_dev.sh scripts/dev bin/dev start_dev.sh; do
    if [[ -x "$cand" ]]; then CMD=("./$cand"); break; fi
  done
  if [[ ${#CMD[@]} -eq 0 && -f package.json ]] && grep -q '"dev"[[:space:]]*:' package.json; then
    if [[ -f pnpm-lock.yaml ]]; then CMD=(pnpm dev); else CMD=(npm run dev); fi
  fi
  [[ ${#CMD[@]} -gt 0 ]] || die "no start script found (looked for skeleton/scripts/start_dev.sh, scripts/start_dev.sh, scripts/dev, bin/dev, a package.json dev script). Check RUNBOOK.md, or run: dev-up -- <command>"
fi

# Tailscale's CLI lives in /usr/local/bin, which ssh's non-interactive PATH lacks.
command -v tailscale >/dev/null || PATH="$PATH:/usr/local/bin"
command -v tailscale >/dev/null || die "tailscale not found on PATH ($PATH). Install Tailscale (https://tailscale.com/download), then rerun: dev-up"
command -v portless >/dev/null || die "portless not found on PATH ($PATH). Installed already? This shell's PATH is missing its directory. Otherwise run: brew install portless"

# probe_url URL SECONDS: poll until the app answers with something other than the
# proxy's 502 or an app error. Sets PROBE_CODE; returns 1 if it never does. One
# probe for both a fresh start and a reused server, so "up" means the same thing.
probe_url() {
  local deadline=$(( SECONDS + $2 ))
  while :; do
    PROBE_CODE="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1/" || true)"
    PROBE_CODE="${PROBE_CODE:-000}"
    case "$PROBE_CODE" in 2*|3*|401|403) return 0 ;; esac
    (( SECONDS < deadline )) || return 1
    sleep 2
  done
}

# ── 2. Already running for this checkout? ─────────────────────────────────────
# portless lists routes with their supervisor pid; a pid whose cwd is this
# checkout is our server. Probe it (an existing server can be up and broken),
# print its tailscale URL and stop. A failed `portless list` must not read as
# "nothing running": that would start a duplicate next to the real server.
existing="$(portless list)" || die "portless list failed (output above), so dev-up cannot tell whether a server is already running for this checkout. Fix portless, then rerun: dev-up"
while IFS= read -r pid; do
  [[ -n "$pid" ]] || continue
  pcwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
  if [[ "$pcwd" == "$ROOT" ]]; then
    url="$(printf '%s\n' "$existing" | awk -v p="(pid $pid)" 'index($0,p){f=1;next} f&&/tailscale:/{print $2;exit}')"
    if [[ -n "$url" ]]; then
      probe_url "$url" "${DEV_UP_REUSE_TIMEOUT:-10}" || {
        say "dev-up: a server is already running for this checkout (pid $pid) but $url answers HTTP $PROBE_CODE, so it is not usable. Not restarting it automatically."
        say "dev-up: stop it (dev-lease stop-pid $pid if dev-up started it, else kill $pid), then rerun: dev-up"
        exit 1
      }
      renewed="$(/usr/bin/python3 "$LEASE_TOOL" renew-pid "$pid")"
      dev-url set "$url" >/dev/null 2>&1 || true
      say "dev-up: already running for this checkout (pid $pid)"
      [[ "$renewed" == untracked ]] && reused_name="?" || reused_name="$NAME"
      printf '%s pm2=%s lease=%s reused\n' "$url" "$reused_name" "$renewed"
      exit 0
    fi
  fi
done < <(printf '%s\n' "$existing" | sed -n 's/.*(pid \([0-9]*\)).*/\1/p')

# ── 3. Is the portless proxy up? ──────────────────────────────────────────────
# If it is not, `portless run` tries to start it on port 443, which needs sudo,
# and the server waits at a password prompt nobody can answer until the timeout.
# Start it ourselves on the unprivileged port instead, before starting the app.
if ! pgrep -f 'portless proxy start' >/dev/null 2>&1; then
  say "dev-up: portless proxy is down, starting it on 1355 (no sudo needed)"
  portless proxy start --port 1355 --https >/dev/null 2>&1 \
    || die "could not start the portless proxy. Run it yourself and read the error: portless proxy start --port 1355 --https"
fi

# ── 3b. Reclaim Tailscale Serve ports whose backend is dead ──────────────────
# portless only removes its `tailscale serve` mapping on a graceful exit (it
# traps SIGINT/SIGTERM, not SIGHUP or SIGKILL), so a hard-killed server leaves the
# mapping behind, and the next run drifts from :443 to :8443 and
# every doc pointing at the usual URL breaks. Reclaim a mapping in portless's
# port range (443, 8443+) only if nothing listens on its proxied local port AND no live
# portless supervisor owns that port (portless registers the mapping before the
# app listens). A live backend is never touched: see serve_explain below.
serve_check() {  # $1 = reclaim | explain [URL]
  SERVE_MODE="$1" SERVE_URL="${2:-}" python3 - <<'PY'
import json, os, re, socket, subprocess, sys
from urllib.parse import urlparse

PORTLESS_PORTS = {443, *range(8443, 9000)}  # portless counts past 8450 once its pool is full

def sh(*a):
    return subprocess.run(a, capture_output=True, text=True)

def status():
    r = sh("tailscale", "serve", "status", "--json")
    if r.returncode:
        sys.exit(f"dev-up: `tailscale serve status --json` failed: {(r.stderr or r.stdout).strip()}. Is Tailscale up? Run: tailscale status")
    return json.loads(r.stdout or "{}").get("Web", {})

def backends(handlers):
    """Local proxy ports of a mapping, or None if any handler is not a local proxy."""
    ports = []
    for h in handlers.values():
        u = urlparse(h.get("Proxy", ""))
        if u.hostname not in ("127.0.0.1", "localhost", "::1") or not u.port:
            return None
        ports.append(u.port)
    return ports or None

def alive(port):
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(("127.0.0.1", port)) == 0

def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def routes():
    f = os.path.join(os.environ.get("PORTLESS_STATE_DIR", os.path.expanduser("~/.portless")), "routes.json")
    try:
        return json.load(open(f))
    except FileNotFoundError:
        return []

def owner(https_port):
    for r in routes():
        if r.get("tailscaleHttpsPort") == https_port:
            return r
    return None

def mappings():
    out = {}
    for key, cfg in status().items():
        m = re.search(r":(\d+)$", key)
        if m:
            out[int(m.group(1))] = backends(cfg.get("Handlers", {}))
    return out

mode = os.environ["SERVE_MODE"]
if mode == "reclaim":
    for port, bk in sorted(mappings().items()):
        if port not in PORTLESS_PORTS or not bk or any(alive(b) for b in bk):
            continue
        o = owner(port)
        if o and pid_alive(o.get("pid", 0)):
            print(f"dev-up: leaving dead serve mapping :{port} -> {bk} alone, live portless supervisor pid {o['pid']} ({o['hostname']}) owns it", file=sys.stderr)
            continue
        print(f"dev-up: reclaiming stale tailscale serve :{port} (backend 127.0.0.1:{bk[0]} is dead, no live portless owner)", file=sys.stderr)
        r = sh("tailscale", "serve", f"--https={port}", "off")
        if r.returncode or port in mappings():
            sys.exit(f"dev-up: could not remove stale serve :{port}: {(r.stderr or r.stdout).strip()}. Run it yourself: tailscale serve --https={port} off")
else:  # explain: the started app is not on the usual 443, say who holds it
    url = urlparse(os.environ["SERVE_URL"])
    if not url.port or url.port == 443:
        sys.exit(0)
    held = mappings().get(443, "absent")
    if held == "absent":
        why = "nothing maps :443 now (it was held while this app started)"
    else:
        o = owner(443)
        who = f"portless app {o['hostname']} (pid {o['pid']})" if o else "a mapping portless did not create"
        state = "alive" if held and any(alive(b) for b in held) else "dead but owned by a live supervisor"
        why = f"held by {who}, backend {held} {state}"
    print(f"dev-up: WARNING this app is on :{url.port}, NOT the usual https://{url.hostname} (443). 443 is {why}. "
          f"Stop that app (or run: tailscale serve --https=443 off) and rerun dev-up if this app should own 443.", file=sys.stderr)
PY
}
serve_check reclaim

# ── 4. Start it as a named pm2 process ─────────────────────────────────────────
# pm2 owns the process: `pm2 ls` lists it, `pm2 logs` tails it, and stopping it
# sends SIGINT to the whole tree so portless removes its route and mapping.
type -P pm2 >/dev/null || die "pm2 not found on PATH ($PATH). Installed already? This shell's PATH is missing /opt/homebrew/bin. Otherwise run: /opt/homebrew/bin/npm i -g pm2"
# Match a bare pid line only: spawning the daemon (first run after a reboot) prints to stdout.
if pm2 pid "$NAME" 2>/dev/null | grep -qxE '[0-9]+'; then
  # Step 2 reuses a live server, so one still here failed or is mid-boot.
  say "dev-up: pm2 already has $NAME, not answering; stopping it first"
  /usr/bin/python3 "$LEASE_TOOL" stop-name "$NAME" >&2 \
    || die "$NAME is in pm2 but dev-up holds no lease for it. Look at it (pm2 logs $NAME), then: pm2 delete $NAME && dev-up"
fi
LOG="${DEV_UP_LOG_DIR:-$HOME/.local/state/dev-up}/$NAME.log"
mkdir -p "$(dirname "$LOG")"; : > "$LOG"
started="$(pm2 start portless --name "$NAME" --interpreter none --cwd "$ROOT" --no-autorestart \
  --kill-timeout 20000 --output "$LOG" --error "$LOG" -- run --tailscale "${CMD[@]}" 2>&1)" \
  || die "pm2 start failed: $(printf '%s' "$started" | tail -5). Fix that, then rerun: dev-up"
lease="$(/usr/bin/python3 "$LEASE_TOOL" create "$NAME")"

# ── 5. Wait for the tailnet URL in its log ─────────────────────────────────────
deadline=$(( SECONDS + ${DEV_UP_TIMEOUT:-90} ))
until grep -qE 'Tailscale -> https://|🔴|EADDRINUSE|Error:|error:|Traceback|exit code|elevated privileges|Password:' "$LOG"; do
  (( SECONDS < deadline )) || break
  [[ "$(pm2 pid "$NAME")" =~ ^[1-9] ]] || break  # exited before printing anything useful
  sleep 1
done
tail="$(tail -80 "$LOG")"
url="$(printf '%s\n' "$tail" | sed -n 's/.*Tailscale -> \(https:\/\/[^[:space:]]*\).*/\1/p' | tail -1)"
# A password prompt never answers itself: say so now instead of timing out.
if [[ -z "$url" ]] && printf '%s' "$tail" | grep -q 'elevated privileges\|Password:'; then
  die "portless is asking for a sudo password (it wants port 443). Nothing can type it there. Start the proxy on the unprivileged port first: portless proxy start --port 1355 --https"
fi
if [[ -z "$url" ]]; then
  say "dev-up: no tailnet URL after ${DEV_UP_TIMEOUT:-90}s. If the tail below shows a slow boot, retry: DEV_UP_TIMEOUT=180 dev-up. Log $LOG tail:"
  printf '%s\n' "$tail" | tail -30 >&2
  exit 1
fi

# ── 6. Is it actually answering? ──────────────────────────────────────────────
# portless prints the URL before the app behind it is listening, so poll until
# something other than the proxy's 502 comes back.
probe_url "$url" "${DEV_UP_TIMEOUT:-90}" || true
code="$PROBE_CODE"
case "$code" in
  2*|3*|401|403) ;;
  *) say "dev-up: $url still answers HTTP $code after ${DEV_UP_TIMEOUT:-90}s. Log $LOG tail:"
     tail -30 "$LOG" >&2; exit 1 ;;
esac

dev-url set "$url" >/dev/null 2>&1 || true
serve_check explain "$url"
say "dev-up: ${CMD[*]} is up as pm2 process $NAME (HTTP $code). Logs: pm2 logs $NAME"
printf '%s pm2=%s lease=%s created\n' "$url" "$NAME" "$lease"
