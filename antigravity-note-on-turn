#!/bin/sh
set -eu

# Read the stdin JSON payload
stdin_json="$(cat)"

# Extract transcript path (for Antigravity) or last assistant message (for Claude/Codex)
transcript_path="$(echo "$stdin_json" | jq -r '.transcriptPath // .transcript_path // empty')"
reply=""

if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
  # Extract the last assistant response from the transcript
  reply="$(jq -r 'select(.type == "gemini") | .content // empty' "$transcript_path" | tail -n 1)"
else
  # Fallback to direct field (Claude/Codex style)
  reply="$(echo "$stdin_json" | jq -r '.last_assistant_message // .prompt_response // empty')"
fi

[ -n "$reply" ] || exit 0

printf '%s' "$reply" | "$HOME/scripts/summarize-for-note" | /usr/bin/pbcopy
"$HOME/scripts/sc" text-phone
