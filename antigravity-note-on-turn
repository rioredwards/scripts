#!/bin/sh
set -eu

# Read the stdin JSON payload
stdin_json="$(cat)"

# Extract transcript path (for Antigravity)
transcript_path="$(echo "$stdin_json" | jq -r '.transcriptPath // .transcript_path // empty')"
reply=""

if [ -n "$transcript_path" ] && [ -f "$transcript_path" ]; then
  # Extract the last assistant response from the transcript (handles multi-line responses)
  reply="$(jq -s -r '[.[] | select(.source == "MODEL" and .type == "PLANNER_RESPONSE" and has("content") and .content != "")] | last | .content // empty' "$transcript_path")"
else
  # Fallback to direct field (Claude/Codex style)
  reply="$(echo "$stdin_json" | jq -r '.last_assistant_message // .prompt_response // empty')"
fi

[ -n "$reply" ] || {
  echo '{"decision": "allow_stop"}'
  exit 0
}

printf '%s' "$reply" | "$HOME/scripts/summarize-for-note" | /usr/bin/pbcopy
"$HOME/scripts/sc" text-phone >/dev/null 2>&1

# Rebuild the agent-sessions index so Raycast/fzf see this session immediately.
"$HOME/dev/agent-sessions/bin/index-session" >/dev/null 2>&1 &

echo '{"decision": "allow_stop"}'
