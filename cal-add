#!/bin/zsh
#
# cal-add — create an Apple Calendar event from the shell (AppleScript → Calendar.app).
#
# Events land in iCloud and sync to every device. Needs an unlocked GUI session on
# the Mac running it and Terminal → Calendar automation permission (one-time prompt).
#
# Usage:
#   cal-add "Title" --start "2026-08-26 09:00" --end "2026-08-26 09:20"
#   cal-add "Title" --start "2026-08-26 09:00" --duration 20        # minutes
#   cal-add "Title" --start ... --end ... --calendar "Life" --notes "why"
#   cal-add --list                                                   # calendar names
#
# Defaults: --calendar "Work Time Tracking". Times are local, 24h, "YYYY-MM-DD HH:MM".
# Fails loud on a bad date, an unknown calendar, or a Calendar.app timeout.

set -euo pipefail

die() { print -u2 -- "cal-add: $*"; exit 1; }

calendar="Work Time Tracking"
title="" start="" end="" duration="" notes=""
list=0

while (( $# )); do
  case "$1" in
    --list) list=1 ;;
    --start) start="$2"; shift ;;
    --end) end="$2"; shift ;;
    --duration) duration="$2"; shift ;;
    --calendar) calendar="$2"; shift ;;
    --notes) notes="$2"; shift ;;
    -h|--help) sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --*) die "unknown flag $1" ;;
    *) [[ -z "$title" ]] && title="$1" || die "unexpected arg $1" ;;
  esac
  shift
done

if (( list )); then
  osascript -e 'with timeout of 60 seconds
    tell application "Calendar" to get name of every calendar
  end timeout' | tr ',' '\n' | sed 's/^ //'
  exit 0
fi

[[ -n "$title" ]] || die "title required (see --help)"
[[ -n "$start" ]] || die "--start required"
[[ "$start" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$' ]] || die "--start must be 'YYYY-MM-DD HH:MM', got '$start'"

if [[ -z "$end" ]]; then
  [[ -n "$duration" ]] || die "--end or --duration required"
  [[ "$duration" =~ '^[0-9]+$' ]] || die "--duration must be minutes, got '$duration'"
  end=$(date -j -v "+${duration}M" -f '%Y-%m-%d %H:%M' "$start" '+%Y-%m-%d %H:%M')
fi
[[ "$end" =~ '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$' ]] || die "--end must be 'YYYY-MM-DD HH:MM', got '$end'"

# Dates are passed as components so AppleScript never has to parse a locale string.
osascript - "$title" "$calendar" "$notes" \
  "${start[1,4]}" "${start[6,7]}" "${start[9,10]}" "${start[12,13]}" "${start[15,16]}" \
  "${end[1,4]}"   "${end[6,7]}"   "${end[9,10]}"   "${end[12,13]}"   "${end[15,16]}" <<'EOF'
on mkdate(y, m, d, h, mi)
  set dt to current date
  set day of dt to 1
  set year of dt to (y as integer)
  set month of dt to (m as integer)
  set day of dt to (d as integer)
  set hours of dt to (h as integer)
  set minutes of dt to (mi as integer)
  set seconds of dt to 0
  return dt
end mkdate

on run argv
  set {t, calName, notes} to items 1 thru 3 of argv
  set s to mkdate(item 4 of argv, item 5 of argv, item 6 of argv, item 7 of argv, item 8 of argv)
  set e to mkdate(item 9 of argv, item 10 of argv, item 11 of argv, item 12 of argv, item 13 of argv)
  if e ≤ s then error "end must be after start"
  with timeout of 60 seconds
    tell application "Calendar"
      if not (exists calendar calName) then error "no calendar named '" & calName & "' (try --list)"
      tell calendar calName
        make new event with properties {summary:t, start date:s, end date:e, description:notes}
      end tell
    end tell
  end timeout
  return "created: " & t & " | " & (s as string) & " → " & (e as string) & " | " & calName
end run
EOF
