#!/usr/bin/env python3
"""SSH preflight: wake the MacBook on the verified home LAN, then wait briefly."""
import json
import os
from pathlib import Path
import re
import socket
import subprocess
import sys
import time


def config_only():
    """ssh -G and multiplex control requests must not wake a sleeping Mac."""
    command = subprocess.check_output(['/bin/ps', '-p', str(os.getppid()), '-o', 'command='], text=True)
    # ps prints argv without shell quoting; remote text may contain unmatched quotes.
    args = command.split()
    if not args or Path(args[0]).name != 'ssh':
        return False
    args = iter(args[1:])
    host_seen = False
    for arg in args:
        if arg == '--':
            break
        if not arg.startswith('-'):
            if host_seen:
                break
            host_seen = True
            continue
        for flag in arg[1:]:
            if flag in 'GO':
                return True
            if flag in 'BbcDEeFIiJLlmopPQRSwW':
                if arg.endswith(flag):
                    next(args, None)
                break
    return False


def reachable(host, port, timeout=5):
    # nc also bounds DNS resolution, unlike socket.create_connection's timeout.
    try:
        return subprocess.run(['/usr/bin/nc', '-z', '-G', str(timeout), host, str(port)],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=timeout + 1).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def settings():
    return json.loads((Path.home() / '.config/macbook-wake.json').read_text())


def home_network(config):
    route = subprocess.check_output(['/sbin/route', '-n', 'get', 'default'], text=True)
    gateway = re.search(r'gateway: (\S+)', route).group(1)
    interface = re.search(r'interface: (\S+)', route).group(1)
    arp = subprocess.check_output(['/usr/sbin/arp', '-n', gateway], text=True)
    if gateway != config['gateway'] or f"at {config['gateway_mac']} " not in arp.lower():
        raise RuntimeError('not on the verified home network; cannot send a wake signal')
    info = subprocess.check_output(['/sbin/ifconfig', interface], text=True)
    address = re.search(r'inet (\S+) netmask \S+ broadcast (\S+)', info)
    if not address:
        raise RuntimeError('home interface has no IPv4 broadcast address')
    return address.groups()


def send_wake(network, config):
    address, broadcast = network
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.bind((address, 0))
        for mac in config['macs']:
            packet = bytes.fromhex('ff' * 6 + mac.replace(':', '') * 16)
            for port in (9, 7):
                sock.sendto(packet, (broadcast, port))


def main(args):
    check = args and args[0] == '--check'
    if check:
        args = args[1:]
    elif os.environ.get('MACBOOK_NO_WAKE') == '1' or config_only():
        return 0
    if len(args) != 2:
        print('Usage: macbook-wake [--check] HOST PORT', file=sys.stderr)
        return 2
    host, port = args
    if reachable(host, port, timeout=1 if check else 5):
        return 0
    if check:
        return 1
    try:
        config = settings()
        network = home_network(config)
        send_wake(network, config)
        print('MacBook unreachable; sent home-network wake signal.', file=sys.stderr)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            if reachable(host, port):
                return 0
            time.sleep(1)
            # Wi-Fi broadcasts can be lost; repeat only inside this bounded attempt.
            if time.monotonic() < deadline:
                send_wake(network, config)
        raise RuntimeError('MacBook still unreachable after 30 seconds')
    except (OSError, ValueError, KeyError, AttributeError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'MacBook wake: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
