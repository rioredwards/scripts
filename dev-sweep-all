#!/usr/bin/env python3
"""dev-sweep-all: run `dev-sweep --apply` on every repo here that has extra worktrees.

  dev-sweep-all             # nightly mode: sweep each repo, write PM inbox lines, keep a log
  dev-sweep-all --dry-run   # same repos, no --apply, nothing written to the inbox (lines are printed)

Repos: every primary checkout (a directory with a .git directory) that has more
than one registered worktree, found up to two levels under $DEV_ROOT (default
$HOME/dev, hidden folders skipped), plus $SCRIPTS (default $HOME/scripts) and
$DOTFILES (default $HOME/.dotfiles); each real path is swept once. Any of those
three missing is a setup error (exit 2). Discovery reuses dev-scan's dev_root,
subdirs and is_main_checkout.

One repo failing never stops the others. After each repo ONE status line goes to
the PM inbox (source "dev-sweep", via pm_inbox.py) when more than 15 worktrees
remain registered, or when the repo's sweep failed: dev-sweep exited 2 (fatal) or
3 (a leftover folder could not be deleted), or the wrapper hit an error on it.
If an unread inbox file already has a sweep line for that repo, no second line
is written (the old one is kept, not replaced).

Stale projects (idea I-007): the same run also reads every discovered repo's last touch: the newer of its newest commit on any
branch and its newest changed or untracked (not ignored) working file. A repo whose last touch is STALE_DAYS (60) old or more is "untouched". New ones go to the PM
inbox as ONE ask line per run (oldest first, three named, the rest counted) offering a cleanup review;
nothing is ever deleted, archived, moved or changed. Silent when none is new. A repo is flagged once:
$HOME/.local/state/dev-sweep/stale-flagged.json holds repo -> newest-commit time when flagged, so it
is mentioned again only after a new commit and another 60 idle days. Repos that are gone drop out of
that file. A dry run prints the line and writes no state.

Log: one file per run in $DEV_SWEEP_LOG_DIR (default $HOME/Library/Logs/dev-sweep),
sweep-<timestamp>[-dry].log, newest 14 kept.

Real runs only happen on a machine that opted in with the marker file
$HOME/.local/state/dev-sweep/enabled (the plist source syncs to both Macs; the
marker does not). Without it a real run exits 0 and says so. --dry-run always works.

A run-level failure (a root folder missing or unreadable) writes one status line too ("failed on
all repos", same dedupe) before exiting 2; a dry run only prints it.

Exit 0 when every repo swept without exit 2 or 3 and every inbox write worked;
1 otherwise; 2 on a usage or setup error.

Env overrides (tests): DEV_ROOT, SCRIPTS, DOTFILES, DEV_SWEEP_LOG_DIR,
DEV_SWEEP_PM_INBOX (path of pm_inbox.py), DEV_SWEEP_BIN, DEV_SWEEP_MARKER.
"""
import collections
import datetime
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
HOME = os.path.expanduser("~")
MAX_REMAINING = 15
KEEP_LOGS = 14
SOURCE = "dev-sweep"
STALE_DAYS = 60
SHOWN = 3


class SetupError(Exception):
    """A run-level failure: nothing could be swept. Reported to the PM inbox, then exit 2."""


def die(message):
    print(f"dev-sweep-all: {message}", file=sys.stderr)
    sys.exit(2)


def load_scan():
    path = os.path.join(HERE, "dev-scan")
    loader = importlib.machinery.SourceFileLoader("dev_scan_mod", path)
    spec = importlib.util.spec_from_loader("dev_scan_mod", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def registered(repo):
    out = subprocess.run(["git", "-C", repo, "worktree", "list", "--porcelain"], capture_output=True, text=True)
    if out.returncode:
        raise RuntimeError(f"git worktree list failed: {out.stderr.strip()}")
    return sum(1 for line in out.stdout.splitlines() if line.startswith("worktree "))


def discover():
    """Every primary checkout in scope, each real path once. Missing roots fail loud."""
    scan = load_scan()
    root = scan.dev_root()
    extras = (os.environ.get("SCRIPTS") or os.path.join(HOME, "scripts"),
              os.environ.get("DOTFILES") or os.path.join(HOME, ".dotfiles"))
    for path in (root, *extras):
        if not os.path.isdir(path):
            raise SetupError(f"{path} is not a directory")
    found = []
    try:  # dev-scan's subdirs exits on an unreadable folder; that is a run-level failure too
        for first in scan.subdirs(root):
            if scan.is_main_checkout(first):
                found.append(first)
                continue
            found += [second for second in scan.subdirs(first) if scan.is_main_checkout(second)]
    except SystemExit:
        raise SetupError(f"a folder under {root} could not be read (dev-scan said why above)")
    found += [extra for extra in extras if scan.is_main_checkout(extra)]
    unique = {}
    for repo in found:
        unique.setdefault(os.path.realpath(repo), repo)
    return list(unique.values())


def tally(worktrees):
    """Plain-words counts of why trees stay: '7 uncommitted, 5 unpushed'."""
    counts = collections.Counter()
    for wt in worktrees:
        if wt["verdict"] not in ("keep", "partial") or wt["reasons"] == ["primary checkout"]:
            continue
        reason = wt["reasons"][0] if wt["reasons"] else wt["verdict"]
        counts[re.split(r"[:(]", reason)[0].strip()[:40]] += 1
    return ", ".join(f"{n} {reason}" for reason, n in counts.most_common(4))


def inbox_dir(script):
    return os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(script))), "inbox")


def unread_line_for(script, repo_name):
    directory = inbox_dir(script)
    # the name must end where the message's name ends, so "bugaboo" never matches "bugaboo-backend"
    pattern = re.compile(rf"^- status: Worktree sweep(?: failed on|:) {re.escape(repo_name)}(?::| still has)")
    if not os.path.isdir(directory):
        return False
    for name in sorted(os.listdir(directory)):
        if name.endswith(f"-{SOURCE}.md"):
            with open(os.path.join(directory, name), encoding="utf-8") as handle:
                if any(pattern.match(line) for line in handle.read().splitlines()):
                    return True
    return False


def one_line(text):
    return re.sub(r"\s+", " ", text.replace(" | ", " / ")).strip()


def sweep_repo(repo, dry, sweeper):
    """(lines for the log, inbox message or None, ok)."""
    args = [sweeper, repo, "--json"] + ([] if dry else ["--apply"])
    out = subprocess.run(args, capture_output=True, text=True)
    name = os.path.basename(repo)
    log = [f"== {repo} (exit {out.returncode})"]
    if out.returncode not in (0, 3):
        error = one_line(out.stderr.strip().splitlines()[-1] if out.stderr.strip() else f"exit {out.returncode}")
        log.append(f"error: {error}")
        return log, f"Worktree sweep failed on {name}: {error}", False
    try:
        data = json.loads(out.stdout)
    except json.JSONDecodeError as error:
        log.append(f"error: unreadable dev-sweep output: {error}")
        return log, f"Worktree sweep failed on {name}: unreadable dev-sweep output", False
    for wt in data["worktrees"]:
        reasons = f": {'; '.join(wt['reasons'])}" if wt["reasons"] else ""
        log.append(f"{wt['verdict']}{reasons}\t{wt['dir']}\t{wt['branch']}")
    done = "removed" if "removed" in data else "wouldRemove"
    log.append(f"total {data['total']}, {done} {data[done]}, partial {data.get('partial', 0)}")
    message = None
    if out.returncode == 3:
        leftovers = ", ".join(os.path.basename(w["dir"]) for w in data["worktrees"] if w["verdict"] == "partial")
        message = f"Worktree sweep failed on {name}: could not delete leftover folders ({leftovers})"
    else:
        remaining = registered(repo)
        log.append(f"remaining registered worktrees: {remaining}")
        if remaining > MAX_REMAINING:
            why = tally(data["worktrees"])
            message = f"Worktree sweep: {name} still has {remaining} worktrees" + (f" ({why})" if why else "")
    return log, message, out.returncode != 3


def write_inbox(script, name, message, dry, log):
    if dry:
        log.append(f"inbox (dry run, not written): {message}")
        return True
    if unread_line_for(script, name):
        log.append(f"inbox: unread sweep line for {name} already there, not adding: {message}")
        return True
    out = subprocess.run([sys.executable, script, "add", SOURCE, "status", message], capture_output=True, text=True)
    log.append(f"inbox: {out.stdout.strip() or out.stderr.strip()}")
    return out.returncode == 0


def newest_commit(repo):
    """Epoch of the newest commit on any branch, or None for a repo with no commits yet."""
    refs = subprocess.run(["git", "-C", repo, "for-each-ref", "--count=1", "refs/heads", "refs/remotes"],
                          capture_output=True, text=True)
    if refs.returncode:
        raise RuntimeError(f"git for-each-ref failed: {refs.stderr.strip()}")
    if not refs.stdout.strip():
        return None
    out = subprocess.run(["git", "-C", repo, "log", "--all", "-1", "--format=%ct"], capture_output=True, text=True)
    if out.returncode or not out.stdout.strip().isdigit():
        raise RuntimeError(f"git log failed: {out.stderr.strip() or out.stdout.strip()}")
    return int(out.stdout.strip())


def newest_working_change(repo):
    """Epoch of the newest changed or untracked, non-ignored file in the working tree, or None."""
    out = subprocess.run(["git", "-C", repo, "status", "--porcelain=v1", "-z", "--untracked-files=all"],
                         capture_output=True, text=True)
    if out.returncode:
        raise RuntimeError(f"git status failed: {out.stderr.strip()}")
    newest, parts = None, out.stdout.split("\0")
    skip_next = False
    for entry in parts:
        if skip_next:  # the old name after a rename or copy
            skip_next = False
            continue
        if len(entry) < 4:
            continue
        if entry[0] in "RC" or entry[1] in "RC":
            skip_next = True
        try:
            when = int(os.lstat(os.path.join(repo, entry[3:])).st_mtime)
        except FileNotFoundError:
            continue  # a deleted file has no time; the delete itself is not dated
        newest = when if newest is None else max(newest, when)
    return newest


def last_touch(repo):
    """Newer of the newest commit on any branch and the newest uncommitted working file; None if neither."""
    commit, work = newest_commit(repo), newest_working_change(repo)
    times = [t for t in (commit, work) if t is not None]
    return max(times) if times else None


def stale_state_path():
    return os.path.join(HOME, ".local", "state", "dev-sweep", "stale-flagged.json")


def read_stale_state(path):
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        state = json.load(handle)  # a corrupt file raises: fail loud, never guess
    if not isinstance(state, dict) or not all(isinstance(v, int) for v in state.values()):
        raise RuntimeError(f"{path} is not a repo -> epoch map")
    return state


def stale_pass(repos, dry, script, log, days=STALE_DAYS, now=None):
    """Flag repos untouched for `days`, once each, as one inbox ask. Read-only on every repo."""
    now = now if now is not None else datetime.datetime.now().timestamp()
    path = stale_state_path()
    state = read_stale_state(path)
    stale, seen = [], {}
    for repo in repos:
        newest = last_touch(repo)
        if newest is None:
            continue
        real = os.path.realpath(repo)
        seen[real] = newest
        age = int((now - newest) // 86400)
        if age >= days and state.get(real) != newest:
            stale.append((age, repo, real, newest))
    stale.sort(key=lambda row: (-row[0], row[1]))
    log.append(f"stale pass: {len(repos)} repos, {len(stale)} newly untouched {days}+ days")
    kept = {real: when for real, when in state.items() if real in seen}  # gone repos drop out
    if stale:
        shown = ", ".join(f"{os.path.basename(repo)} ({age}d)" for age, repo, _, _ in stale[:SHOWN])
        more = f", and {len(stale) - SHOWN} more" if len(stale) > SHOWN else ""
        question = f"Projects untouched {days}+ days: {shown}{more}. Review for cleanup?"
        yes = ("an agent checks each for uncommitted work, unpushed branches and a remote, then proposes archive or "
               "keep; nothing changes until you approve")
        link = stale[0][1].replace(HOME, "~", 1)
        if dry:
            log.append(f"inbox (dry run, not written): {question}")
            return True
        out = subprocess.run([sys.executable, script, "add", SOURCE, "ask", question, yes, link], capture_output=True, text=True)
        log.append(f"inbox: {out.stdout.strip() or out.stderr.strip()}")
        if out.returncode:
            return False
        for _, _, real, newest in stale:
            kept[real] = newest
    if not dry and kept != state:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(kept, handle, indent=1, sort_keys=True)
    return True


def prune_logs(directory):
    runs = sorted(n for n in os.listdir(directory) if n.startswith("sweep-") and n.endswith(".log"))
    for old in runs[:-KEEP_LOGS]:
        os.remove(os.path.join(directory, old))


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    unknown = [a for a in argv if a != "--dry-run"]
    if unknown:
        die(f"unknown argument {unknown[0]}")
    dry = "--dry-run" in argv
    marker = os.environ.get("DEV_SWEEP_MARKER") or os.path.join(HOME, ".local", "state", "dev-sweep", "enabled")
    if not dry and not os.path.exists(marker):
        print(f"dev-sweep-all: not enabled on this machine (no {marker}); nothing done")
        return 0
    os.environ["GIT_TERMINAL_PROMPT"] = "0"
    sweeper = os.environ.get("DEV_SWEEP_BIN") or os.path.join(HERE, "dev-sweep")
    script = os.environ.get("DEV_SWEEP_PM_INBOX") or os.path.join(HOME, "dev", "project-manager", "scripts", "pm_inbox.py")
    if not dry and not os.path.isfile(script):
        die(f"pm_inbox.py not found at {script}")
    logdir = os.environ.get("DEV_SWEEP_LOG_DIR") or os.path.join(HOME, "Library", "Logs", "dev-sweep")
    os.makedirs(logdir, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y-%m-%dT%H%M%S")
    logfile = os.path.join(logdir, f"sweep-{stamp}{'-dry' if dry else ''}.log")

    lines, healthy = [f"dev-sweep-all {'dry run' if dry else 'apply'} {stamp}"], True
    try:
        repos = discover()
    except SetupError as error:
        # The whole run failed: launchd.log is read by nobody, so one inbox line (deduped), then exit 2.
        print(f"dev-sweep-all: {error}", file=sys.stderr)
        if not dry:
            write_inbox(script, "all repos", f"Worktree sweep failed on all repos: {one_line(str(error))}", False, lines)
        return 2
    for repo in repos:
        name = os.path.basename(repo)
        try:
            if registered(repo) < 2:
                continue
            log, message, ok = sweep_repo(repo, dry, sweeper)
        except (OSError, RuntimeError, subprocess.SubprocessError, KeyError, TypeError) as error:
            log, ok = [f"== {repo}", f"error: {error!r}"], False
            message = f"Worktree sweep failed on {name}: {one_line(repr(error))}"
        if message:
            try:
                ok = write_inbox(script, name, message, dry, log) and ok
            except (OSError, subprocess.SubprocessError) as error:
                log.append(f"inbox: write failed: {error}")
                ok = False
        healthy = healthy and ok
        lines += log
    try:
        healthy = stale_pass(repos, dry, script, lines) and healthy
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        lines.append(f"error: stale pass failed: {error!r}")
        healthy = False
        try:
            write_inbox(script, "stale-check", f"Stale-project check failed: {one_line(repr(error))}", dry, lines)
        except (OSError, subprocess.SubprocessError) as write_error:
            lines.append(f"inbox: write failed: {write_error}")
    lines.append("result: " + ("ok" if healthy else "FAILED (see errors above)"))
    text = "\n".join(lines) + "\n"
    with open(logfile, "w", encoding="utf-8") as handle:
        handle.write(text)
    prune_logs(logdir)
    print(text, end="")
    return 0 if healthy else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
