#!/bin/zsh
# Like aitt but routes through agent-router (plan credits, not API)
# Usage: aitt-claude <transform> [--model <alias>] < input
transform="$1"
model="${3:-sonnet}"
[[ "$2" == "--model" ]] && model="$3"

prompts_dir=~/scripts/ai-text-transform/prompts
prompt_file="$prompts_dir/${transform}.md"
[[ ! -f "$prompt_file" ]] && { echo "❌ Unknown transform: $transform" >&2; exit 1; }

prompt=$(cat "$prompt_file")
input=$(cat)
[[ -z "$input" ]] && { echo "❌ No input" >&2; exit 1; }

~/dev/agent-router/agent-router delegate \
  --provider claude \
  --model "$model" \
  --prompt "${prompt}

${input}"
