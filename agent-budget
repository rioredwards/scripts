#!/bin/sh
# agent-budget: the LOC appetite for the work in this repo, made measurable.
#
# The plan phase sets a budget after approval; hooks/loc-budget.sh measures the
# diff against it on every edit and at commit time. Prose appetites ("keep it
# small") lose; a number with a gate holds.
#
#   agent-budget set <loc> [--files N] [--base REF]   # start/raise (base = HEAD, kept on raise)
#   agent-budget status                               # one line; exit 1 when over
#   agent-budget clear                                # drop it
#
# State lives in the repo's .git dir (per worktree, never committed). Counted:
# added lines vs base (or the newer split point from origin/dev or origin's default
# branch, after a rebase), committed or not, untracked files included, renames as
# their edits only. Deleted lines are free: removing code is rewarded, not
# penalized. Lockfiles and snapshots are ignored.
#
# Exit codes: 0 within budget · 1 over · 3 no budget set · 2 usage/infra error
set -u

die() { printf 'agent-budget: %s\n' "$*" >&2; exit 2; }

GIT_DIR="$(git rev-parse --git-dir 2>/dev/null)" || die "not a git repo"
STATE="$GIT_DIR/agent-budget"
WARNED="$GIT_DIR/agent-budget-warned"

# Paths that inflate a diff without being code anyone wrote.
EXCLUDES=':(exclude,glob)**/pnpm-lock.yaml :(exclude,glob)**/package-lock.json :(exclude,glob)**/yarn.lock :(exclude,glob)**/*.lock :(exclude,glob)**/*.snap :(exclude,glob)**/Cargo.lock :(exclude,glob)**/Package.resolved :(exclude,glob)**/migrations/meta/*_snapshot.json'

cmd="${1:-status}"; [ $# -gt 0 ] && shift

case "$cmd" in
  set)
    loc="${1:-}"; [ $# -gt 0 ] && shift
    case "$loc" in ''|*[!0-9]*) die "usage: agent-budget set <loc> [--files N] [--base REF]" ;; esac
    # Raising an existing budget keeps its base: but only on the same branch;
    # a fresh budget or a branch switch measures from HEAD (stale bases gate falsely).
    files=""; base="HEAD"
    branch="$(git symbolic-ref --short -q HEAD || echo detached)"
    [ -r "$STATE" ] && [ "$(sed -n 's/^BRANCH=//p' "$STATE")" = "$branch" ] && base="$(sed -n 's/^BASE=//p' "$STATE")"
    # Kept base gone stale (rebase)? Refresh to HEAD instead of re-saving a false gate.
    [ "$base" = "HEAD" ] || git merge-base --is-ancestor "$base" HEAD 2>/dev/null || base="HEAD"
    while [ $# -gt 0 ]; do
      case "$1" in
        --files) files="${2:-}"; shift 2 ;;
        --base)  base="${2:-}";  shift 2 ;;
        *) die "unknown flag $1" ;;
      esac
    done
    [ -n "$files" ] && case "$files" in *[!0-9]*) die "--files wants a number" ;; esac
    sha="$(git rev-parse --verify "$base^{commit}" 2>/dev/null)" || die "bad base ref: $base"
    printf 'BASE=%s\nLOC=%s\nFILES=%s\nBRANCH=%s\nSET_AT=%s\n' "$sha" "$loc" "$files" "$branch" "$(date +%s)" > "$STATE"
    rm -f "$WARNED"
    printf 'budget set: %s LOC%s, measured from %s\n' "$loc" "${files:+, $files new files}" "$(git rev-parse --short "$sha")"
    ;;

  clear)
    rm -f "$STATE" "$WARNED"; echo "budget cleared" ;;

  status)
    [ -r "$STATE" ] || { echo "no budget set"; exit 3; }
    . "$STATE"
    git rev-parse --verify -q "$BASE^{commit}" >/dev/null || die "budget base $BASE no longer exists. Run agent-budget set again"
    # A base that isn't an ancestor of HEAD (rebase, branch switch) inflates the diff
    # into a false OVER BUDGET. Fail loud instead of gating falsely.
    git merge-base --is-ancestor "$BASE" HEAD 2>/dev/null || die "budget base $(git rev-parse --short "$BASE") is stale (rebase/branch switch), re-run: agent-budget set <loc>"
    # Rebased onto a newer integration branch? The old base is still an ancestor, but
    # everything upstream added since would count as ours. Measure from the split point.
    # Skipped when working on that branch itself: pushed work would stop counting.
    upstream="$(git rev-parse --abbrev-ref -q '@{upstream}' 2>/dev/null || true)"
    for ref in origin/dev origin/HEAD; do
      git rev-parse --verify -q "$ref^{commit}" >/dev/null || continue
      [ "$(git rev-parse --abbrev-ref "$ref")" = "$upstream" ] && continue
      mb="$(git merge-base HEAD "$ref" 2>/dev/null)" || continue
      [ "$mb" != "$BASE" ] && git merge-base --is-ancestor "$BASE" "$mb" && BASE="$mb"
    done

    # Untracked files join a scratch copy of the index as intent-to-add, so a plain
    # `mv` pairs as a rename just like `git mv` or a commit. The real index is untouched.
    idx="$(mktemp)" || die "mktemp failed"; trap 'rm -f "$idx"' EXIT
    # cp -p keeps the mtime git's racy-clean check compares against. No index yet: git starts one.
    real="$(git rev-parse --git-path index)"
    if [ -e "$real" ]; then cp -p "$real" "$idx" || die "copying index failed"; else rm -f "$idx"; fi
    # Whole repo (:/), so a cwd inside an ignored dir can't fail; --sparse reaches files
    # outside the cone. The diff's pathspec below does the scoping and excluding.
    err="$(GIT_INDEX_FILE="$idx" git add -N --sparse -- :/ 2>&1 >/dev/null)" || die "scratch index: $err"
    # -M30%: a rename edited past git's default 50% similarity counts its edits, not the whole file.
    # One diff serves both counts: --numstat lines for LOC, --summary "create mode" lines for new files.
    # shellcheck disable=SC2086
    diff="$(GIT_INDEX_FILE="$idx" git diff -M30% --numstat --summary "$BASE" -- . $EXCLUDES)" || die "git diff failed"
    loc="$(printf '%s\n' "$diff" | awk -F'\t' 'NF==3 && $1!="-"{s+=$1} END{print s+0}')"
    newfiles="$(printf '%s\n' "$diff" | grep -c '^ create mode ')"

    over=0
    [ "$loc" -gt "$LOC" ] && over=1
    [ -n "$FILES" ] && [ "$newfiles" -gt "$FILES" ] && over=1
    fpart=""; [ -n "$FILES" ] && fpart=" · new files $newfiles/$FILES"
    if [ "$over" = 1 ]; then printf 'OVER BUDGET: %s/%s LOC%s\n' "$loc" "$LOC" "$fpart"; exit 1; fi
    printf 'within budget: %s/%s LOC%s\n' "$loc" "$LOC" "$fpart"
    ;;

  *) die "usage: agent-budget set <loc> [--files N] [--base REF] | status | clear" ;;
esac
