#!/bin/zsh
#
# keyfor: the one way anything on this Mac reads an API key.
#
# Secrets live in a single age-encrypted file committed to ~/.dotfiles, so both
# Macs get key changes through the normal dotfiles sync. The age identity that
# opens it is the one thing copied by hand, per machine, and never committed.
#
#   store:    ~/.dotfiles/secrets/keys.env.age   encrypted, in git
#   identity: ~/.config/age/key.txt              chmod 600, never in git
#
# Why not the Keychain: an SSH session gets its own security session, so the
# login Keychain reads as locked even while you are logged in at that Mac's
# screen. Every headless workaround (System keychain, -T ACLs, unlock-keychain)
# needs either root or the keychain password sitting in a plaintext file. A file
# has no lock state, so the same read works over SSH, from launchd, and in hooks.
#
# A secret exists only inside the process that asked for it, for one command.
# Nothing is ever exported into the shell environment.
#
# Usage:
#   keyfor ANTHROPIC_API_KEY            # print the key to stdout
#   keyfor anthropic                    # short slug works too
#   keyfor --list                       # names only, never values
#   keyfor --run OPENAI_API_KEY -- cmd  # run cmd with just that var set
#   keyfor --set OPENAI_API_KEY         # add or rotate (prompts, or reads stdin)
#   keyfor --rm OPENAI_API_KEY          # remove
#
# New Mac: brew install age, copy ~/.config/age/key.txt across, pull dotfiles.

set -euo pipefail

SECRETS_FILE="${KEYFOR_SECRETS_FILE:-$HOME/.dotfiles/secrets/keys.env.age}"
AGE_IDENTITY="${KEYFOR_AGE_IDENTITY:-$HOME/.config/age/key.txt}"

die() { print -u2 -- "keyfor: $*"; exit 1; }

# launchd jobs and hooks start with a bare PATH that has no Homebrew in it, so
# resolve the binaries by hand rather than assuming the caller's PATH.
AGE_BIN=""
AGE_KEYGEN_BIN=""

resolve_bin() {
  local name="$1" found
  found="$(command -v "$name" 2>/dev/null)" && { print -r -- "$found"; return }
  [[ -x "/opt/homebrew/bin/$name" ]] && { print -r -- "/opt/homebrew/bin/$name"; return }
  [[ -x "/usr/local/bin/$name" ]] && { print -r -- "/usr/local/bin/$name"; return }
  return 1
}

require_age() {
  [[ -n "$AGE_BIN" ]] || AGE_BIN="$(resolve_bin age)" \
    || die "age is not installed: brew install age"
  [[ -n "$AGE_KEYGEN_BIN" ]] || AGE_KEYGEN_BIN="$(resolve_bin age-keygen)" \
    || die "age-keygen is not installed: brew install age"
  [[ -r "$AGE_IDENTITY" ]] || die "no age identity at $AGE_IDENTITY
     copy it from your other Mac, or create one: age-keygen -o $AGE_IDENTITY"
}

decrypt() {
  require_age
  [[ -f "$SECRETS_FILE" ]] || die "no secret store at $SECRETS_FILE
     create the first key with: keyfor --set <ENV_NAME>"
  "$AGE_BIN" -d -i "$AGE_IDENTITY" "$SECRETS_FILE" 2>/dev/null \
    || die "could not decrypt $SECRETS_FILE with $AGE_IDENTITY
     wrong identity, or the store is corrupt"
}

encrypt_lines() {
  local recipient tmp
  require_age
  recipient="$("$AGE_KEYGEN_BIN" -y "$AGE_IDENTITY" 2>/dev/null)" \
    || die "could not derive a recipient from $AGE_IDENTITY"
  mkdir -p "${SECRETS_FILE:h}"
  tmp="$(mktemp "${SECRETS_FILE}.XXXXXX")"
  if ! print -rl -- "$@" | "$AGE_BIN" -r "$recipient" -o "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    die "encryption failed, $SECRETS_FILE left unchanged"
  fi
  chmod 600 "$tmp"
  mv "$tmp" "$SECRETS_FILE"
}

env_name_for() {
  # Accept either ANTHROPIC_API_KEY or anthropic; normalize to the stored name.
  local input="$1"
  [[ "$input" == *[a-z]* && "$input" != *[A-Z]* ]] || { print -- "${input:u}"; return }
  local upper="${${input:u}//-/_}"
  case "$upper" in
    QBO_*) print -- "$upper" ;;
    *)     print -- "${upper}_API_KEY" ;;
  esac
}

# Every line of the store except the named key, blanks dropped.
without_key() {
  local env_name="$1" plain="$2" line
  for line in ${(f)plain}; do
    [[ -n "$line" ]] || continue
    [[ "$line" == "${env_name}="* ]] && continue
    print -r -- "$line"
  done
}

lookup() {
  local env_name="$1" plain line value found=0
  plain="$(decrypt)" || exit 1
  for line in ${(f)plain}; do
    [[ "$line" == "${env_name}="* ]] || continue
    value="${line#*=}"
    found=1
    break
  done
  (( found )) || die "no key named $env_name in $SECRETS_FILE
     add it with: keyfor --set $env_name"
  [[ -n "${value:-}" ]] || die "key $env_name is present but empty in $SECRETS_FILE"
  print -r -- "$value"
}

list_keys() {
  local plain
  plain="$(decrypt)" || exit 1
  print -r -- "$plain" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | sort -u
}

set_key() {
  local env_name="$1" value plain
  local -a keep=()
  if [[ -t 0 ]]; then
    read -rs "value?Value for $env_name (not echoed): "
    print -u2
  else
    IFS= read -r value || value=""
  fi
  [[ -n "$value" ]] || die "empty value, refusing to store $env_name"

  if [[ -f "$SECRETS_FILE" ]]; then
    plain="$(decrypt)" || exit 1
    keep=(${(f)"$(without_key "$env_name" "$plain")"})
  else
    require_age
  fi
  keep+=("${env_name}=${value}")
  encrypt_lines "${(@o)keep}"
  print -u2 -- "keyfor: stored $env_name"
}

rm_key() {
  local env_name="$1" plain
  local -a keep=()
  plain="$(decrypt)" || exit 1
  print -r -- "$plain" | grep -q "^${env_name}=" \
    || die "no key named $env_name in $SECRETS_FILE"
  keep=(${(f)"$(without_key "$env_name" "$plain")"})
  encrypt_lines "${(@o)keep}"
  print -u2 -- "keyfor: removed $env_name"
}

[[ $# -ge 1 ]] || die "usage: keyfor <ENV_NAME> | --list | --run <ENV_NAME> -- <cmd>... | --set <ENV_NAME> | --rm <ENV_NAME>"

case "$1" in
  --list|-l)
    list_keys
    ;;
  --set|-s)
    shift
    [[ $# -eq 1 ]] || die "--set needs exactly one key name"
    set_key "$(env_name_for "$1")"
    ;;
  --rm)
    shift
    [[ $# -eq 1 ]] || die "--rm needs exactly one key name"
    rm_key "$(env_name_for "$1")"
    ;;
  --run|-r)
    shift
    [[ $# -ge 1 ]] || die "--run needs a key name"
    local_name="$(env_name_for "$1")"; shift
    [[ "${1:-}" == "--" ]] || die "--run <ENV_NAME> -- <cmd>...  (missing --)"
    shift
    [[ $# -ge 1 ]] || die "--run needs a command"
    local_value="$(lookup "$local_name")" || exit 1
    exec env "${local_name}=${local_value}" "$@"
    ;;
  -h|--help)
    sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  -*)
    die "unknown flag: $1"
    ;;
  *)
    lookup "$(env_name_for "$1")"
    ;;
esac
